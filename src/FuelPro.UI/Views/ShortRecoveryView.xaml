<UserControl x:Class="FuelPro.UI.Views.ShortRecoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,24">
            <materialDesign:PackIcon Kind="AlertCircle" Width="28" Height="28" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="Short Recovery" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,24,0"/>
            <DatePicker SelectedDate="{Binding SelectedMonth}" materialDesign:HintAssist.Hint="Select Month" Style="{StaticResource MaterialDesignOutlinedDatePicker}" Width="200" Height="48"/>
        </StackPanel>

        <materialDesign:Card Grid.Row="1" MaxWidth="600" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32" UniformCornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp2">
            <StackPanel HorizontalAlignment="Center">
                <materialDesign:PackIcon Kind="ClipboardAlert" Width="80" Height="80" Foreground="#D32F2F" HorizontalAlignment="Center" Margin="0,0,0,24"/>
                <TextBlock Text="Short Recovery Tracking" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="{Binding StatusMessage}" FontSize="14" LineHeight="20" TextAlignment="Center" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,24"/>
                <Button Content="View Short Ledger" Style="{StaticResource MaterialDesignRaisedButton}" Background="#D32F2F" BorderBrush="#D32F2F" HorizontalAlignment="Center" Width="180"/>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</UserControl>
