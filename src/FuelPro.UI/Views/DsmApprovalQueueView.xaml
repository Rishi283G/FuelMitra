<UserControl x:Class="FuelPro.UI.Views.DsmApprovalQueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:FuelPro.UI.ViewModels"
             xmlns:converters="clr-namespace:FuelPro.UI.Converters"
             Background="{DynamicResource MaterialDesign.Brush.Background}"
             Padding="24">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <converters:DenomAmountConverter x:Key="DenomAmountConv"/>
        <converters:StringToVisibilityConverter x:Key="StringToVis"/>
        <converters:DifferenceColorConverter x:Key="DiffColorConv"/>
    </UserControl.Resources>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Column: Queue & History -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Pending Submissions Card -->
            <materialDesign:Card Grid.Row="0" Padding="16" UniformCornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp3" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <materialDesign:PackIcon Kind="ClipboardListOutline" Width="24" Height="24" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" VerticalAlignment="Center"/>
                        <TextBlock Text="Pending Submissions" FontSize="16" FontWeight="Bold" Margin="8,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Row="1" Content="Refresh Queue" Command="{Binding RefreshQueueCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="36" Margin="0,0,0,16"/>

                    <ListBox Grid.Row="2" ItemsSource="{Binding PendingSubmissions}" SelectedItem="{Binding SelectedSubmission}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DsmPendingSubmission}">
                                <Border BorderThickness="0,0,0,1" BorderBrush="#E0E0E0" Padding="8,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding TitleDisplay}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding ShiftDateDisplay}" FontSize="12" Opacity="0.7" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding SubmittedTimeDisplay}" FontSize="11" Opacity="0.5" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <ProgressBar Grid.Row="2" IsIndeterminate="True" VerticalAlignment="Center" HorizontalAlignment="Center"
                                 Visibility="{Binding IsLoadingSubmissions, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>
            </materialDesign:Card>

            <!-- Collapsible Recently Approved Section -->
            <Expander Grid.Row="1" Header="Recently Approved Submissions" 
                      IsExpanded="{Binding IsRecentlyApprovedExpanded}"
                      Background="{DynamicResource MaterialDesign.Brush.CardBackground}"
                      BorderThickness="1" BorderBrush="#E0E0E0"
                      Margin="0" Padding="4">
                <Grid Height="500">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Filters -->
                        <RowDefinition Height="Auto"/> <!-- Summary Panel -->
                        <RowDefinition Height="*"/>    <!-- Approved List -->
                    </Grid.RowDefinitions>

                    <!-- Filters Panel -->
                    <StackPanel Grid.Row="0" Margin="4,4,4,8">
                        <TextBox Text="{Binding SearchTextFilter, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Search DSM name..."
                                 materialDesign:HintAssist.IsFloating="False"
                                 materialDesign:TextFieldAssist.HasClearButton="True"
                                 Margin="0,0,0,4"
                                 Height="32"/>

                        <UniformGrid Columns="3" Margin="0,2">
                            <ToggleButton Content="Today" IsChecked="{Binding IsFilterToday}" Style="{StaticResource MaterialDesignFlatPrimaryToggleButton}" FontSize="11" Padding="0" Height="28"/>
                            <ToggleButton Content="Yesterday" IsChecked="{Binding IsFilterYesterday}" Style="{StaticResource MaterialDesignFlatPrimaryToggleButton}" FontSize="11" Padding="0" Height="28"/>
                            <ToggleButton Content="This Wk" IsChecked="{Binding IsFilterThisWeek}" Style="{StaticResource MaterialDesignFlatPrimaryToggleButton}" FontSize="11" Padding="0" Height="28"/>
                        </UniformGrid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" ItemsSource="{Binding DsmFilterOptions}" SelectedItem="{Binding SelectedDsmFilter}" materialDesign:HintAssist.Hint="DSM" Style="{StaticResource MaterialDesignFloatingHintComboBox}" Margin="2,0"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding PumpFilterOptions}" SelectedItem="{Binding SelectedPumpFilter}" materialDesign:HintAssist.Hint="Pump" Style="{StaticResource MaterialDesignFloatingHintComboBox}" Margin="2,0"/>
                            <ComboBox Grid.Column="2" ItemsSource="{Binding ShiftFilterOptions}" SelectedItem="{Binding SelectedShiftFilter}" materialDesign:HintAssist.Hint="Shift" Style="{StaticResource MaterialDesignFloatingHintComboBox}" Margin="2,0"/>
                        </Grid>
                    </StackPanel>

                    <!-- Summary Metrics Panel -->
                    <materialDesign:Card Grid.Row="1" Background="#F5F5F5" Padding="8" Margin="4,0,4,8" UniformCornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="2">
                                <TextBlock Text="Count" FontSize="9" Opacity="0.6"/>
                                <TextBlock Text="{Binding SummaryApprovedCount}" FontSize="11" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="2">
                                <TextBlock Text="Mismatch" FontSize="9" Opacity="0.6"/>
                                <TextBlock Text="{Binding SummaryTotalDifference, StringFormat='₹{0:N0}'}" FontSize="11" FontWeight="Bold" Foreground="#D32F2F"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="2">
                                <TextBlock Text="Fuel Sales" FontSize="9" Opacity="0.6"/>
                                <TextBlock Text="{Binding SummaryGrossSales, StringFormat='₹{0:N0}'}" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="2">
                                <TextBlock Text="Collections" FontSize="9" Opacity="0.6"/>
                                <TextBlock Text="{Binding SummaryTotalCollection, StringFormat='₹{0:N0}'}" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="2">
                                <TextBlock Text="Expenses" FontSize="9" Opacity="0.6"/>
                                <TextBlock Text="{Binding SummaryTotalExpenses, StringFormat='₹{0:N0}'}" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="2">
                                <TextBlock Text="Debtors" FontSize="9" Opacity="0.6"/>
                                <TextBlock Text="{Binding SummaryTotalDebtors, StringFormat='₹{0:N0}'}" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="0" Margin="2">
                                <TextBlock Text="Testing" FontSize="9" Opacity="0.6"/>
                                <TextBlock Text="{Binding SummaryTotalTesting, StringFormat='₹{0:N0}'}" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="1" Margin="2">
                                <TextBlock Text="Products" FontSize="9" Opacity="0.6"/>
                                <TextBlock Text="{Binding SummaryTotalOilDefSales, StringFormat='₹{0:N0}'}" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                    </materialDesign:Card>

                    <!-- Approved Card List -->
                    <ListBox Grid.Row="2" ItemsSource="{Binding FilteredApprovedSubmissions}" SelectedItem="{Binding SelectedApprovedSubmission}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" Margin="4,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DsmApprovedSubmissionDto}">
                                <Border BorderThickness="1" BorderBrush="#E0E0E0" CornerRadius="8" Padding="8" Margin="0,2" Background="White" Width="280">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding TitleDisplay}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                            <TextBlock Text="{Binding ShiftDateDisplay}" FontSize="10.5" Opacity="0.7" Margin="0,1"/>
                                            
                                            <!-- Submission & Approval Times -->
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding SubmittedTimeDisplay, StringFormat='Sub: {0}'}" FontSize="9" Opacity="0.5"/>
                                                <TextBlock Grid.Column="1" Text="{Binding ApprovedTimeDisplay, StringFormat='App: {0}'}" FontSize="9" Opacity="0.5"/>
                                            </Grid>

                                            <!-- Financials -->
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding GrossSales, StringFormat='S: ₹{0:N0}'}" FontSize="9.5" Opacity="0.7" Margin="0,0,6,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding TotalCollection, StringFormat='C: ₹{0:N0}'}" FontSize="9.5" Opacity="0.7" Margin="0,0,6,0"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Mismatch, StringFormat='D: ₹{0:N0}'}" FontSize="9.5" FontWeight="Bold" Foreground="#D32F2F" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>

                                        <materialDesign:PackIcon Grid.Column="1" Kind="Eye" Width="18" Height="18" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" VerticalAlignment="Center" Margin="6,0,0,0" Opacity="0.7"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Expander>
        </Grid>

        <!-- Right Column: Details & Editing -->
        <Grid Grid.Column="2">
            <!-- No Submission Selected placeholder -->
            <materialDesign:Card Padding="32" UniformCornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp3" VerticalAlignment="Stretch">
                <materialDesign:Card.Style>
                    <Style TargetType="materialDesign:Card" BasedOn="{StaticResource {x:Type materialDesign:Card}}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasActiveSelection}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </materialDesign:Card.Style>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="GestureTap" Width="64" Height="64" Opacity="0.3" HorizontalAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                    <TextBlock Text="Select a submission from the list to approve or edit" FontSize="16" FontWeight="SemiBold" Opacity="0.5" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- Active Submission Details -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasActiveSelection}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                
                <StackPanel Margin="0,0,8,0">
                    <!-- HEADER FORM -->
                    <materialDesign:Card Padding="24" UniformCornerRadius="12" Margin="0,0,0,16"
                                         materialDesign:ElevationAssist.Elevation="Dp3">
                        <StackPanel>
                            <!-- Station Name & Attachment Action Bar -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="GasStation" Width="22" Height="22" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding HeaderStationNameDisplay}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" VerticalAlignment="Center"
                                               Visibility="{Binding HasStationName, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="DSM Submission Review" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasStationName}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="1" Content="📎 Open Attachment" Command="{Binding OpenAttachmentCommand}" Height="32" Padding="12,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AttachmentUrl}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding AttachmentUrl}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>

                            <!-- 5-Column Header Info Grid matching DsmEntryView -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0" Text="{Binding HeaderShiftDateDisplay, Mode=OneWay}" IsReadOnly="True" Margin="0,0,12,0"
                                         materialDesign:HintAssist.Hint="Date" materialDesign:HintAssist.IsFloating="True"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                                <TextBox Grid.Column="1" Text="{Binding SelectedSubmission.ShiftType, FallbackValue='', Mode=OneWay}" IsReadOnly="True" Margin="0,0,12,0"
                                         materialDesign:HintAssist.Hint="Shift" materialDesign:HintAssist.IsFloating="True"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                                <TextBox Grid.Column="2" Text="{Binding SelectedSubmission.DsmName, FallbackValue='', Mode=OneWay}" IsReadOnly="True" Margin="0,0,12,0"
                                         materialDesign:HintAssist.Hint="DSM Name" materialDesign:HintAssist.IsFloating="True"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                                <TextBox Grid.Column="3" Text="{Binding SelectedSubmission.PumpId, FallbackValue='', StringFormat='Pump {0}', Mode=OneWay}" IsReadOnly="True" Margin="0,0,12,0"
                                         materialDesign:HintAssist.Hint="Pump" materialDesign:HintAssist.IsFloating="True"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                                <TextBox Grid.Column="4" Text="{Binding HeaderSubmittedTimeDisplay, Mode=OneWay}" IsReadOnly="True"
                                         materialDesign:HintAssist.Hint="Submitted At" materialDesign:HintAssist.IsFloating="True"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                            </Grid>

                            <!-- Submission Notes (if any) -->
                            <Border Background="#FFF9C4" BorderBrush="#FBC02D" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,10,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SubmissionNotes}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SubmissionNotes}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding SubmissionNotes, StringFormat='📝 Notes: {0}'}" FontSize="12.5" Foreground="#7F0000" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- TABLE 1: NOZZLE READINGS -->
                    <materialDesign:Card Padding="20" UniformCornerRadius="12" Margin="0,0,0,16"
                                         materialDesign:ElevationAssist.Elevation="Dp3">
                        <StackPanel>
                            <TextBlock Text="⛽ Nozzle Readings" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesign.Brush.Primary.Light}" Margin="0,0,0,10"/>

                            <!-- Continuity Gap Warning Banner (if any) -->
                            <Border Background="#FFF3E0" BorderBrush="#FFB74D" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,8"
                                    Visibility="{Binding HasContinuityWarnings, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="⚠️ Continuity warnings detected on opening readings:" FontWeight="Bold" FontSize="12" Foreground="#E65100"/>
                                    <ItemsControl ItemsSource="{Binding NozzleReadings}" Margin="0,2,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ContinuityWarning}" Visibility="{Binding HasContinuityError, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="#BF360C" FontSize="11.5" Margin="0,2,0,0"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <DataGrid ItemsSource="{Binding NozzleReadings}" AutoGenerateColumns="False"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      IsReadOnly="{Binding IsReadOnlyMode}"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      materialDesign:DataGridAssist.CellPadding="12 8"
                                      materialDesign:DataGridAssist.ColumnHeaderPadding="12 8">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Pump" Binding="{Binding PumpLabel}" IsReadOnly="True" Width="85"/>
                                    <DataGridTextColumn Header="Nozzle" Binding="{Binding NozzleNumber}" IsReadOnly="True" Width="80"/>
                                    <DataGridTextColumn Header="Fuel Type" Binding="{Binding FuelType}" IsReadOnly="True" Width="90"/>
                                    <DataGridTemplateColumn Header="Opening Reading" Width="170">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding OpeningReading, UpdateSourceTrigger=LostFocus, StringFormat=F2}"
                                                         FontSize="13" IsEnabled="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Closing Reading" Width="170">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding ClosingReading, UpdateSourceTrigger=LostFocus, StringFormat=F2}"
                                                         FontSize="13" IsEnabled="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Sale (L)" Binding="{Binding SaleLitres, StringFormat=F2}" IsReadOnly="True" Width="100"/>
                                    <DataGridTemplateColumn Header="Rate (₹)" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Rate, UpdateSourceTrigger=LostFocus, StringFormat=F2}"
                                                         FontSize="13" IsEnabled="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Amount (₹)" Binding="{Binding Amount, StringFormat=N2}" IsReadOnly="True" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- CUMULATIVE FUEL-TYPE DSR TOTALS -->
                            <Border Background="#F8F9FA" BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,12,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Fuel Type Chips -->
                                    <ItemsControl Grid.Row="0" ItemsSource="{Binding FuelTypeSummaries}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding BadgeBackground}" BorderBrush="{Binding BadgeBorder}" BorderThickness="1.5"
                                                        CornerRadius="6" Padding="10,6" Margin="0,0,10,6">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FuelTypeLabel}" FontWeight="Bold" FontSize="13" Foreground="{Binding BadgeForeground}" Margin="0,0,8,0"/>
                                                        <TextBlock FontSize="12" Foreground="#333333" VerticalAlignment="Center">
                                                            <Run Text="(" Foreground="#777777"/><Run Text="{Binding NozzleCount}" FontWeight="SemiBold"/><Run Text=" Nozzle" Foreground="#777777"/><Run Text="): "/><Run Text="{Binding TotalLitres, StringFormat=N2}" FontWeight="Bold"/><Run Text=" L × ₹"/><Run Text="{Binding Rate, StringFormat=N2}"/><Run Text=" = ₹"/><Run Text="{Binding TotalAmount, StringFormat=N2}" FontWeight="Bold" Foreground="{Binding BadgeForeground}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Overall Total Litres & Gross Sales Footer -->
                                    <Grid Grid.Row="1" Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="1" FontSize="14" FontWeight="SemiBold" Margin="0,0,24,0" VerticalAlignment="Center">
                                            <Run Text="Total Litres: "/><Run Text="{Binding TotalLitres, Mode=OneWay, StringFormat=F2, FallbackValue=0}" Foreground="#2196F3"/>
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center">
                                            <Run Text="Gross Sales: ₹"/><Run Text="{Binding GrossSales, Mode=OneWay, StringFormat=N2}" Foreground="#4CAF50"/>
                                        </TextBlock>
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- TABLE 2: PAYMENT & DEBIT & TESTING & EXPENSES -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT: Payments + Debits + Testing + Packaged Goods -->
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <!-- Payment Collection Card -->
                            <materialDesign:Card Padding="20" UniformCornerRadius="12" Margin="0,0,0,12"
                                                 materialDesign:ElevationAssist.Elevation="Dp3">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <materialDesign:PackIcon Kind="CreditCardOutline" Width="18" Height="18" Foreground="{DynamicResource MaterialDesign.Brush.Primary.Light}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Payment Collection" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource MaterialDesign.Brush.Primary.Light}" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel>
                                        <!-- PhonePe UPI -->
                                        <Border BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8" Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                                                Visibility="{Binding PhonePeIsActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel>
                                                <TextBlock FontWeight="Bold" FontSize="12" Opacity="0.9" Margin="0,0,0,6">
                                                    <Run Text="{Binding PhonePeDisplayName, Mode=OneWay}" Foreground="{DynamicResource MaterialDesign.Brush.Primary.Dark}"/>
                                                    <Run Text=" (Online)" Foreground="#888888" FontSize="11"/>
                                                </TextBlock>
                                                <!-- Morning / Day Amount (or single amount when split disabled) -->
                                                <TextBox Text="{Binding PhonePeMorning, UpdateSourceTrigger=LostFocus, StringFormat=F2}" Margin="0,0,0,4"
                                                         IsReadOnly="{Binding IsReadOnlyMode}"
                                                         materialDesign:HintAssist.Hint="{Binding PhonePeMorningLabel}" materialDesign:HintAssist.IsFloating="True"
                                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                                <!-- Night Shift (Only visible when split enabled) -->
                                                <TextBox Text="{Binding PhonePeNight, UpdateSourceTrigger=LostFocus, StringFormat=F2}" Margin="0,4,0,0"
                                                         IsReadOnly="{Binding IsReadOnlyMode}"
                                                         materialDesign:HintAssist.Hint="Night (&#x20B9;)" materialDesign:HintAssist.IsFloating="True"
                                                         Visibility="{Binding IsPhonePeSplitEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Credit Card (Only visible when active in settings) -->
                                        <Border BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8" Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                                                Visibility="{Binding CreditCardIsActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel>
                                                <TextBlock FontWeight="Bold" FontSize="12" Opacity="0.9" Margin="0,0,0,6">
                                                    <Run Text="{Binding CreditCardDisplayName, Mode=OneWay}" Foreground="{DynamicResource MaterialDesign.Brush.Primary.Dark}"/>
                                                    <Run Text=" (Card)" Foreground="#888888" FontSize="11"/>
                                                </TextBlock>
                                                <TextBox Text="{Binding CreditCardMorning, UpdateSourceTrigger=LostFocus, StringFormat=F2}" Margin="0,0,0,4"
                                                         IsReadOnly="{Binding IsReadOnlyMode}"
                                                         materialDesign:HintAssist.Hint="{Binding CreditCardMorningLabel}" materialDesign:HintAssist.IsFloating="True"
                                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                                <TextBox Text="{Binding CreditCardNight, UpdateSourceTrigger=LostFocus, StringFormat=F2}" Margin="0,4,0,0"
                                                         IsReadOnly="{Binding IsReadOnlyMode}"
                                                         materialDesign:HintAssist.Hint="Night (&#x20B9;)" materialDesign:HintAssist.IsFloating="True"
                                                         Visibility="{Binding IsCreditCardSplitEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Petro Card -->
                                        <Border BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8" Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                                                Visibility="{Binding PetroCardIsActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel>
                                                <TextBlock FontWeight="Bold" FontSize="12" Opacity="0.9" Margin="0,0,0,6">
                                                    <Run Text="{Binding PetroCardDisplayName, Mode=OneWay}" Foreground="{DynamicResource MaterialDesign.Brush.Primary.Dark}"/>
                                                    <Run Text=" (Card)" Foreground="#888888" FontSize="11"/>
                                                </TextBlock>
                                                <TextBox Text="{Binding PetroCardMorning, UpdateSourceTrigger=LostFocus, StringFormat=F2}" Margin="0,0,0,4"
                                                         IsReadOnly="{Binding IsReadOnlyMode}"
                                                         materialDesign:HintAssist.Hint="{Binding PetroCardMorningLabel}" materialDesign:HintAssist.IsFloating="True"
                                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                                <TextBox Text="{Binding PetroCardNight, UpdateSourceTrigger=LostFocus, StringFormat=F2}" Margin="0,4,0,0"
                                                         IsReadOnly="{Binding IsReadOnlyMode}"
                                                         materialDesign:HintAssist.Hint="Night (&#x20B9;)" materialDesign:HintAssist.IsFloating="True"
                                                         Visibility="{Binding IsPetroCardSplitEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Dynamic Collections Aggregate Summary (Read-Only) -->
                                        <ItemsControl ItemsSource="{Binding DynamicCollectionSummaries}"
                                                     Visibility="{Binding HasDynamicSummaries, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8" Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
                                                        <DockPanel LastChildFill="False">
                                                            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontWeight="Bold" FontSize="12" Opacity="0.9">
                                                                <Run Text="{Binding DisplayName, Mode=OneWay}" Foreground="{DynamicResource MaterialDesign.Brush.Primary.Dark}"/>
                                                                <Run Text=" (Dynamic)" Foreground="#888888" FontSize="11"/>
                                                            </TextBlock>
                                                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
                                                                <Run Text="&#x20B9; "/><Run Text="{Binding Amount, Mode=OneWay, StringFormat=N2}"/>
                                                            </TextBlock>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Machine Slip Number / OTP Transactions -->
                                        <Border Background="#0D1565C0" BorderBrush="#261565C0" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8"
                                                Visibility="{Binding HasOtpTransactions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel>
                                                <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <materialDesign:PackIcon Kind="CreditCardCheckOutline" Width="16" Height="16" Foreground="#1565C0" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock Text="Machine Slip Number Transactions (Itemized Swipes)" FontWeight="SemiBold" FontSize="12" Foreground="#1565C0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DockPanel>

                                                <DataGrid ItemsSource="{Binding CardSwipeDetails}" AutoGenerateColumns="False" 
                                                          IsReadOnly="{Binding IsReadOnlyMode}"
                                                          CanUserAddRows="False" CanUserDeleteRows="{Binding IsEditable}"
                                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" materialDesign:DataGridAssist.CellPadding="8 4" materialDesign:DataGridAssist.ColumnHeaderPadding="8 4">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Collection Method" Binding="{Binding Mode}" MinWidth="150" Width="160"/>
                                                        <DataGridTextColumn Header="TID" Binding="{Binding TidDisplay}" Width="90"/>
                                                        <DataGridTextColumn Header="Batch" Binding="{Binding Batch}" Width="90"/>
                                                        <DataGridTextColumn Header="Slot" Binding="{Binding Slot}" Width="85"/>
                                                        <DataGridTextColumn Header="Slip No. / OTP" Binding="{Binding Otp}" Width="110"/>
                                                        <DataGridTemplateColumn Header="Amount (&#x20B9;)" Width="120">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <TextBox Text="{Binding Amount, UpdateSourceTrigger=LostFocus, StringFormat=F2}" FontWeight="SemiBold" HorizontalContentAlignment="Right" IsEnabled="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Itemized Card & TID Transactions -->
                                        <Border Background="#0D6A1B9A" BorderBrush="#266A1B9A" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8"
                                                Visibility="{Binding HasManualTidTransactions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel>
                                                <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <materialDesign:PackIcon Kind="CreditCardFastOutline" Width="16" Height="16" Foreground="#6A1B9A" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock Text="Itemized Card &amp; TID Transactions (Multiple Swipes)" FontWeight="SemiBold" FontSize="12" Foreground="#6A1B9A" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DockPanel>

                                                <DataGrid ItemsSource="{Binding ManualTidTransactions}" AutoGenerateColumns="False" 
                                                          IsReadOnly="{Binding IsReadOnlyMode}"
                                                          CanUserAddRows="False" CanUserDeleteRows="{Binding IsEditable}"
                                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" materialDesign:DataGridAssist.CellPadding="8 4" materialDesign:DataGridAssist.ColumnHeaderPadding="8 4">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Collection Type" Binding="{Binding Mode}" MinWidth="150" Width="160"/>
                                                        <DataGridTextColumn Header="TID" Binding="{Binding Tid}" Width="100"/>
                                                        <DataGridTextColumn Header="Batch" Binding="{Binding Batch}" Width="100"/>
                                                        <DataGridTextColumn Header="Slot" Binding="{Binding Slot}" Width="90"/>
                                                        <DataGridTemplateColumn Header="Amount (&#x20B9;)" Width="120">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <TextBox Text="{Binding Amount, UpdateSourceTrigger=LostFocus, StringFormat=F2}" FontWeight="SemiBold" HorizontalContentAlignment="Right" IsEnabled="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Cross-DSM QR Payments -->
                                        <Border Background="#0D00796B" BorderBrush="#2600796B" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8"
                                                Visibility="{Binding HasQrPayments, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel>
                                                <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <materialDesign:PackIcon Kind="QrcodeScan" Width="16" Height="16" Foreground="#00796B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock Text="Cross-DSM QR Payments (Customer paid to another DSM's QR)" FontWeight="SemiBold" FontSize="12" Foreground="#00796B" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DockPanel>

                                                <DataGrid ItemsSource="{Binding QrPayments}" AutoGenerateColumns="False" IsReadOnly="True"
                                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" materialDesign:DataGridAssist.CellPadding="8 4" materialDesign:DataGridAssist.ColumnHeaderPadding="8 4">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Paid on DSM QR" Binding="{Binding TargetDsmName}" Width="2*"/>
                                                        <DataGridTextColumn Header="Amount (&#x20B9;)" Binding="{Binding Amount, StringFormat=N2}" Width="130"/>
                                                        <DataGridTextColumn Header="TID" Binding="{Binding Tid}" Width="*"/>
                                                        <DataGridTextColumn Header="Batch" Binding="{Binding Batch}" Width="*"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Cash Deposit & Others -->
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding CashDepositAmount, UpdateSourceTrigger=LostFocus, StringFormat=F2}" Margin="0,0,6,0"
                                                     IsReadOnly="{Binding IsReadOnlyMode}"
                                                     materialDesign:HintAssist.Hint="Cash 1" materialDesign:HintAssist.IsFloating="True"
                                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                            <TextBox Grid.Column="1" Text="{Binding OthersAmount, UpdateSourceTrigger=LostFocus, StringFormat=F2}" Margin="6,0,0,0"
                                                     IsReadOnly="{Binding IsReadOnlyMode}"
                                                     materialDesign:HintAssist.Hint="Others (Not in Total)" materialDesign:HintAssist.IsFloating="True"
                                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                        </Grid>

                                        <!-- Collection Reduction -->
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="2*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding CollectionReductionAmount, UpdateSourceTrigger=LostFocus, StringFormat=F2}" Margin="0,0,6,0"
                                                     IsReadOnly="{Binding IsReadOnlyMode}"
                                                     materialDesign:HintAssist.Hint="Collection Reduction (&#x20B9;)" materialDesign:HintAssist.IsFloating="True"
                                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                            <TextBox Grid.Column="1" Text="{Binding CollectionReductionRemark, UpdateSourceTrigger=PropertyChanged}" Margin="6,0,0,0"
                                                     IsReadOnly="{Binding IsReadOnlyMode}"
                                                     materialDesign:HintAssist.Hint="Reduction Remark" materialDesign:HintAssist.IsFloating="True"
                                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </materialDesign:Card>

                            <!-- Debits (Credit Customers / Khata) Card -->
                            <materialDesign:Card Padding="20" UniformCornerRadius="12" Margin="0,0,0,12"
                                                 materialDesign:ElevationAssist.Elevation="Dp3">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8" LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="AccountClockOutline" Width="18" Height="18" Foreground="{DynamicResource MaterialDesign.Brush.Primary.Light}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Debtors" FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource MaterialDesign.Brush.Primary.Light}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border DockPanel.Dock="Right" Background="#FFF3E0" CornerRadius="12" Padding="10,4">
                                            <TextBlock Text="{Binding CreditAmount, StringFormat='Total Credit: &#x20B9;{0:N2}'}" FontSize="12" FontWeight="Bold" Foreground="#E65100"/>
                                        </Border>
                                    </DockPanel>

                                    <DataGrid ItemsSource="{Binding DebtorEntries}" AutoGenerateColumns="False" 
                                              IsReadOnly="{Binding IsReadOnlyMode}"
                                              CanUserAddRows="{Binding IsEditable}" CanUserDeleteRows="{Binding IsEditable}"
                                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                              materialDesign:DataGridAssist.CellPadding="10 6" materialDesign:DataGridAssist.ColumnHeaderPadding="10 6">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Debtor Name" Binding="{Binding DebtorName}" Width="2*"/>
                                            <DataGridTextColumn Header="Vehicle No." Binding="{Binding VehicleNumber}" Width="*"/>
                                            <DataGridTextColumn Header="Slip No." Binding="{Binding SlipNumber}" Width="*"/>
                                            <DataGridTextColumn Header="Time" Binding="{Binding EntryTime}" Width="75"/>
                                            <DataGridTemplateColumn Header="Amount (&#x20B9;)" Width="110">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBox Text="{Binding Amount, UpdateSourceTrigger=LostFocus, StringFormat=F2}" FontSize="13" IsEnabled="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </materialDesign:Card>

                            <!-- Testing Section -->
                            <materialDesign:Card Padding="20" UniformCornerRadius="12" Margin="0,0,0,12"
                                                 materialDesign:ElevationAssist.Elevation="Dp3"
                                                 Visibility="{Binding HasTestingEntries, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8" LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="FlaskOutline" Width="18" Height="18" Foreground="{DynamicResource MaterialDesign.Brush.Primary.Light}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Testing" FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource MaterialDesign.Brush.Primary.Light}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border DockPanel.Dock="Right" Background="#FFF8E1" CornerRadius="12" Padding="10,4">
                                            <TextBlock Text="{Binding TotalTestingAmount, StringFormat='Total Testing: &#x20B9;{0:N2}'}" FontSize="12" FontWeight="Bold" Foreground="#F57C00"/>
                                        </Border>
                                    </DockPanel>
                                    <DataGrid ItemsSource="{Binding SubmissionTestingEntries}" AutoGenerateColumns="False"
                                              CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                              materialDesign:DataGridAssist.CellPadding="10 6" materialDesign:DataGridAssist.ColumnHeaderPadding="10 6">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Fuel Type" Binding="{Binding FuelType}" Width="*"/>
                                            <DataGridTextColumn Header="Nozzle #" Binding="{Binding NozzleId}" Width="80"/>
                                            <DataGridTextColumn Header="Litres" Binding="{Binding Amount, StringFormat=F2}" Width="100"/>
                                            <DataGridTextColumn Header="Amount (&#x20B9;)" Binding="{Binding RupeeAmount, StringFormat=N2}" Width="110"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </materialDesign:Card>

                            <!-- Oil & DEF Product Sales Card -->
                            <materialDesign:Card Padding="20" UniformCornerRadius="12" Margin="0,0,0,12" materialDesign:ElevationAssist.Elevation="Dp3">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10" LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Oil" Width="20" Height="20" Foreground="#00796B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Oil &amp; DEF Product Sales" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesign.Brush.Primary.Light}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="+ Add Sale" Command="{Binding AddOilDefSaleCommand}"
                                                    Style="{StaticResource MaterialDesignRaisedButton}" Background="#00796B" BorderBrush="#00796B"
                                                    Height="28" Padding="10,0" Margin="0,0,6,0" FontSize="11"/>
                                            <Button Content="Catalog" Command="{Binding ToggleProductCatalogPanelCommand}"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                                    Height="28" Padding="10,0" FontSize="11"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- Master Product Catalog Management Drawer (Expandable) -->
                                    <materialDesign:Card Margin="0,0,0,10" Padding="12" UniformCornerRadius="8" Background="#F5F5F5"
                                                         Visibility="{Binding ShowProductCatalogPanel, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="Master Product Catalog" FontSize="13" FontWeight="Bold" Foreground="#004D40" Margin="0,0,0,8"/>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Text="{Binding NewProductName, UpdateSourceTrigger=PropertyChanged}"
                                                         materialDesign:HintAssist.Hint="Product Name" Margin="0,0,6,0" Height="36"/>
                                                <ComboBox Grid.Column="1" ItemsSource="{Binding ProductCategories}" SelectedItem="{Binding NewProductCategory}"
                                                          materialDesign:HintAssist.Hint="Category" Margin="0,0,6,0" Height="36"/>
                                                <ComboBox Grid.Column="2" ItemsSource="{Binding ProductUnits}" SelectedItem="{Binding NewProductUnit}"
                                                          materialDesign:HintAssist.Hint="Unit" Margin="0,0,6,0" Height="36"/>
                                                <TextBox Grid.Column="3" Text="{Binding NewProductDefaultRate, UpdateSourceTrigger=PropertyChanged}"
                                                         materialDesign:HintAssist.Hint="Default Rate (&#x20B9;)" Margin="0,0,6,0" Height="36"/>
                                                <Button Grid.Column="4" Content="Save" Command="{Binding AddProductMasterCommand}"
                                                        Style="{StaticResource MaterialDesignRaisedButton}" Height="36" Background="#004D40" BorderBrush="#004D40"/>
                                            </Grid>
                                            
                                            <!-- Product List -->
                                            <DataGrid ItemsSource="{Binding AvailableProducts}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                                      MaxHeight="140" GridLinesVisibility="Horizontal" materialDesign:DataGridAssist.CellPadding="6 3">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="2*"/>
                                                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*"/>
                                                    <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="*"/>
                                                    <DataGridTextColumn Header="Default Rate (&#x20B9;)" Binding="{Binding DefaultSaleRate, StringFormat='{}{0:N2}'}" Width="*"/>
                                                    <DataGridTemplateColumn Header="Action" Width="60">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Button Style="{StaticResource MaterialDesignIconButton}" Height="24" Width="24" ToolTip="Delete Product" Foreground="#D32F2F"
                                                                        Command="{Binding DataContext.DeleteProductMasterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}">
                                                                    <materialDesign:PackIcon Kind="Delete" Width="14" Height="14"/>
                                                                </Button>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </materialDesign:Card>

                                    <!-- Sales DataGrid -->
                                    <DataGrid ItemsSource="{Binding OilDefSales}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="False"
                                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" materialDesign:DataGridAssist.CellPadding="8 4" materialDesign:DataGridAssist.ColumnHeaderPadding="10 6">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="Product Name" Width="2*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox ItemsSource="{Binding DataContext.AvailableProducts, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  DisplayMemberPath="ProductName" SelectedValuePath="Id"
                                                                  SelectedValue="{Binding ProductId, UpdateSourceTrigger=PropertyChanged}"
                                                                  Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}"
                                                                  IsEditable="True" Height="32"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Qty Sold" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F2}}" Height="32" FontWeight="SemiBold"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="65" IsReadOnly="True"/>
                                            <DataGridTemplateColumn Header="Price (&#x20B9;)" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBox Text="{Binding Price, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F2}}" Height="32"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Total (&#x20B9;)" Binding="{Binding Total, StringFormat='&#x20B9;{0:N2}'}" Width="95" IsReadOnly="True" FontWeight="Bold"/>
                                            <DataGridTemplateColumn Header="Action" Width="55">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource MaterialDesignIconButton}" Height="24" Width="24" Foreground="#D32F2F" ToolTip="Remove Entry"
                                                                Command="{Binding DataContext.DeleteOilDefSaleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <materialDesign:PackIcon Kind="TrashCan" Width="16" Height="16"/>
                                                        </Button>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </materialDesign:Card>
                        </StackPanel>

                        <!-- RIGHT: Cash 1 + Cash 2 + Expenses + Personal Ledger -->
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <!-- Cash 1 (Bank Deposit) -->
                            <materialDesign:Card Padding="20" UniformCornerRadius="12" Margin="0,0,0,12"
                                                 materialDesign:ElevationAssist.Elevation="Dp3">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <materialDesign:PackIcon Kind="BankOutline" Width="18" Height="18" Foreground="{DynamicResource MaterialDesign.Brush.Primary.Light}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Cash 1" FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource MaterialDesign.Brush.Primary.Light}" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- &#x20B9;500 -->
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Background="#E8F5E9" CornerRadius="4" Padding="6,4" Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="&#x20B9;500" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                                        </Border>
                                        <TextBox Grid.Column="1" Margin="0,0,4,0"
                                                 Text="{Binding Cash1.Denom500, UpdateSourceTrigger=LostFocus}"
                                                 IsReadOnly="{Binding IsReadOnlyMode}"
                                                 materialDesign:HintAssist.Hint="Qty" materialDesign:HintAssist.IsFloating="True"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                        <TextBox Grid.Column="2" IsReadOnly="True" Focusable="False"
