                                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                              materialDesign:DataGridAssist.CellPadding="8 4" materialDesign:DataGridAssist.ColumnHeaderPadding="8 4"
                                              Visibility="{Binding HasPersonalDebtors, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="DSM Name" Binding="{Binding DsmName}" Width="2*"/>
                                            <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="80"/>
                                            <DataGridTextColumn Header="Amount (&#x20B9;)" Binding="{Binding Amount, StringFormat=N2}" Width="110"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </materialDesign:Card>

                            <!-- Debtor Repayments (Direct to DSM) Section -->
                            <materialDesign:Card Padding="20" UniformCornerRadius="12" Margin="0,0,0,12"
                                                 materialDesign:ElevationAssist.Elevation="Dp3"
                                                 Visibility="{Binding HasDebtorRepayments, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <materialDesign:PackIcon Kind="HandCoin" Width="18" Height="18" Foreground="{DynamicResource MaterialDesign.Brush.Primary.Light}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Debtor Repayments (Direct to DSM)" FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource MaterialDesign.Brush.Primary.Light}" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <DataGrid ItemsSource="{Binding DebtorRepayments}" AutoGenerateColumns="False" IsReadOnly="True"
                                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                              materialDesign:DataGridAssist.CellPadding="8 4" materialDesign:DataGridAssist.ColumnHeaderPadding="8 4">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Debtor Name" Binding="{Binding DebtorName}" Width="2*"/>
                                            <DataGridTextColumn Header="Collection Mode" Binding="{Binding PaymentMode}" Width="130"/>
                                            <DataGridTextColumn Header="Amount (&#x20B9;)" Binding="{Binding Amount, StringFormat=N2}" Width="110"/>
                                            <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </materialDesign:Card>
                        </StackPanel>
                    </Grid>

                    <!-- RECONCILIATION CARD (Identical to DsmEntryView 5-column layout) -->
                    <materialDesign:Card Padding="24" UniformCornerRadius="12" Margin="0,0,0,20"
                                         materialDesign:ElevationAssist.Elevation="Dp4">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <materialDesign:PackIcon Kind="ScaleBalance" Width="20" Height="20" Foreground="{DynamicResource MaterialDesign.Brush.Primary.Light}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Reconciliation" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MaterialDesign.Brush.Primary.Light}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <UniformGrid Columns="5">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Net Sales" Opacity="0.6" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding NetFuelSales, StringFormat='&#x20B9;{0:N2}'}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Total In (Direct)" Opacity="0.6" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding TotalPaymentIn, StringFormat='&#x20B9;{0:N2}'}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Debtors" Opacity="0.6" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding CreditAmount, StringFormat='&#x20B9;{0:N2}'}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Total Collection" Opacity="0.6" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding TotalCollections, StringFormat='&#x20B9;{0:N2}'}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Direct + Debtors + Exp" FontSize="10" Opacity="0.5" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Mismatch" Opacity="0.6" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding MismatchAmount, StringFormat='&#x20B9;{0:N2}'}" FontSize="22" FontWeight="Bold"
                                               Foreground="{Binding MismatchAmount, Converter={StaticResource DiffColorConv}}" HorizontalAlignment="Center"
                                               ToolTip="Mismatch = Total Collection - Net Sales. Total Collection includes direct payments, debtors, and expenses. Testing is deducted from gross sales."/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Validation & Continuity Warnings Card -->
                    <materialDesign:Card Padding="20" UniformCornerRadius="12" Margin="0,0,0,16" materialDesign:ElevationAssist.Elevation="Dp3">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <materialDesign:PackIcon Kind="AlertOutline" Width="18" Height="18" Foreground="{DynamicResource MaterialDesign.Brush.Primary.Light}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Validation Summary" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesign.Brush.Primary.Light}" VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <Border Background="#FFF9C4" CornerRadius="8" Padding="12" Margin="0,0,0,12"
                                    Visibility="{Binding HasContinuityWarnings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Continuity Errors / Warnings Detected:" FontWeight="Bold" Foreground="#F57C00"/>
                                    <ItemsControl ItemsSource="{Binding NozzleReadings}" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ContinuityWarning}" Visibility="{Binding HasContinuityError, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="#E65100" Margin="0,4,0,0"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Legacy Duplicate Advisory Banner -->
                            <Border Background="#FFF3E0" BorderBrush="#FFE0B2" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12"
                                    Visibility="{Binding HasAmbiguousLegacyDuplicates, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="AlertCircleOutline" Width="20" Height="20" Foreground="#E65100" VerticalAlignment="Top" Margin="0,2,10,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Ambiguous Legacy Duplicates Advisory" FontWeight="Bold" Foreground="#E65100"/>
                                        <TextBlock Text="{Binding LegacyDuplicateAdvisoryMessage}" Foreground="#BF360C" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding ValidationSummary}" TextWrapping="Wrap" Margin="0,0,0,16" FontSize="14" FontWeight="SemiBold"/>

                            <!-- Override Panel -->
                            <StackPanel Visibility="{Binding HasContinuityWarnings, Converter={StaticResource BooleanToVisibilityConverter}}" IsEnabled="{Binding IsEditable}">
                                <CheckBox Content="Override continuity warnings" IsChecked="{Binding OverrideContinuity}" Margin="0,0,0,12"/>
                                <TextBox Text="{Binding OverrideRemark, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding OverrideContinuity}"
                                         materialDesign:HintAssist.Hint="Manager's Override Remark (Required)" materialDesign:HintAssist.IsFloating="True" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Submission Timeline & Audit Trail -->
                    <materialDesign:Card Padding="20" UniformCornerRadius="12" Margin="0,0,0,16" materialDesign:ElevationAssist.Elevation="Dp3"
                                         Visibility="{Binding IsReadOnlyMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Timeline &amp; Audit Trail" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesign.Brush.Primary.Light}" Margin="0,0,0,12"/>
                            
                            <ItemsControl ItemsSource="{Binding TimelineLogs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:DsmTimelineLog}">
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Visual indicator line & circle -->
                                            <Grid Grid.Column="0" HorizontalAlignment="Center">
                                                <Border Width="2" Background="#E0E0E0" Height="40" VerticalAlignment="Stretch"/>
                                                <Ellipse Width="10" Height="10" Fill="#4CAF50" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                            </Grid>
                                            
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="12.5"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Timestamp}" FontSize="10.5" Opacity="0.5" VerticalAlignment="Center"/>
                                                </Grid>
                                                <TextBlock Text="{Binding Description}" FontSize="11.5" Opacity="0.7" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Incomplete Submission Warning Card -->
                    <materialDesign:Card Padding="14,10" UniformCornerRadius="8" Background="#FFF3E0" Margin="0,0,0,16"
                                         materialDesign:ElevationAssist.Elevation="Dp1"
                                         Visibility="{Binding IsSubmissionComplete, Converter={StaticResource InverseBoolToVis}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="AlertCircleOutline" Width="20" Height="20" Foreground="#E65100" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SubmissionIncompleteReason}" Foreground="#E65100" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Action Buttons -->
                    <Grid Margin="0,0,0,32" Visibility="{Binding IsEditable, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Approve Submission" 
                                Command="{Binding ApproveCommand}" 
                                IsEnabled="{Binding CanApprove}"
                                Height="48" Style="{StaticResource MaterialDesignRaisedButton}"/>
                        <Button Grid.Column="2" Content="Reject Submission" Command="{Binding RejectCommand}" Height="48" Style="{StaticResource MaterialDesignRaisedButton}" Background="#D32F2F" BorderBrush="#D32F2F"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>

