                                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                              materialDesign:DataGridAssist.CellPadding="8 4" materialDesign:DataGridAssist.ColumnHeaderPadding="8 4"
                                              Margin="0,0,0,6" Visibility="{Binding HasKhandhareEntries, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Person Name" Binding="{Binding Name}" Width="2*"/>
                                            <DataGridTextColumn Header="Vehicle No." Binding="{Binding VehicleNumber}" Width="*"/>
                                            <DataGridTextColumn Header="Slip No." Binding="{Binding SlipNumber}" Width="*"/>
                                            <DataGridTextColumn Header="Amount (&#x20B9;)" Binding="{Binding Amount, StringFormat=N2}" Width="110"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

