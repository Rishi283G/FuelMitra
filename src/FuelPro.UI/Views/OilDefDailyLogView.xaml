<UserControl x:Class="FuelPro.UI.Views.OilDefDailyLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:FuelPro.UI.Converters">
    <UserControl.Resources>
        <converters:IndianCurrencyConverter x:Key="CurrencyConverter"/>
        <converters:LitresConverter x:Key="LitresConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        
        <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="Foreground" Value="#212121"/>
        </Style>
        <Style TargetType="DatePicker" BasedOn="{StaticResource MaterialDesignOutlinedDatePicker}">
            <Setter Property="Foreground" Value="#212121"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
            <Setter Property="Foreground" Value="#212121"/>
        </Style>

        <Style x:Key="RateLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Rate Card -->
            <RowDefinition Height="*"/>
            <!-- Tabs -->
        </Grid.RowDefinitions>

        <!-- ─── Header ─── -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <materialDesign:PackIcon Kind="Oil" Width="28" Height="28" Foreground="#00796B" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="Oil &amp; DEF Management" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- ─── Persistent Sale Rate Card ─── -->
        <materialDesign:Card Grid.Row="1" Margin="0,0,0,16" Padding="16,14"
                             UniformCornerRadius="10" materialDesign:ElevationAssist.Elevation="Dp2"
                             Background="#E8F5E9">
            <DockPanel LastChildFill="True">
                <!-- Icon + Label -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                    <materialDesign:PackIcon Kind="Tag" Width="22" Height="22" Foreground="#2E7D32" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <StackPanel>
                        <TextBlock Text="Sale Rates" FontSize="14" FontWeight="Bold" Foreground="#1B5E20"/>
                        <TextBlock Text="Set once — used as default for all sales" FontSize="11" Opacity="0.6"/>
                    </StackPanel>
                </StackPanel>

                <!-- Save Rates Button -->
                <Button DockPanel.Dock="Right" Content="Save Rates" Style="{StaticResource MaterialDesignRaisedButton}"
                        Command="{Binding SaveProductRatesCommand}"
                        Background="#2E7D32" BorderBrush="#2E7D32"
                        Height="40" Padding="16,0" VerticalAlignment="Center"
                        Margin="12,0,0,0"/>

                <!-- Product Rates — one row per product -->
                <ItemsControl ItemsSource="{Binding ActiveProducts}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="8" Padding="12,6" Margin="0,0,12,6"
                                    BorderBrush="#A5D6A7" BorderThickness="1.5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="140"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="105"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Product Label -->
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ProductName}" FontSize="12.5" FontWeight="Bold"
                                                   Foreground="#1B5E20" TextWrapping="Wrap" MaxWidth="200"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding CurrentStock, StringFormat='Stock: {0:N2}'}" FontSize="11" FontWeight="Bold" Foreground="#1565C0"/>
                                            <TextBlock Text="{Binding Unit, StringFormat=' {0}'}" FontSize="10.5" FontWeight="Medium" Foreground="#388E3C" Opacity="0.8"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Vertical Divider Line -->
                                    <Border Grid.Column="1" Width="1.5" Background="#81C784" Margin="4,2,10,2" VerticalAlignment="Stretch"/>

                                    <!-- Style=null bypasses MaterialDesign theme which overrides Foreground via its internal template -->
                                    <TextBox Grid.Column="2"
                                             Text="{Binding DefaultSaleRate, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                             Style="{x:Null}"
                                             Width="105" Height="36"
                                             Background="#F1F8E9"
                                             Foreground="#1B5E20"
                                             FontSize="14" FontWeight="Bold"
                                             FontFamily="Segoe UI"
                                             BorderBrush="#43A047"
                                             BorderThickness="1.5"
                                             Padding="8,4"
                                             VerticalContentAlignment="Center"
                                             HorizontalContentAlignment="Right"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </materialDesign:Card>

        <!-- ─── Main Tab Control ─── -->
        <TabControl Grid.Row="2" materialDesign:ColorZoneAssist.Mode="Standard">

            <!-- TAB 1: Add Stock Purchase -->
            <TabItem Header="Add Stock Purchase">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3.2*" MinWidth="280" MaxWidth="380"/>
                        <ColumnDefinition Width="6.8*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Purchase Entry Form -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" MaxHeight="600" Margin="0,0,16,0">
                        <materialDesign:Card Padding="20"
                                            UniformCornerRadius="10" materialDesign:ElevationAssist.Elevation="Dp1"
                                            VerticalAlignment="Top">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                    <materialDesign:PackIcon Kind="PackageVariant" Width="22" Height="22" Foreground="#00796B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Record Stock Purchase" FontSize="16" FontWeight="Bold" Foreground="#00796B" VerticalAlignment="Center"/>
                                </StackPanel>

                                <DatePicker SelectedDate="{Binding PurchaseDate}" materialDesign:HintAssist.Hint="Purchase Date"
                                            Margin="0,0,0,14" Height="48"/>

                                <ComboBox ItemsSource="{Binding ActiveProducts}" SelectedItem="{Binding SelectedProductForPurchase}"
                                          DisplayMemberPath="ProductName"
                                          materialDesign:HintAssist.Hint="Select Product"
                                          Margin="0,0,0,14" Height="48"/>

                                <TextBox Text="{Binding PurchaseSupplierName, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Supplier / Vendor Name"
                                         Margin="0,0,0,14" Height="48"/>

                                <TextBox Text="{Binding PurchaseInvoiceNumber, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Invoice Number"
                                         Margin="0,0,0,14" Height="48"/>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Quantity Received" FontSize="11" Opacity="0.6" Margin="4,0,0,3"/>
                                        <TextBox Text="{Binding PurchaseQty, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="e.g. 10" Height="48"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Cost per Unit (₹)" FontSize="11" Opacity="0.6" Margin="4,0,0,3"/>
                                        <TextBox Text="{Binding PurchaseUnitPrice, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="e.g. 500.00" Height="48"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                                    <Button Content="Save Purchase" Style="{StaticResource MaterialDesignRaisedButton}"
                                            Command="{Binding SavePurchaseCommand}"
                                            Height="44" Background="#00796B" BorderBrush="#00796B" Width="180"/>
                                    <Button Content="Cancel Edit" Style="{StaticResource MaterialDesignFlatButton}"
                                            Command="{Binding CancelEditPurchaseCommand}"
                                            Visibility="{Binding IsEditingPurchase, Converter={StaticResource BoolToVisConverter}}"
                                            Height="44" Foreground="#D32F2F" Margin="10,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </materialDesign:Card>
                    </ScrollViewer>

                    <!-- Right: Recent Purchase History -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Recent Purchase Invoices" FontSize="15" FontWeight="Bold"
                                   Margin="0,0,0,10" Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding HistoryPurchases}" AutoGenerateColumns="False"
                                  IsReadOnly="True" materialDesign:DataGridAssist.CellPadding="8 6"
                                  GridLinesVisibility="All"
                                  VerticalGridLinesBrush="#CFD8DC"
                                  HorizontalGridLinesBrush="#ECEFF1"
                                  VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding PurchaseDate, StringFormat='{}{0:dd-MMM-yyyy}'}" Width="105"/>
                                <DataGridTextColumn Header="Product Name" Binding="{Binding ProductNameDisplay}" Width="2*" MinWidth="170" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="1.2*" MinWidth="110"/>
                                <DataGridTextColumn Header="Invoice #" Binding="{Binding InvoiceNumber}" Width="95"/>
                                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, StringFormat='{}{0:N2}'}" Width="75"/>
                                <DataGridTextColumn Header="Price/Unit (₹)" Binding="{Binding UnitPrice, StringFormat='₹{0:N2}'}" Width="105"/>
                                <DataGridTextColumn Header="Total Cost (₹)" Binding="{Binding TotalCost, StringFormat='₹{0:N2}'}" Width="110" FontWeight="Bold" Foreground="#2E7D32"/>
                                <DataGridTemplateColumn Header="Action" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Edit" Style="{StaticResource MaterialDesignFlatButton}"
                                                        Command="{Binding DataContext.EditPurchaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding IsEditable}"
                                                        Height="26" Padding="6,0" Margin="0,0,4,0"/>
                                                <Button Content="Delete" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#D32F2F"
                                                        Command="{Binding DataContext.DeletePurchaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding IsEditable}"
                                                        Height="26" Padding="6,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 2: Record Units Sold -->
            <TabItem Header="Record Units Sold">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3.2*" MinWidth="280" MaxWidth="380"/>
                        <ColumnDefinition Width="6.8*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Sales Entry Form -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" MaxHeight="600" Margin="0,0,16,0">
                        <materialDesign:Card Padding="20"
                                            UniformCornerRadius="10" materialDesign:ElevationAssist.Elevation="Dp1"
                                            VerticalAlignment="Top">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                    <materialDesign:PackIcon Kind="Cart" Width="22" Height="22" Foreground="#1565C0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Record Units Sold" FontSize="16" FontWeight="Bold" Foreground="#1565C0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <DatePicker SelectedDate="{Binding SaleDate}" materialDesign:HintAssist.Hint="Sale Date"
                                            Margin="0,0,0,14" Height="48"/>

                                <ComboBox ItemsSource="{Binding ActiveProducts}" SelectedItem="{Binding SelectedProduct}"
                                          DisplayMemberPath="ProductName"
                                          materialDesign:HintAssist.Hint="Select Product"
                                          Margin="0,0,0,6" Height="48"/>

                                <TextBlock Text="{Binding SelectedProduct.CurrentStock, StringFormat='Available Active Stock: {0:N2}'}" FontSize="12" FontWeight="SemiBold" Foreground="#1565C0" Margin="4,0,0,14"/>

                                <TextBox Text="{Binding SaleQty, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Quantity Sold"
                                         Margin="0,0,0,14" Height="48"/>

                                <!-- Override Rate (optional — auto-filled from product master) -->
                                <Border Background="#FFF8E1" CornerRadius="6" Padding="10,8" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource RateLabelStyle}" Text="Sale Rate (₹) — leave 0 to use default from rate card above"/>
                                        <TextBox Text="{Binding SaleRate, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="Override Rate (optional)"
                                                 Height="48"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                                    <Button Content="Save Daily Sale" Style="{StaticResource MaterialDesignRaisedButton}"
                                            Command="{Binding SaveSaleCommand}"
                                            Height="44" Background="#1565C0" BorderBrush="#1565C0" Width="180"/>
                                    <Button Content="Cancel Edit" Style="{StaticResource MaterialDesignFlatButton}"
                                            Command="{Binding CancelEditSaleCommand}"
                                            Visibility="{Binding IsEditingSale, Converter={StaticResource BoolToVisConverter}}"
                                            Height="44" Foreground="#D32F2F" Margin="10,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </materialDesign:Card>
                    </ScrollViewer>

                    <!-- Right: Recent Sales History -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Recent Sales Log" FontSize="15" FontWeight="Bold"
                                   Margin="0,0,0,10" Foreground="#1565C0"/>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding HistoryLogs}" AutoGenerateColumns="False"
                                  IsReadOnly="True" materialDesign:DataGridAssist.CellPadding="8 6"
                                  GridLinesVisibility="All"
                                  VerticalGridLinesBrush="#CFD8DC"
                                  HorizontalGridLinesBrush="#ECEFF1"
                                  VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date &amp; Time" Binding="{Binding LogDate, StringFormat='{}{0:dd-MMM-yyyy hh:mm tt}'}" Width="150"/>
                                <DataGridTextColumn Header="Product Name" Binding="{Binding ProductNameDisplay}" Width="2.2*" MinWidth="170" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="Qty Sold" Binding="{Binding SoldQuantity, StringFormat='{}{0:N2}'}" Width="85"/>
                                <DataGridTextColumn Header="Rate Used (₹)" Binding="{Binding EffectiveRate, StringFormat='₹{0:N2}'}" Width="105"/>
                                <DataGridTextColumn Header="Sales Value (₹)" Binding="{Binding SalesValue, StringFormat='₹{0:N2}'}" Width="115" FontWeight="Bold" Foreground="#1565C0"/>
                                <DataGridTextColumn Header="Stock After" Binding="{Binding EffectiveStockAfter, StringFormat='{}{0:N2}'}" Width="90"/>
                                <DataGridTextColumn Header="Adj." Binding="{Binding DayAdjustments, StringFormat='{}{0:N2}'}" Width="70"/>
                                <DataGridTemplateColumn Header="Action" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Edit" Style="{StaticResource MaterialDesignFlatButton}"
                                                        Command="{Binding DataContext.EditSaleLogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding IsEditable}"
                                                        Height="26" Padding="6,0" Margin="0,0,4,0"/>
                                                <Button Content="Delete" Style="{StaticResource MaterialDesignFlatButton}" Foreground="Red"
                                                        Command="{Binding DataContext.DeleteSaleLogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding IsEditable}"
                                                        Height="26" Padding="6,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 3: Stock Adjustments -->
            <TabItem Header="Stock Adjustments">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3.2*" MinWidth="280" MaxWidth="380"/>
                        <ColumnDefinition Width="6.8*"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" MaxHeight="600" Margin="0,0,16,0">
                        <materialDesign:Card Padding="20"
                                            UniformCornerRadius="10" materialDesign:ElevationAssist.Elevation="Dp1"
                                            VerticalAlignment="Top">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                    <materialDesign:PackIcon Kind="Wrench" Width="22" Height="22" Foreground="#E65100" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Record Stock Adjustment" FontSize="16" FontWeight="Bold" Foreground="#E65100" VerticalAlignment="Center"/>
                                </StackPanel>

                                <DatePicker SelectedDate="{Binding AdjustmentDate}" materialDesign:HintAssist.Hint="Adjustment Date"
                                            Margin="0,0,0,14" Height="48"/>

                                <ComboBox ItemsSource="{Binding ActiveProducts}" SelectedItem="{Binding SelectedProduct}"
                                          DisplayMemberPath="ProductName"
                                          materialDesign:HintAssist.Hint="Select Product"
                                          Margin="0,0,0,6" Height="48"/>

                                <TextBlock Text="{Binding SelectedProduct.CurrentStock, StringFormat='Current Active Stock: {0:N2}'}" FontSize="12" FontWeight="SemiBold" Foreground="#E65100" Margin="4,0,0,14"/>

                                <TextBox Text="{Binding AdjustmentQty, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Adjustment Qty (+/-, use negative to reduce)"
                                         Margin="0,0,0,14" Height="48"/>

                                <ComboBox ItemsSource="{Binding AdjustmentTypes}" SelectedItem="{Binding SelectedAdjustmentType}"
                                          materialDesign:HintAssist.Hint="Reason / Adjustment Type"
                                          Margin="0,0,0,14" Height="48"/>

                                <TextBox Text="{Binding AdjustmentRemarks, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Remarks (optional)"
                                         Margin="0,0,0,24" Height="48"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                                    <Button Content="Save Stock Adjustment" Style="{StaticResource MaterialDesignRaisedButton}"
                                            Command="{Binding SaveAdjustmentCommand}"
                                            Height="44" Background="#E65100" BorderBrush="#E65100" Width="180"/>
                                    <Button Content="Cancel Edit" Style="{StaticResource MaterialDesignFlatButton}"
                                            Command="{Binding CancelEditAdjustmentCommand}"
                                            Visibility="{Binding IsEditingAdjustment, Converter={StaticResource BoolToVisConverter}}"
                                            Height="44" Foreground="#D32F2F" Margin="10,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </materialDesign:Card>
                    </ScrollViewer>

                    <!-- Right: Adjustment history from logs -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Adjustment History" FontSize="15" FontWeight="Bold"
                                   Margin="0,0,0,10" Foreground="#E65100"/>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding HistoryAdjustments}" AutoGenerateColumns="False"
                                  IsReadOnly="True" materialDesign:DataGridAssist.CellPadding="8 6"
                                  GridLinesVisibility="All"
                                  VerticalGridLinesBrush="#CFD8DC"
                                  HorizontalGridLinesBrush="#ECEFF1"
                                  VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date &amp; Time" Binding="{Binding LogDate, StringFormat='{}{0:dd-MMM-yyyy hh:mm tt}'}" Width="145"/>
                                <DataGridTextColumn Header="Product Name" Binding="{Binding ProductNameDisplay}" Width="2*" MinWidth="170" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="Adj. Qty" Binding="{Binding AdjustmentQuantity, StringFormat='{}{0:N2}'}" Width="85" FontWeight="Bold"/>
                                <DataGridTextColumn Header="Type / Reason" Binding="{Binding AdjustmentType}" Width="1.4*"/>
                                <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks}" Width="1.6*"/>
                                <DataGridTextColumn Header="Stock After" Binding="{Binding EffectiveStockAfter, StringFormat='{}{0:N2}'}" Width="90"/>
                                <DataGridTemplateColumn Header="Action" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Edit" Style="{StaticResource MaterialDesignFlatButton}"
                                                        Command="{Binding DataContext.EditAdjustmentLogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding IsEditable}"
                                                        Height="26" Padding="6,0" Margin="0,0,4,0"/>
                                                <Button Content="Delete" Style="{StaticResource MaterialDesignFlatButton}" Foreground="Red"
                                                        Command="{Binding DataContext.DeleteAdjustmentLogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding IsEditable}"
                                                        Height="26" Padding="6,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 4: Product Catalog -->
            <TabItem Header="Product Catalog">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3.2*" MinWidth="280" MaxWidth="380"/>
                        <ColumnDefinition Width="6.8*"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" MaxHeight="600" Margin="0,0,16,0">
                        <materialDesign:Card Padding="20"
                                            UniformCornerRadius="10" materialDesign:ElevationAssist.Elevation="Dp1"
                                            VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="{Binding ProductFormTitle}" FontSize="16" FontWeight="Bold"
                                           Margin="0,0,0,16" Foreground="#4A148C"/>

                                <TextBox Text="{Binding NewProductName, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Product Name (e.g. Castrol CRB 20W40)"
                                         Margin="0,0,0,14" Height="48"/>

                                <ComboBox ItemsSource="{Binding ProductCategories}" SelectedItem="{Binding NewProductCategory}"
                                          materialDesign:HintAssist.Hint="Category (Oil / DEF)"
                                          Margin="0,0,0,14" Height="48"/>

                                <ComboBox ItemsSource="{Binding ProductUnits}" SelectedItem="{Binding NewProductUnit}"
                                          materialDesign:HintAssist.Hint="Unit"
                                          Margin="0,0,0,14" Height="48"/>

                                <TextBox Text="{Binding NewProductDefaultSaleRate, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Default Sale Rate / MRP (₹)"
                                         Margin="0,0,0,24" Height="48"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                                    <Button Content="{Binding ProductButtonContent}" Style="{StaticResource MaterialDesignRaisedButton}"
                                            Command="{Binding SaveProductMasterCommand}"
                                            Height="44" Background="#4A148C" BorderBrush="#4A148C" Width="150"/>
                                    <Button Content="Cancel" Style="{StaticResource MaterialDesignFlatButton}"
                                            Command="{Binding CancelEditProductCommand}"
                                            Visibility="{Binding IsEditingProduct, Converter={StaticResource BoolToVisConverter}}"
                                            Height="44" Foreground="#D32F2F" Margin="10,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </materialDesign:Card>
                    </ScrollViewer>

                    <!-- Catalog table -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Active Product Catalog" FontSize="15" FontWeight="Bold"
                                   Margin="0,0,0,10" Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding ActiveProducts}" AutoGenerateColumns="False"
                                  IsReadOnly="True" materialDesign:DataGridAssist.CellPadding="10 8"
                                  GridLinesVisibility="All"
                                  VerticalGridLinesBrush="#CFD8DC"
                                  HorizontalGridLinesBrush="#ECEFF1"
                                  VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="2.5*" MinWidth="190" FontWeight="Bold" Foreground="#4A148C"/>
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="1.1*"/>
                                <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="1.1*"/>
                                <DataGridTextColumn Header="Current Stock" Binding="{Binding CurrentStock, StringFormat='{}{0:N2}'}" Width="1.2*" FontWeight="Bold" Foreground="#1565C0"/>
                                <DataGridTextColumn Header="Default Rate (₹)" Binding="{Binding DefaultSaleRate, StringFormat='₹{0:N2}'}" Width="1.2*" FontWeight="SemiBold" Foreground="#2E7D32"/>
                                <DataGridTemplateColumn Header="Actions" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Edit" Style="{StaticResource MaterialDesignFlatButton}"
                                                        Command="{Binding DataContext.EditProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Height="26" Padding="6,0" Margin="0,0,4,0"/>
                                                <Button Content="Delete" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#D32F2F"
                                                        Command="{Binding DataContext.DeleteProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Height="26" Padding="6,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
