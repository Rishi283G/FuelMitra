<UserControl x:Class="FuelPro.UI.Views.DsmEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:FuelPro.UI.Converters"
             KeyDown="UserControl_KeyDown">
    <UserControl.Resources>
        <converters:IndianCurrencyConverter x:Key="CurrencyConv"/>
        <converters:LitreFormatConverter x:Key="LitreConv"/>
        <converters:DifferenceColorConverter x:Key="DiffColorConv"/>
        <converters:BoolToVisibilityConverter x:Key="BoolVisConv"/>
        <converters:DenomAmountConverter x:Key="DenomAmountConv"/>
        <converters:StringToVisibilityConverter x:Key="StringToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24">
        <StackPanel MaxWidth="1200">
            <!-- Page Header -->
            <TextBlock Text="DSM Entry" FontSize="28" FontWeight="Bold"
                       Foreground="{DynamicResource MaterialDesign.Brush.Primary}" Margin="0,0,0,20"/>

            <!-- HEADER FORM -->
            <materialDesign:Card Padding="24" UniformCornerRadius="12" Margin="0,0,0,20"
                                 materialDesign:ElevationAssist.Elevation="Dp3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <DatePicker Grid.Row="0" Grid.Column="0" SelectedDate="{Binding SelectedDate}" Margin="0,0,12,0"
                                materialDesign:HintAssist.Hint="Date" materialDesign:HintAssist.IsFloating="True"
                                Style="{StaticResource MaterialDesignOutlinedDatePicker}"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding ShiftOptions}" SelectedItem="{Binding SelectedShift}"
                              Margin="0,0,12,0"
                              materialDesign:HintAssist.Hint="Shift" materialDesign:HintAssist.IsFloating="True"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                    <ComboBox Grid.Row="0" Grid.Column="2" ItemsSource="{Binding DsmOptions}" IsEditable="True" Text="{Binding DsmName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0"
                              materialDesign:HintAssist.Hint="DSM Name" materialDesign:HintAssist.IsFloating="True"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                    <ComboBox Grid.Row="0" Grid.Column="3" ItemsSource="{Binding PumpOptions}" SelectedItem="{Binding SelectedPump}"
                              DisplayMemberPath="DisplayText"
                              Margin="0,0,12,0"
                              materialDesign:HintAssist.Hint="Pump" materialDesign:HintAssist.IsFloating="True"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}" MinWidth="200"/>
                    <ComboBox Grid.Row="0" Grid.Column="4" ItemsSource="{Binding ConnectablePumpOptions}" SelectedItem="{Binding SelectedConnectedPump}"
                              DisplayMemberPath="DisplayText"
                              materialDesign:HintAssist.Hint="Connect Pump (Optional)" materialDesign:HintAssist.IsFloating="True"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}" MinWidth="220"/>
                </Grid>
            </materialDesign:Card>

            <!-- DSM Cumulative Shift Summary Banner -->
            <Border Background="#E8F5E9" Padding="12" CornerRadius="8" Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DsmCumulativeShiftSummaryMessage, Converter={StaticResource StringToVis}}" Value="Visible">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding DsmCumulativeShiftSummaryMessage}" FontSize="13" FontWeight="SemiBold" Foreground="#1B5E20"/>
            </Border>

            <!-- TABLE 1: NOZZLE READINGS -->
            <materialDesign:Card Padding="20" UniformCornerRadius="12" Margin="0,0,0,20"
                                 materialDesign:ElevationAssist.Elevation="Dp3">
                <StackPanel>
                    <TextBlock Text="⛽ Nozzle Readings" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource MaterialDesign.Brush.Primary.Light}" Margin="0,0,0,12"/>
                    <Border Background="#E3F2FD" Padding="8" CornerRadius="6" Margin="0,0,0,8">
                        <TextBlock Text="{Binding AgsImportStatusText}" FontSize="12" TextWrapping="Wrap"/>
                    </Border>
                    <Border Background="#FFF9C4" Padding="8" CornerRadius="6" Margin="0,0,0,8">
                        <ItemsControl ItemsSource="{Binding OpeningWarnings}"/>
                    </Border>
                    <Border Background="#E8F5E9" Padding="8" CornerRadius="6" Margin="0,0,0,8">
                        <TextBlock Text="{Binding ConnectedPumpStatus}" FontSize="12" TextWrapping="Wrap"/>
                    </Border>

                    <DataGrid ItemsSource="{Binding NozzleReadings}" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              PreviewMouseWheel="DataGrid_PreviewMouseWheel"
                              materialDesign:DataGridAssist.CellPadding="12 8"
                              materialDesign:DataGridAssist.ColumnHeaderPadding="12 8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nozzle" Binding="{Binding NozzleNumber}" IsReadOnly="True" Width="80"/>
                            <DataGridTextColumn Header="Fuel Type" Binding="{Binding FuelTypeLabel}" IsReadOnly="True" Width="90"/>
                            <DataGridTemplateColumn Header="Opening Reading" Width="210">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Width="140" Text="{Binding OpeningReading, UpdateSourceTrigger=LostFocus, StringFormat=F2}"
                                                 PreviewTextInput="DecimalTextBox_PreviewTextInput"
                                                 DataObject.Pasting="DecimalTextBox_Pasting"
                                                 GotKeyboardFocus="DecimalTextBox_GotKeyboardFocus"
                                                 LostKeyboardFocus="DecimalTextBox_LostKeyboardFocus"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Closing Reading" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding ClosingReading, UpdateSourceTrigger=LostFocus, StringFormat=F2}"
                                                 PreviewTextInput="DecimalTextBox_PreviewTextInput"
                                                 DataObject.Pasting="DecimalTextBox_Pasting"
                                                 GotKeyboardFocus="DecimalTextBox_GotKeyboardFocus"
                                                 LostKeyboardFocus="DecimalTextBox_LostKeyboardFocus">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasValidationError}" Value="True">
                                                            <Setter Property="BorderBrush" Value="Red"/>
                                                            <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                                            <Setter Property="Foreground" Value="Red"/>
                                                            <Setter Property="ToolTip" Value="Closing reading must be greater than or equal to Opening reading."/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Sale (L)" Binding="{Binding SaleLitres, StringFormat=F4}" IsReadOnly="True" Width="120"/>
                            <DataGridTemplateColumn Header="Rate (₹)" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Rate, UpdateSourceTrigger=LostFocus, StringFormat=F2}"
                                                 PreviewTextInput="DecimalTextBox_PreviewTextInput"
                                                 DataObject.Pasting="DecimalTextBox_Pasting"
                                                 GotKeyboardFocus="DecimalTextBox_GotKeyboardFocus"
                                                 LostKeyboardFocus="DecimalTextBox_LostKeyboardFocus"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Amount (₹)" Binding="{Binding Amount, StringFormat=N2}" IsReadOnly="True" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" FontSize="14" FontWeight="SemiBold" Margin="0,0,32,0">
                            <Run Text="Total Litres: "/><Run Text="{Binding TotalLitres, Mode=OneWay, StringFormat=F4, FallbackValue=0}" Foreground="#2196F3"/>
                        </TextBlock>
                        <TextBlock Grid.Column="2" FontSize="14" FontWeight="SemiBold">
                            <Run Text="Gross Sales: ₹"/><Run Text="{Binding GrossSales, Mode=OneWay, StringFormat=N2}" Foreground="#4CAF50"/>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <!-- TABLE 2: PAYMENT & DEBIT & TESTING & EXPENSES -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: Payments + Debits + Testing + Expenses -->
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <!-- Payment Collection -->
                    <materialDesign:Card Padding="20" UniformCornerRadius="12" Margin="0,0,0,12"
                                         materialDesign:ElevationAssist.Elevation="Dp3">
                        <StackPanel>
                            <TextBlock Text="💳 Payment Collection" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesign.Brush.Primary.Light}" Margin="0,0,0,12"/>
                            <StackPanel>
                                <!-- Group 1: PhonePe UPI -->
                                <TextBlock Text="PhonePe UPI" FontWeight="Bold" FontSize="12" Opacity="0.8" Margin="0,4,0,8"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="1.4*"/>
                                        <ColumnDefinition Width="1.4*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <!-- Morning / Day Shift -->
                                    <TextBox Grid.Row="0" Grid.Column="0" Text="{Binding PhonePeMorning, UpdateSourceTrigger=LostFocus, StringFormat=F2}" Margin="0,0,8,8"
                                             materialDesign:HintAssist.Hint="{Binding MorningLabel}" materialDesign:HintAssist.IsFloating="True"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             PreviewTextInput="DecimalTextBox_PreviewTextInput"
                                             GotKeyboardFocus="DecimalTextBox_GotKeyboardFocus"
                                             LostKeyboardFocus="DecimalTextBox_LostKeyboardFocus"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding PhonePeTidMorning, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,8"
                                             materialDesign:HintAssist.Hint="{Binding MorningTidLabel}" materialDesign:HintAssist.IsFloating="True"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                    <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding PhonePeBatchMorning, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                                             materialDesign:HintAssist.Hint="{Binding MorningBatchLabel}" materialDesign:HintAssist.IsFloating="True"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                             
                                    <!-- Night Shift -->
                                    <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding PhonePeNight, UpdateSourceTrigger=LostFocus, StringFormat=F2}" Margin="0,0,8,0"
                                             materialDesign:HintAssist.Hint="Night (₹)" materialDesign:HintAssist.IsFloating="True"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             PreviewTextInput="DecimalTextBox_PreviewTextInput"
                                             GotKeyboardFocus="DecimalTextBox_GotKeyboardFocus"
                                             LostKeyboardFocus="DecimalTextBox_LostKeyboardFocus"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PhonePeTidNight, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                                             materialDesign:HintAssist.Hint="Night TID" materialDesign:HintAssist.IsFloating="True"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                    <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding PhonePeBatchNight, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,0"
                                             materialDesign:HintAssist.Hint="Night Batch" materialDesign:HintAssist.IsFloating="True"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                </Grid>

                                <!-- Group 2: PineLab Card -->
                                <TextBlock Text="PineLab Credit Card" FontWeight="Bold" FontSize="12" Opacity="0.8" Margin="0,4,0,8"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="1.4*"/>
                                        <ColumnDefinition Width="1.4*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <!-- Morning / Day Shift -->
                                    <TextBox Grid.Row="0" Grid.Column="0" Text="{Binding CreditCardMorning, UpdateSourceTrigger=LostFocus, StringFormat=F2}" Margin="0,0,8,8"
                                             materialDesign:HintAssist.Hint="{Binding MorningLabel}" materialDesign:HintAssist.IsFloating="True"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             PreviewTextInput="DecimalTextBox_PreviewTextInput"
                                             GotKeyboardFocus="DecimalTextBox_GotKeyboardFocus"
                                             LostKeyboardFocus="DecimalTextBox_LostKeyboardFocus"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding CreditCardTidMorning, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,8"
                                             materialDesign:HintAssist.Hint="{Binding MorningTidLabel}" materialDesign:HintAssist.IsFloating="True"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                    <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding CreditCardBatchMorning, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                                             materialDesign:HintAssist.Hint="{Binding MorningBatchLabel}" materialDesign:HintAssist.IsFloating="True"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                             
                                    <!-- Night Shift -->
                                    <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding CreditCardNight, UpdateSourceTrigger=LostFocus, StringFormat=F2}" Margin="0,0,8,0"
                                             materialDesign:HintAssist.Hint="Night (₹)" materialDesign:HintAssist.IsFloating="True"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             PreviewTextInput="DecimalTextBox_PreviewTextInput"
                                             GotKeyboardFocus="DecimalTextBox_GotKeyboardFocus"
                                             LostKeyboardFocus="DecimalTextBox_LostKeyboardFocus"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CreditCardTidNight, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                                             materialDesign:HintAssist.Hint="Night TID" materialDesign:HintAssist.IsFloating="True"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                    <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding CreditCardBatchNight, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,0"
                                             materialDesign:HintAssist.Hint="Night Batch" materialDesign:HintAssist.IsFloating="True"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                </Grid>

                                <!-- Group 3: Petro Card -->
                                <TextBlock Text="Petro Card" FontWeight="Bold" FontSize="12" Opacity="0.8" Margin="0,4,0,8"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="1.4*"/>
                                        <ColumnDefinition Width="1.4*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <!-- Morning / Day Shift -->
                                    <TextBox Grid.Row="0" Grid.Column="0" Text="{Binding PetroCardMorning, UpdateSourceTrigger=LostFocus, StringFormat=F2}" Margin="0,0,8,8"
                                             materialDesign:HintAssist.Hint="{Binding MorningLabel}" materialDesign:HintAssist.IsFloating="True"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             PreviewTextInput="DecimalTextBox_PreviewTextInput"
                                             GotKeyboardFocus="DecimalTextBox_GotKeyboardFocus"
                                             LostKeyboardFocus="DecimalTextBox_LostKeyboardFocus"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding PetroCardTidMorning, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,8"
                                             materialDesign:HintAssist.Hint="{Binding MorningTidLabel}" materialDesign:HintAssist.IsFloating="True"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                    <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding PetroCardBatchMorning, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                                             materialDesign:HintAssist.Hint="{Binding MorningBatchLabel}" materialDesign:HintAssist.IsFloating="True"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                             
                                    <!-- Night Shift -->
                                    <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding PetroCardNight, UpdateSourceTrigger=LostFocus, StringFormat=F2}" Margin="0,0,8,0"
                                             materialDesign:HintAssist.Hint="Night (₹)" materialDesign:HintAssist.IsFloating="True"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             PreviewTextInput="DecimalTextBox_PreviewTextInput"
                                             GotKeyboardFocus="DecimalTextBox_GotKeyboardFocus"
                                             LostKeyboardFocus="DecimalTextBox_LostKeyboardFocus"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PetroCardTidNight, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                                             materialDesign:HintAssist.Hint="Night TID" materialDesign:HintAssist.IsFloating="True"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                    <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding PetroCardBatchNight, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,0"
                                             materialDesign:HintAssist.Hint="Night Batch" materialDesign:HintAssist.IsFloating="True"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                </Grid>

                                <!-- Group 5: Other Collections -->
                                <TextBlock Text="Other Collections" FontWeight="Bold" FontSize="12" Opacity="0.8" Margin="0,4,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding Cash1.TotalAmount, Mode=OneWay, StringFormat=F2}" Margin="0,0,8,0"
                                             materialDesign:HintAssist.Hint="Cash 1" materialDesign:HintAssist.IsFloating="True"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             IsReadOnly="True" Focusable="False" Background="#F5F5F5"/>
                                    <TextBox Grid.Column="1" Text="{Binding Others, UpdateSourceTrigger=LostFocus, StringFormat=F2}" Margin="8,0,0,0"
                                             materialDesign:HintAssist.Hint="Others (Not in Total)" materialDesign:HintAssist.IsFloating="True"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             PreviewTextInput="DecimalTextBox_PreviewTextInput"
                                             GotKeyboardFocus="DecimalTextBox_GotKeyboardFocus"
                                             LostKeyboardFocus="DecimalTextBox_LostKeyboardFocus"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Debit Section -->
                    <materialDesign:Card Padding="20" UniformCornerRadius="12" Margin="0,0,0,12"
                                         materialDesign:ElevationAssist.Elevation="Dp3">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="📋 Debtors" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MaterialDesign.Brush.Primary.Light}"/>
                                <Button Content="+ Add" Margin="16,0,0,0"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Command="{Binding AddDebitCommand}" Height="28" FontSize="12"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Debits}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}" BorderThickness="0,0,0,1" Padding="0,8" Margin="0,4">
                                            <!-- Main Line (No conditional details needed) -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2.2*"/>
                                                    <ColumnDefinition Width="1.6*"/>
                                                    <ColumnDefinition Width="1.6*"/>
                                                    <ColumnDefinition Width="1.4*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <ComboBox IsEditable="True"
                                                          Text="{Binding DebtorName, UpdateSourceTrigger=PropertyChanged}"
                                                          ItemsSource="{Binding DataContext.Creditors, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          DisplayMemberPath="Name"
                                                          Margin="0,0,8,0"
                                                          materialDesign:HintAssist.Hint="Debtor Name"
                                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                                                
                                                <ComboBox Grid.Column="1" IsEditable="True"
                                                          Text="{Binding VehicleNumber, UpdateSourceTrigger=PropertyChanged}"
                                                          ItemsSource="{Binding AvailableVehicles}"
                                                          Margin="0,0,8,0"
                                                          materialDesign:HintAssist.Hint="Vehicle No."
                                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"/>

                                                <TextBox Grid.Column="2" Text="{Binding ChequeNo, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                                                         materialDesign:HintAssist.Hint="Slip No."
                                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                                                <TextBox Grid.Column="3" Text="{Binding Amount, UpdateSourceTrigger=LostFocus, StringFormat=F2}" Margin="0,0,8,0"
                                                         materialDesign:HintAssist.Hint="Amount"
                                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                         PreviewTextInput="DecimalTextBox_PreviewTextInput"
                                                         GotKeyboardFocus="DecimalTextBox_GotKeyboardFocus"
                                                         LostKeyboardFocus="DecimalTextBox_LostKeyboardFocus"/>

                                                <Button Grid.Column="4" Style="{StaticResource MaterialDesignIconButton}"
                                                        Command="{Binding DataContext.RemoveDebitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <materialDesign:PackIcon Kind="Delete" Foreground="#F44336"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Testing Section -->
                    <materialDesign:Card Padding="20" UniformCornerRadius="12" Margin="0,0,0,12"
                                         materialDesign:ElevationAssist.Elevation="Dp3"
                                         Visibility="{Binding ShowTesting, Converter={StaticResource BoolVisConv}}">
                        <StackPanel>
                            <TextBlock Text="🧪 Testing" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesign.Brush.Primary.Light}" Margin="0,0,0,8"/>
                            <DataGrid ItemsSource="{Binding TestingRows}" AutoGenerateColumns="False"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      PreviewMouseWheel="DataGrid_PreviewMouseWheel"
                                      PreviewKeyDown="TestingDataGrid_PreviewKeyDown"
                                      materialDesign:DataGridAssist.CellPadding="12 8"
                                      materialDesign:DataGridAssist.ColumnHeaderPadding="12 8">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Nozzle" Binding="{Binding FuelType}" IsReadOnly="True" Width="160"/>
                                    <DataGridTextColumn Header="Tank" Binding="{Binding TankName}" IsReadOnly="True" Width="120"/>
                                    <DataGridTemplateColumn Header="Litres" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Litres, UpdateSourceTrigger=LostFocus, StringFormat=F4}"
                                                         PreviewTextInput="DecimalTextBox_PreviewTextInput"
                                                         DataObject.Pasting="DecimalTextBox_Pasting"
                                                         GotKeyboardFocus="DecimalTextBox_GotKeyboardFocus"
                                                         LostKeyboardFocus="DecimalTextBox_LostKeyboardFocus"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Rate (₹)" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Rate, UpdateSourceTrigger=LostFocus, StringFormat=F2}"
                                                         PreviewTextInput="DecimalTextBox_PreviewTextInput"
                                                         DataObject.Pasting="DecimalTextBox_Pasting"
                                                         GotKeyboardFocus="DecimalTextBox_GotKeyboardFocus"
                                                         LostKeyboardFocus="DecimalTextBox_LostKeyboardFocus"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Amount (₹)" Binding="{Binding Amount, StringFormat=N2}" IsReadOnly="True" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </materialDesign:Card>

                </StackPanel>

                <!-- RIGHT: Cash 1 + Cash 2 + Expenses -->
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <!-- Cash 1 (Bank Deposit) -->
                    <materialDesign:Card Padding="20" UniformCornerRadius="12" Margin="0,0,0,12"
                                         materialDesign:ElevationAssist.Elevation="Dp3">
                        <StackPanel>
                            <TextBlock Text="🏦 Cash 1" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesign.Brush.Primary.Light}" Margin="0,0,0,12"/>

                            <!-- ₹500 -->
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Background="#E8F5E9" CornerRadius="4" Padding="6,4" Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="₹500" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBox Grid.Column="1" Margin="0,0,4,0"
                                         Text="{Binding Cash1.Denom500, UpdateSourceTrigger=LostFocus}"
                                         materialDesign:HintAssist.Hint="Qty" materialDesign:HintAssist.IsFloating="True"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         PreviewTextInput="IntegerTextBox_PreviewTextInput"
                                         GotKeyboardFocus="DecimalTextBox_GotKeyboardFocus"
                                         LostKeyboardFocus="IntegerTextBox_LostKeyboardFocus"/>
                                <TextBox Grid.Column="2" IsReadOnly="True" Focusable="False"
                                         Background="#F5F5F5" Foreground="#1B5E20" FontWeight="Bold"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="Amount" materialDesign:HintAssist.IsFloating="True"
                                         Text="{Binding Cash1.Denom500, Converter={StaticResource DenomAmountConv}, ConverterParameter=500, Mode=OneWay, StringFormat=N2}"/>
                            </Grid>

                            <!-- ₹200 -->
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Background="#E8F5E9" CornerRadius="4" Padding="6,4" Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="₹200" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBox Grid.Column="1" Margin="0,0,4,0"
                                         Text="{Binding Cash1.Denom200, UpdateSourceTrigger=LostFocus}"
                                         materialDesign:HintAssist.Hint="Qty" materialDesign:HintAssist.IsFloating="True"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         PreviewTextInput="IntegerTextBox_PreviewTextInput"
                                         GotKeyboardFocus="DecimalTextBox_GotKeyboardFocus"
                                         LostKeyboardFocus="IntegerTextBox_LostKeyboardFocus"/>
                                <TextBox Grid.Column="2" IsReadOnly="True" Focusable="False"
                                         Background="#F5F5F5" Foreground="#1B5E20" FontWeight="Bold"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="Amount" materialDesign:HintAssist.IsFloating="True"
                                         Text="{Binding Cash1.Denom200, Converter={StaticResource DenomAmountConv}, ConverterParameter=200, Mode=OneWay, StringFormat=N2}"/>
                            </Grid>

                            <!-- ₹100 -->
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Background="#E8F5E9" CornerRadius="4" Padding="6,4" Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="₹100" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBox Grid.Column="1" Margin="0,0,4,0"
                                         Text="{Binding Cash1.Denom100, UpdateSourceTrigger=LostFocus}"
                                         materialDesign:HintAssist.Hint="Qty" materialDesign:HintAssist.IsFloating="True"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         PreviewTextInput="IntegerTextBox_PreviewTextInput"
                                         GotKeyboardFocus="DecimalTextBox_GotKeyboardFocus"
                                         LostKeyboardFocus="IntegerTextBox_LostKeyboardFocus"/>
                                <TextBox Grid.Column="2" IsReadOnly="True" Focusable="False"
                                         Background="#F5F5F5" Foreground="#1B5E20" FontWeight="Bold"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="Amount" materialDesign:HintAssist.IsFloating="True"
                                         Text="{Binding Cash1.Denom100, Converter={StaticResource DenomAmountConv}, ConverterParameter=100, Mode=OneWay, StringFormat=N2}"/>
                            </Grid>



                            <!-- Total Cash 1 -->
                            <Border Background="#E8F5E9" CornerRadius="8" Padding="12,8" Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Total Cash 1" FontSize="13" FontWeight="Bold" Foreground="#2E7D32" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" FontSize="16" FontWeight="Bold" Foreground="#1B5E20">
                                        <Run Text="₹"/><Run Text="{Binding Cash1.TotalAmount, Mode=OneWay, StringFormat=N2}"/>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Cash 2 (Cash in Hand) — Denomination Table -->
                    <materialDesign:Card Padding="20" UniformCornerRadius="12" Margin="0,0,0,12"
                                         materialDesign:ElevationAssist.Elevation="Dp3">
                        <StackPanel>
                            <TextBlock Text="💵 Cash in Hand" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesign.Brush.Primary.Light}" Margin="0,0,0,12"/>

                            <!-- Denomination table header -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Denom" FontSize="11" FontWeight="Bold" Foreground="#555" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Qty" FontSize="11" FontWeight="Bold" Foreground="#555" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Amount (₹)" FontSize="11" FontWeight="Bold" Foreground="#555" HorizontalAlignment="Center"/>
                            </Grid>

                            <!-- ₹500 -->
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Background="#E3F2FD" CornerRadius="4" Padding="6,4" Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="₹ 500" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBox Grid.Column="1" Margin="0,0,4,0"
                                         Text="{Binding Cash2.Denom500, UpdateSourceTrigger=LostFocus}"
                                         materialDesign:HintAssist.Hint="Qty" materialDesign:HintAssist.IsFloating="True"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         PreviewTextInput="IntegerTextBox_PreviewTextInput"
                                         GotKeyboardFocus="DecimalTextBox_GotKeyboardFocus"
                                         LostKeyboardFocus="IntegerTextBox_LostKeyboardFocus"/>
                                <TextBox Grid.Column="2" IsReadOnly="True" Focusable="False"
                                         Background="#F5F5F5" Foreground="#1976D2" FontWeight="Bold"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="Amount" materialDesign:HintAssist.IsFloating="True"
                                         Text="{Binding Cash2.Denom500, Converter={StaticResource DenomAmountConv}, ConverterParameter=500, Mode=OneWay}"/>
                            </Grid>

                            <!-- ₹200 -->
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Background="#E3F2FD" CornerRadius="4" Padding="6,4" Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="₹ 200" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBox Grid.Column="1" Margin="0,0,4,0"
                                         Text="{Binding Cash2.Denom200, UpdateSourceTrigger=LostFocus}"
                                         materialDesign:HintAssist.Hint="Qty" materialDesign:HintAssist.IsFloating="True"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         PreviewTextInput="IntegerTextBox_PreviewTextInput"
                                         GotKeyboardFocus="DecimalTextBox_GotKeyboardFocus"
                                         LostKeyboardFocus="IntegerTextBox_LostKeyboardFocus"/>
                                <TextBox Grid.Column="2" IsReadOnly="True" Focusable="False"
                                         Background="#F5F5F5" Foreground="#1976D2" FontWeight="Bold"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="Amount" materialDesign:HintAssist.IsFloating="True"
                                         Text="{Binding Cash2.Denom200, Converter={StaticResource DenomAmountConv}, ConverterParameter=200, Mode=OneWay, StringFormat=N2}"/>
                            </Grid>

                            <!-- ₹100 -->
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Background="#E3F2FD" CornerRadius="4" Padding="6,4" Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="₹ 100" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBox Grid.Column="1" Margin="0,0,4,0"
                                         Text="{Binding Cash2.Denom100, UpdateSourceTrigger=LostFocus}"
                                         materialDesign:HintAssist.Hint="Qty" materialDesign:HintAssist.IsFloating="True"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         PreviewTextInput="IntegerTextBox_PreviewTextInput"
                                         GotKeyboardFocus="DecimalTextBox_GotKeyboardFocus"
                                         LostKeyboardFocus="IntegerTextBox_LostKeyboardFocus"/>
                                <TextBox Grid.Column="2" IsReadOnly="True" Focusable="False"
                                         Background="#F5F5F5" Foreground="#1976D2" FontWeight="Bold"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="Amount" materialDesign:HintAssist.IsFloating="True"
                                         Text="{Binding Cash2.Denom100, Converter={StaticResource DenomAmountConv}, ConverterParameter=100, Mode=OneWay, StringFormat=N2}"/>
                            </Grid>

                            <!-- ₹50 -->
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Background="#E3F2FD" CornerRadius="4" Padding="6,4" Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="₹ 50" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBox Grid.Column="1" Margin="0,0,4,0"
                                         Text="{Binding Cash2.Denom50, UpdateSourceTrigger=LostFocus}"
                                         materialDesign:HintAssist.Hint="Qty" materialDesign:HintAssist.IsFloating="True"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         PreviewTextInput="IntegerTextBox_PreviewTextInput"
                                         GotKeyboardFocus="DecimalTextBox_GotKeyboardFocus"
                                         LostKeyboardFocus="IntegerTextBox_LostKeyboardFocus"/>
                                <TextBox Grid.Column="2" IsReadOnly="True" Focusable="False"
                                         Background="#F5F5F5" Foreground="#1976D2" FontWeight="Bold"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="Amount" materialDesign:HintAssist.IsFloating="True"
                                         Text="{Binding Cash2.Denom50, Converter={StaticResource DenomAmountConv}, ConverterParameter=50, Mode=OneWay, StringFormat=N2}"/>
                            </Grid>

                            <!-- ₹20 -->
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Background="#E3F2FD" CornerRadius="4" Padding="6,4" Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="₹ 20" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBox Grid.Column="1" Margin="0,0,4,0"
                                         Text="{Binding Cash2.Denom20, UpdateSourceTrigger=LostFocus}"
                                         materialDesign:HintAssist.Hint="Qty" materialDesign:HintAssist.IsFloating="True"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         PreviewTextInput="IntegerTextBox_PreviewTextInput"
                                         GotKeyboardFocus="DecimalTextBox_GotKeyboardFocus"
                                         LostKeyboardFocus="IntegerTextBox_LostKeyboardFocus"/>
                                <TextBox Grid.Column="2" IsReadOnly="True" Focusable="False"
                                         Background="#F5F5F5" Foreground="#1976D2" FontWeight="Bold"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="Amount" materialDesign:HintAssist.IsFloating="True"
                                         Text="{Binding Cash2.Denom20, Converter={StaticResource DenomAmountConv}, ConverterParameter=20, Mode=OneWay, StringFormat=N2}"/>
                            </Grid>

                            <!-- ₹10 -->
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Background="#E3F2FD" CornerRadius="4" Padding="6,4" Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="₹ 10" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBox Grid.Column="1" Margin="0,0,4,0"
                                         Text="{Binding Cash2.Denom10, UpdateSourceTrigger=LostFocus}"
                                         materialDesign:HintAssist.Hint="Qty" materialDesign:HintAssist.IsFloating="True"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         PreviewTextInput="IntegerTextBox_PreviewTextInput"
                                         GotKeyboardFocus="DecimalTextBox_GotKeyboardFocus"
                                         LostKeyboardFocus="IntegerTextBox_LostKeyboardFocus"/>
                                <TextBox Grid.Column="2" IsReadOnly="True" Focusable="False"
                                         Background="#F5F5F5" Foreground="#1976D2" FontWeight="Bold"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="Amount" materialDesign:HintAssist.IsFloating="True"
                                         Text="{Binding Cash2.Denom10, Converter={StaticResource DenomAmountConv}, ConverterParameter=10, Mode=OneWay, StringFormat=N2}"/>
                            </Grid>

                            <!-- Coins — direct amount entry -->
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Background="#FFF9C4" CornerRadius="4" Padding="6,4" Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="Coins" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="(direct ₹ value)" FontSize="11" Foreground="#777"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBox Grid.Column="2"
                                         Text="{Binding Cash2.Coins, UpdateSourceTrigger=LostFocus, StringFormat=F2}"
                                         materialDesign:HintAssist.Hint="Coin Amount" materialDesign:HintAssist.IsFloating="True"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         PreviewTextInput="DecimalTextBox_PreviewTextInput"
                                         GotKeyboardFocus="DecimalTextBox_GotKeyboardFocus"
                                         LostKeyboardFocus="DecimalTextBox_LostKeyboardFocus"/>
                            </Grid>

                            <!-- Total Cash in Hand -->
                            <Border Background="#E8F5E9" CornerRadius="8" Padding="12,8" Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Total Cash in Hand" FontSize="13" FontWeight="Bold" Foreground="#2E7D32" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" FontSize="16" FontWeight="Bold" Foreground="#1B5E20">
                                        <Run Text="₹"/><Run Text="{Binding Cash2.TotalAmount, Mode=OneWay, StringFormat=N2}"/>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Expenses Section (moved below Cash In Hand) -->
                    <materialDesign:Card Padding="20" UniformCornerRadius="12"
                                         materialDesign:ElevationAssist.Elevation="Dp3">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="💰 Expenses" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MaterialDesign.Brush.Primary.Light}"/>
                                <Button Content="+ Add" Margin="16,0,0,0"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Command="{Binding AddExpenseCommand}" Height="28" FontSize="12"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Expenses}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                                                     materialDesign:HintAssist.Hint="Description"
                                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                            <TextBox Grid.Column="1" Text="{Binding Amount, UpdateSourceTrigger=LostFocus, StringFormat=F2}" Margin="0,0,8,0"
                                                     materialDesign:HintAssist.Hint="Amount"
                                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                     PreviewTextInput="DecimalTextBox_PreviewTextInput"
                                                     GotKeyboardFocus="DecimalTextBox_GotKeyboardFocus"
                                                     LostKeyboardFocus="DecimalTextBox_LostKeyboardFocus"/>
                                            <Button Grid.Column="2" Style="{StaticResource MaterialDesignIconButton}"
                                                    Command="{Binding DataContext.RemoveExpenseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="Delete" Foreground="#F44336"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Khandhare Petroleum Ledger Section (Drawings & Expenses) -->
                    <materialDesign:Card Padding="20" UniformCornerRadius="12" Margin="0,16,0,0"
                                         materialDesign:ElevationAssist.Elevation="Dp3">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="🏛️ Kandhare Petroleum" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MaterialDesign.Brush.Primary.Light}"/>
                                <Button Content="+ Add" Margin="16,0,0,0"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Command="{Binding AddKhandharePetroleumEntryCommand}" Height="28" FontSize="12"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding KhandharePetroleumEntries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                                                     materialDesign:HintAssist.Hint="Name / Person"
                                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                            <TextBox Grid.Column="1" Text="{Binding SlipNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                                                     materialDesign:HintAssist.Hint="Slip No"
                                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                            <TextBox Grid.Column="2" Text="{Binding Amount, UpdateSourceTrigger=LostFocus, StringFormat=F2}" Margin="0,0,8,0"
                                                     materialDesign:HintAssist.Hint="Amount"
                                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                     PreviewTextInput="DecimalTextBox_PreviewTextInput"
                                                     GotKeyboardFocus="DecimalTextBox_GotKeyboardFocus"
                                                     LostKeyboardFocus="DecimalTextBox_LostKeyboardFocus"/>
                                            <Button Grid.Column="3" Style="{StaticResource MaterialDesignIconButton}"
                                                    Command="{Binding DataContext.RemoveKhandharePetroleumEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="Delete" Foreground="#F44336"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </materialDesign:Card>
                </StackPanel>
            </Grid>

            <!-- RECONCILIATION -->
            <materialDesign:Card Padding="24" UniformCornerRadius="12" Margin="0,0,0,20"
                                 materialDesign:ElevationAssist.Elevation="Dp4">
                <StackPanel>
                    <TextBlock Text="📊 Reconciliation" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource MaterialDesign.Brush.Primary.Light}" Margin="0,0,0,16"/>
                    <UniformGrid Columns="5">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Gross Sales" Opacity="0.6" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding GrossSales, StringFormat='₹{0:N2}'}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Total In (Direct)" Opacity="0.6" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalPaymentIn, StringFormat='₹{0:N2}'}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Debtors" Opacity="0.6" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalDebtors, StringFormat='₹{0:N2}'}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Total Collection" Opacity="0.6" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding FinalAdjusted, StringFormat='₹{0:N2}'}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Mismatch" Opacity="0.6" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Difference, StringFormat='₹{0:N2}'}" FontSize="22" FontWeight="Bold"
                                       Foreground="{Binding Difference, Converter={StaticResource DiffColorConv}}" HorizontalAlignment="Center"
                                       ToolTip="Mismatch = Total Collection - Gross Sales. Total Collection includes direct payments, debtors, testing, and expenses."/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </materialDesign:Card>

            <!-- ACTION BUTTONS + STATUS -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="💾 Save DSM Entry" Height="44" Padding="24,0"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Command="{Binding SaveEntryCommand}"
                        IsEnabled="{Binding CanSaveCurrentEntry}"
                        Margin="0,0,12,0"/>
                <Button Grid.Column="1" Content="🔄 Clear Form" Height="44" Padding="24,0"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Command="{Binding ClearFormCommand}" Margin="0,0,12,0"/>
                <Button Grid.Column="2" Content="📋 View Shift Entries" Height="44" Padding="24,0"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Command="{Binding LoadShiftEntriesCommand}" Margin="0,0,12,0"/>
                <Button Grid.Column="3" Content="🖨️ Print DSM Sheet" Height="44" Padding="20,0"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Command="{Binding PrintDsmCommand}" Margin="0,0,12,0"/>
                <TextBlock Grid.Column="5" Text="{Binding StatusMessage}" FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>

            <!-- Shift Entries List -->
            <materialDesign:Card Padding="20" UniformCornerRadius="12"
                                 materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Shift Entries" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MaterialDesign.Brush.Primary.Light}"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="🖨️ Print Shift Summary" Height="34" Padding="16,0"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding PrintShiftSummaryCommand}" FontSize="12"/>
                    </Grid>
                    <DataGrid ItemsSource="{Binding ShiftEntries}" IsReadOnly="True"
                              HeadersVisibility="Column"
                              PreviewMouseWheel="DataGrid_PreviewMouseWheel">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding SequenceDisplay}" Width="50"/>
                            <DataGridTextColumn Header="DSM Name" Binding="{Binding DsmName}" Width="*"/>
                            <DataGridTextColumn Header="Pump" Binding="{Binding PumpDisplay}" Width="160"/>

                            <DataGridTextColumn Header="Gross Sales" Binding="{Binding GrossSales, StringFormat=N2}" Width="140"/>
                            <DataGridTextColumn Header="Total Collection" Binding="{Binding TotalPaymentIn, StringFormat=N2}" Width="140"/>
                            <DataGridTextColumn Header="Mismatch" Binding="{Binding Difference, StringFormat=N2}" Width="120"/>
                            <DataGridTemplateColumn Header="Action" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✏️ Edit" Height="28" FontSize="11" Padding="8,0"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Command="{Binding DataContext.EditEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding DsmEntryId}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </materialDesign:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
