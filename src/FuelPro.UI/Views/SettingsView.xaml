<UserControl x:Class="FuelPro.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:views="clr-namespace:FuelPro.UI.Views">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24">
        <StackPanel MaxWidth="800">
            <TextBlock Text="Settings" FontSize="28" FontWeight="Bold"
                       Foreground="{DynamicResource MaterialDesign.Brush.Primary}" Margin="0,0,0,24"/>

            <!-- Station Settings -->
            <materialDesign:Card Padding="24" UniformCornerRadius="12" Margin="0,0,0,20"
                                 materialDesign:ElevationAssist.Elevation="Dp3">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <materialDesign:PackIcon Kind="GasStation" Width="24" Height="24"
                                                 Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                        <TextBlock Text="Station &amp; Fuel Rates" FontSize="18" FontWeight="SemiBold" Margin="8,0"
                                   Foreground="{DynamicResource MaterialDesign.Brush.Primary.Light}"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding PumpStationName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                                 materialDesign:HintAssist.Hint="Station Display Name" materialDesign:HintAssist.IsFloating="True"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="15"/>
                        <TextBox Grid.Column="1" Text="{Binding StationSubtitle, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0"
                                 materialDesign:HintAssist.Hint="Station Subtitle / Group Name" materialDesign:HintAssist.IsFloating="True"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="15"/>
                    </Grid>

                    <TextBox Text="{Binding StationAddress, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"
                             materialDesign:HintAssist.Hint="Station Address (for official prints &amp; ledgers)" materialDesign:HintAssist.IsFloating="True"
                             TextWrapping="Wrap" AcceptsReturn="True" MinHeight="56"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="14"/>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding StationContact, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                                 materialDesign:HintAssist.Hint="Contact Phone / Email" materialDesign:HintAssist.IsFloating="True"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="14"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding OilCompanies}" SelectedItem="{Binding OilCompany}" Margin="4,0,8,0"
                                  materialDesign:HintAssist.Hint="Oil Company Brand" materialDesign:HintAssist.IsFloating="True"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}" FontSize="14"/>
                        <Button Grid.Column="2" Command="{Binding BrowseCustomLogoCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                Height="48" Padding="12,0" ToolTip="Select Custom Logo Image (optional)">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ImageOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Custom Logo" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Dynamic Fuel Rates configured from Dev Side -->
                    <ItemsControl ItemsSource="{Binding FuelRateItems}" Margin="0,0,0,12">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding RateText, UpdateSourceTrigger=PropertyChanged}"
                                         Width="210" Margin="0,0,16,12"
                                         materialDesign:HintAssist.Hint="{Binding HintText}"
                                         materialDesign:HintAssist.IsFloating="True"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         FontSize="15"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Shift Managers Assignment -->
                    <TextBlock Text="Shift Managers Assignment" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,8" Opacity="0.8"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding Shift1Manager, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                                 materialDesign:HintAssist.Hint="Shift A Manager Name" materialDesign:HintAssist.IsFloating="True"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="15"/>
                        <TextBox Grid.Column="1" Text="{Binding Shift2Manager, UpdateSourceTrigger=PropertyChanged}" Margin="4,0,4,0"
                                 materialDesign:HintAssist.Hint="Shift B Manager Name" materialDesign:HintAssist.IsFloating="True"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="15"/>
                        <TextBox Grid.Column="2" Text="{Binding Shift3Manager, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0"
                                 materialDesign:HintAssist.Hint="Shift C Manager Name (Optional)" materialDesign:HintAssist.IsFloating="True"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="15"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Save Settings" Command="{Binding SaveSettingsCommand}" Height="40" Padding="24,0"
                                Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,16,0"/>
                        <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" FontSize="14"/>
                    </StackPanel>

                    <TextBlock Text="{Binding LastUpdated, StringFormat='Last updated: {0}'}" Opacity="0.5"
                               FontSize="12" Margin="0,12,0,0"/>
                </StackPanel>
            </materialDesign:Card>



            <!-- DSM Profile Management Card -->
            <materialDesign:Card Margin="0,0,0,24" Padding="24" UniformCornerRadius="16" Background="White" materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <materialDesign:PackIcon Kind="AccountTie" Width="24" Height="24"
                                                 Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                        <TextBlock Text="DSM &amp; Staff Management" FontSize="18" FontWeight="SemiBold" Margin="8,0"
                                   Foreground="{DynamicResource MaterialDesign.Brush.Primary.Light}"/>
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding DsmProfiles}" IsReadOnly="True" Margin="0,0,0,16"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" MaxHeight="250" FontSize="13" GridLinesVisibility="Horizontal"
                              materialDesign:DataGridAssist.CellPadding="12 8"
                              materialDesign:DataGridAssist.ColumnHeaderPadding="12 8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DSM Name" Binding="{Binding DsmName}" Width="*"/>
                            <DataGridTextColumn Header="Mobile" Binding="{Binding MobileNumber}" Width="130"/>
                            <DataGridTextColumn Header="Salary Model" Binding="{Binding SalaryType}" Width="120"/>
                            <DataGridTextColumn Header="Base Salary (₹)" Binding="{Binding BaseSalary, StringFormat=F2}" Width="120"/>
                            <DataGridTemplateColumn Header="Status" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.ToggleDsmActiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}" Height="26" Padding="8,0" FontSize="11">
                                            <TextBlock Text="Active" Foreground="Green"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource MaterialDesignIconButton}" Height="28" Width="28"
                                                Command="{Binding DataContext.EditDsmCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Edit DSM Name">
                                            <materialDesign:PackIcon Kind="Pencil" Width="16" Height="16" Foreground="#1565C0"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource MaterialDesignIconButton}" Height="28" Width="28"
                                                Command="{Binding DataContext.DeleteDsmCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Delete DSM Profile">
                                            <materialDesign:PackIcon Kind="Delete" Width="16" Height="16" Foreground="#F44336"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Visibility="{Binding IsEditingDsm, Converter={StaticResource BoolToVisConverter}}"
                            Background="#F5F8FF" BorderBrush="#D6E3FF" BorderThickness="1"
                            CornerRadius="8" Padding="12" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Edit DSM Name" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Text="{Binding EditingDsmName, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="DSM Name (Required)"
                                         materialDesign:HintAssist.IsFloating="True"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Width="320" Margin="0,0,10,0"/>
                                <Button Content="Save Name" Command="{Binding SaveDsmEditCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Height="40" Padding="18,0"/>
                                <Button Content="Cancel" Command="{Binding CancelDsmEditCommand}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Height="40" Padding="18,0" Margin="6,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Add New DSM Profile" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" Opacity="0.7"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding NewDsmName, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="DSM Name (Required)" materialDesign:HintAssist.IsFloating="True"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                        <TextBox Grid.Column="2" Text="{Binding NewDsmPhone, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Phone Number" materialDesign:HintAssist.IsFloating="True"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                        <ComboBox Grid.Column="4" ItemsSource="{Binding DsmSalaryTypeOptions}" SelectedItem="{Binding NewDsmSalaryType}"
                                  materialDesign:HintAssist.Hint="Salary Type" materialDesign:HintAssist.IsFloating="True"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                        <TextBox Grid.Column="6" Text="{Binding NewDsmBaseSalary, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Base Rate (₹)" materialDesign:HintAssist.IsFloating="True"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="+ Add DSM" Command="{Binding AddDsmCommand}" Height="40" Padding="24,0"
                                Style="{StaticResource MaterialDesignRaisedButton}" HorizontalAlignment="Left" Margin="0,0,16,0"/>
                        <TextBlock Text="{Binding DsmStatusMessage}" VerticalAlignment="Center" FontSize="14"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>

            <!-- Creditor Management Card -->
            <materialDesign:Card Margin="0,0,0,24" Padding="24" UniformCornerRadius="16" Background="White" materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <materialDesign:PackIcon Kind="AccountMultiple" Width="24" Height="24"
                                                 Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                        <TextBlock Text="Debtor Management" FontSize="18" FontWeight="SemiBold" Margin="8,0"
                                   Foreground="{DynamicResource MaterialDesign.Brush.Primary.Light}"/>
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding Creditors}" SelectedItem="{Binding SelectedCreditor}" IsReadOnly="True" Margin="0,0,0,16"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" MaxHeight="250" FontSize="13" GridLinesVisibility="Horizontal"
                              materialDesign:DataGridAssist.CellPadding="12 8"
                              materialDesign:DataGridAssist.ColumnHeaderPadding="12 8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Debtor Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Cheque No." Binding="{Binding Phone}" Width="120"/>
                            <DataGridTemplateColumn Header="" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource MaterialDesignIconButton}" Height="28" Width="28"
                                                Command="{Binding DataContext.DeleteCreditorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Delete Debtor (will be hidden from dropdowns)">
                                            <materialDesign:PackIcon Kind="Delete" Width="16" Height="16" Foreground="#F44336"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="Add New Debtor" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" Opacity="0.7"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding NewCreditorName, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Debtor Name (Required)" materialDesign:HintAssist.IsFloating="True"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                        <TextBox Grid.Column="2" Text="{Binding NewCreditorVehicleNumber, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Vehicle No. (Optional)" materialDesign:HintAssist.IsFloating="True"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Add Debtor" Command="{Binding AddCreditorCommand}" Height="40" Padding="24,0"
                                Style="{StaticResource MaterialDesignRaisedButton}" HorizontalAlignment="Left" Margin="0,0,16,0"/>
                        <TextBlock Text="{Binding CreditorStatusMessage}" VerticalAlignment="Center" FontSize="14"/>
                    </StackPanel>

                    <!-- Selected Debtor's Vehicles Section -->
                    <StackPanel Visibility="{Binding IsCreditorSelected, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,24,0,0">
                        <Separator Margin="0,0,0,16"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <materialDesign:PackIcon Kind="Car" Width="20" Height="20" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SelectedCreditor.Name, StringFormat='Manage Vehicles for {0}'}" FontSize="16" FontWeight="SemiBold" Margin="8,0" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                        </StackPanel>

                        <!-- DataGrid of Vehicles -->
                        <DataGrid ItemsSource="{Binding SelectedCreditorVehicles}" IsReadOnly="True" Margin="0,0,0,12"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column" MaxHeight="150" FontSize="13" GridLinesVisibility="Horizontal"
                                  materialDesign:DataGridAssist.CellPadding="8 6"
                                  materialDesign:DataGridAssist.ColumnHeaderPadding="8 6">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Vehicle Number" Binding="{Binding VehicleNumber}" Width="*"/>
                                <DataGridTemplateColumn Header="" Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource MaterialDesignIconButton}" Height="24" Width="24"
                                                    Command="{Binding DataContext.DeleteVehicleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Delete Vehicle">
                                                <materialDesign:PackIcon Kind="Delete" Width="14" Height="14" Foreground="#F44336"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="Add New Vehicle" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" Opacity="0.7"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding NewVehicleNumber, UpdateSourceTrigger=PropertyChanged}" Width="200"
                                     materialDesign:HintAssist.Hint="Vehicle Number" materialDesign:HintAssist.IsFloating="True"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,12,0"/>
                            <Button Content="Add Vehicle" Command="{Binding AddVehicleCommand}" Height="40" Padding="16,0"
                                    Style="{StaticResource MaterialDesignRaisedButton}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>

            <!-- Historical Opening Balances Card -->
            <materialDesign:Card Margin="0,0,0,24" Padding="24" UniformCornerRadius="16" Background="White" materialDesign:ElevationAssist.Elevation="Dp2">
                <views:OpeningBalanceManagementView DataContext="{Binding OpeningBalanceVm}" />
            </materialDesign:Card>

            <!-- Multi-Computer Network & Cloud Synchronization Card -->
            <materialDesign:Card Margin="0,0,0,24" Padding="24" UniformCornerRadius="16" Background="White" materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <materialDesign:PackIcon Kind="CloudSync" Width="24" Height="24"
                                                 Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                        <TextBlock Text="Multi-Computer Access &amp; Cloud Synchronization" FontSize="18" FontWeight="SemiBold" Margin="8,0"
                                   Foreground="{DynamicResource MaterialDesign.Brush.Primary.Light}"/>
                    </StackPanel>

                    <!-- Cloud Connection Settings -->
                    <TextBlock Text="Cloud Connection (Supabase)" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" Opacity="0.8"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding SyncStationId, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Station ID" materialDesign:HintAssist.IsFloating="True"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="14" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Command="{Binding CopyStationIdCommand}" Height="48" Style="{StaticResource MaterialDesignOutlinedButton}" ToolTip="Copy Station ID">
                            <materialDesign:PackIcon Kind="ContentCopy" Width="18" Height="18"/>
                        </Button>
                    </Grid>

                    <TextBox Text="{Binding SupabaseUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"
                             materialDesign:HintAssist.Hint="Supabase Project URL" materialDesign:HintAssist.IsFloating="True"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="14"/>

                    <TextBox Text="{Binding SupabaseApiKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"
                             materialDesign:HintAssist.Hint="Supabase API Key (Protected via Windows DPAPI)" materialDesign:HintAssist.IsFloating="True"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="14"/>

                    <CheckBox IsChecked="{Binding SyncEnabled}" Content="Enable Cloud Synchronization" Margin="0,0,0,12" FontSize="14"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button Content="Save Cloud Settings" Command="{Binding SaveSyncSettingsCommand}" Height="40" Padding="20,0"
                                Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,12,0"/>
                        <Button Content="Sync Now" Command="{Binding ForceSyncCommand}" Height="40" Padding="20,0"
                                Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,16,0"/>
                        <TextBlock Text="{Binding LastSyncTimeDisplay, StringFormat='Last Synced: {0}'}" VerticalAlignment="Center" Opacity="0.6" FontSize="13" Margin="0,0,16,0"/>
                        <TextBlock Text="{Binding SyncStatusMessage}" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>

                    <Separator Margin="0,8,0,20"/>

                    <!-- Multi-Computer Network Access -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <materialDesign:PackIcon Kind="Laptop" Width="22" Height="22"
                                                 Foreground="{DynamicResource MaterialDesign.Brush.Primary}" VerticalAlignment="Center"/>
                        <TextBlock Text="Multi-Computer Operation (1–3 PCs)" FontSize="16" FontWeight="SemiBold" Margin="8,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                    </StackPanel>

                    <CheckBox IsChecked="{Binding IsMultiComputerEnabled}" Content="Enable Multi-Computer Network Mode" Margin="0,0,0,4" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="Enables multiple Admin/Manager PCs at the station to access and update operational data simultaneously with independent local SQLite storage and cloud reconciliation."
                               TextWrapping="Wrap" Opacity="0.7" FontSize="12" Margin="0,0,0,16"/>

                    <!-- Multi-Computer Configuration Section -->
                    <StackPanel Visibility="{Binding IsMultiComputerEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <!-- Machine Identification -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding SyncMachineId, Mode=OneWay}" IsReadOnly="True"
                                     materialDesign:HintAssist.Hint="This Computer Machine ID" materialDesign:HintAssist.IsFloating="True"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="13"/>
                            <TextBox Grid.Column="2" Text="{Binding DeviceFriendlyName, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Computer Display Name (e.g. Office PC 1)" materialDesign:HintAssist.IsFloating="True"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="13"/>
                        </Grid>

                        <!-- Pairing Actions: Generate or Redeem -->
                        <Border Background="#F5F7FA" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Primary PC: Generate Code -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Primary PC: Authorize New Computer" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
                                    <TextBlock Text="Generate a temporary 15-minute pairing code to authorize an additional manager computer."
                                               TextWrapping="Wrap" Opacity="0.7" FontSize="12" Margin="0,0,0,12"/>
                                    <Button Content="Generate Pairing Code" Command="{Binding GeneratePairingCodeCommand}"
                                            Height="40" Style="{StaticResource MaterialDesignRaisedButton}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasPairingCode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding PairingCodeDisplay}" FontFamily="Consolas" FontSize="18" FontWeight="Bold" Foreground="#1976D2"/>
                                        </Border>
                                        <Button Command="{Binding CopyPairingCodeCommand}" Height="36" Style="{StaticResource MaterialDesignOutlinedButton}" ToolTip="Copy Code">
                                            <materialDesign:PackIcon Kind="ContentCopy" Width="16" Height="16"/>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Secondary PC: Enter Code -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Secondary PC: Connect to Station" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
                                    <TextBlock Text="Enter the pairing code generated by the Primary PC to link this workstation."
                                               TextWrapping="Wrap" Opacity="0.7" FontSize="12" Margin="0,0,0,12"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding PairingCodeInput, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="Pairing Code (PYRO-XXXX-XXXX)" materialDesign:HintAssist.IsFloating="True"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="14"/>
                                        <Button Grid.Column="2" Content="Connect &amp; Pair" Command="{Binding RedeemPairingCodeCommand}"
                                                Height="48" Style="{StaticResource MaterialDesignRaisedButton}"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="{Binding MultiComputerStatusMessage}" Margin="0,0,0,12" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>

                        <!-- Registered Workstations DataGrid -->
                        <StackPanel Margin="0,8,0,0">
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Authorized Station Workstations" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Content="Refresh List" Command="{Binding RefreshDevicesCommand}"
                                        HorizontalAlignment="Right" Height="32" Padding="12,0" Style="{StaticResource MaterialDesignOutlinedButton}"/>
                            </Grid>

                            <DataGrid ItemsSource="{Binding StationDevices}" SelectedItem="{Binding SelectedDevice}"
                                      IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                      HeadersVisibility="Column" MaxHeight="200" FontSize="13" GridLinesVisibility="Horizontal"
                                      materialDesign:DataGridAssist.CellPadding="10 6"
                                      materialDesign:DataGridAssist.ColumnHeaderPadding="10 6">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Computer Name" Binding="{Binding MachineName}" Width="*"/>
                                    <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="100"/>
                                    <DataGridTextColumn Header="Paired Date" Binding="{Binding PairedAt, StringFormat='{}{0:dd MMM yyyy}'}" Width="120"/>
                                    <DataGridTextColumn Header="Last Seen" Binding="{Binding LastSeen, StringFormat='{}{0:dd MMM yyyy HH:mm}'}" Width="140"/>
                                    <DataGridCheckBoxColumn Header="Authorized" Binding="{Binding IsAuthorized}" Width="90"/>
                                    <DataGridTemplateColumn Header="Action" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource MaterialDesignIconButton}" Height="28" Width="28"
                                                        Command="{Binding DataContext.RevokeDeviceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" ToolTip="Revoke Access">
                                                    <materialDesign:PackIcon Kind="AccountRemove" Width="16" Height="16" Foreground="#F44336"/>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>

        </StackPanel>
    </ScrollViewer>
</UserControl>
