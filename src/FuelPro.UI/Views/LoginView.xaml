<Window x:Class="FuelPro.UI.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="PyroSync — Login"
        Width="480" Height="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesign.Brush.Primary.Light}"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        Icon="pack://application:,,,/Resources/fuel-pump-icon.ico">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <materialDesign:Card Grid.Row="0" Margin="40,60,40,20"
                             Padding="32"
                             materialDesign:ElevationAssist.Elevation="Dp8"
                             UniformCornerRadius="16">
            <StackPanel VerticalAlignment="Center">
                <!-- Logo -->
                <Image Source="{Binding LogoSource}" Width="110" Height="110"
                       HorizontalAlignment="Center" Margin="0,0,0,12"/>

                <TextBlock Text="PyroSync" FontSize="28" FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>

                <TextBlock Text="Petrol Pump Management System" FontSize="12"
                           HorizontalAlignment="Center" Opacity="0.6" Margin="0,4,0,32"/>

                <!-- Username -->
                <TextBox x:Name="UsernameBox"
                         materialDesign:HintAssist.Hint="Username"
                         materialDesign:HintAssist.IsFloating="True"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="16" Margin="0,0,0,16"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         TabIndex="0"/>

                <!-- PIN -->
                <PasswordBox x:Name="PinBox"
                             materialDesign:HintAssist.Hint="PIN"
                             materialDesign:HintAssist.IsFloating="True"
                             FontSize="16" Margin="0,0,0,24"
                             Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                             TabIndex="1"/>

                <!-- Error message -->
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#F44336"
                           FontSize="13" HorizontalAlignment="Center"
                           Margin="0,0,0,16"/>

                <!-- Login Button -->
                <Button Content="LOGIN" FontSize="16" Height="48"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        materialDesign:RippleAssist.IsDisabled="False"
                        Command="{Binding LoginCommand}"
                        IsDefault="True" TabIndex="2"
                        HorizontalAlignment="Stretch"/>

                <ProgressBar IsIndeterminate="{Binding IsLoading}"
                             Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                             Margin="0,16,0,0"
                             Style="{StaticResource MaterialDesignLinearProgressBar}"/>
            </StackPanel>
        </materialDesign:Card>

        <TextBlock Grid.Row="1" Text="Default: Admin / 1234"
                   FontSize="11" Opacity="0.4" HorizontalAlignment="Center" Margin="0,0,0,20"/>
    </Grid>
</Window>
