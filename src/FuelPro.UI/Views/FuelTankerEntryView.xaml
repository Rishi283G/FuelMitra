<UserControl x:Class="FuelPro.UI.Views.FuelTankerEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:FuelPro.UI.Converters">
    <UserControl.Resources>
        <converters:IndianCurrencyConverter x:Key="CurrencyConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="Foreground" Value="#212121"/>
            <Setter Property="materialDesign:HintAssist.IsFloating" Value="True"/>
        </Style>
        <Style TargetType="DatePicker" BasedOn="{StaticResource MaterialDesignOutlinedDatePicker}">
            <Setter Property="Foreground" Value="#212121"/>
            <Setter Property="materialDesign:HintAssist.IsFloating" Value="True"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
            <Setter Property="Foreground" Value="#212121"/>
            <Setter Property="materialDesign:HintAssist.IsFloating" Value="True"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Date Filters + Print -->
            <RowDefinition Height="*"/>
            <!-- Content -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <materialDesign:PackIcon Kind="TruckDelivery" Width="28" Height="28" Foreground="#00796B" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="Fuel Tanker Purchases" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Date Filters + Print -->
        <materialDesign:Card Grid.Row="1" Margin="0,4,0,16" Padding="14" UniformCornerRadius="8"
                             materialDesign:ElevationAssist.Elevation="Dp1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Today" Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding SetPresetCommand}" CommandParameter="Today" Margin="0,0,6,0" Height="40"/>
                    <Button Content="Yesterday" Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding SetPresetCommand}" CommandParameter="Yesterday" Margin="0,0,6,0" Height="40"/>
                    <Button Content="Weekly" Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding SetPresetCommand}" CommandParameter="Weekly" Margin="0,0,6,0" Height="40"/>
                    <Button Content="Monthly" Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding SetPresetCommand}" CommandParameter="Monthly" Margin="0,0,6,0" Height="40"/>
                    <Button Content="Prev. Month" Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding SetPresetCommand}" CommandParameter="PreviousMonth" Margin="0,0,16,0" Height="40"/>

                    <DatePicker SelectedDate="{Binding StartDate}" materialDesign:HintAssist.Hint="From"
                                Width="140" Height="48" Margin="0,0,8,0"/>
                    <DatePicker SelectedDate="{Binding EndDate}" materialDesign:HintAssist.Hint="To"
                                Width="140" Height="48"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{Binding ExportExcelCommand}"
                            Background="#1565C0" BorderBrush="#1565C0"
                            Height="40" Padding="16,0" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileExcel" Width="18" Height="18" Margin="0,0,6,0"/>
                            <TextBlock Text="Export Excel" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{Binding PrintCommand}"
                            Background="#00695C" BorderBrush="#00695C"
                            Height="40" Padding="16,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Printer" Width="18" Height="18" Margin="0,0,6,0"/>
                            <TextBlock Text="Print" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <!-- Loading bar -->
        <ProgressBar Grid.Row="1" VerticalAlignment="Bottom" IsIndeterminate="{Binding IsLoading}"
                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                     Style="{StaticResource MaterialDesignLinearProgressBar}" Margin="0,0,0,-8"/>

        <!-- Main Content (2 Columns) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: List of logged tankers -->
            <materialDesign:Card Grid.Column="0" Margin="0,0,16,0" Padding="16" UniformCornerRadius="10" materialDesign:ElevationAssist.Elevation="Dp1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Purchase History" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Tankers}" SelectedItem="{Binding SelectedTanker}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              Background="Transparent" GridLinesVisibility="Horizontal"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding TankerDate, StringFormat=dd-MMM-yyyy}" Width="100"/>
                            <DataGridTextColumn Header="Invoice No" Binding="{Binding InvoiceNumber}" Width="110"/>
                            <DataGridTextColumn Header="Fuel Type" Binding="{Binding FuelType}" Width="90"/>
                            <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity, StringFormat='{}{0:N2}'}" Width="100"/>
                            <DataGridTextColumn Header="Rate (₹)" Binding="{Binding PurchaseRate, StringFormat='{}{0:N2}'}" Width="80"/>
                            <DataGridTextColumn Header="Total Amount" Binding="{Binding TotalAmount, Converter={StaticResource CurrencyConverter}}" Width="110"/>
                            <DataGridTextColumn Header="Density" Binding="{Binding Density, StringFormat='{}{0:N4}'}" Width="80"/>
                            <DataGridTextColumn Header="Vehicle No" Binding="{Binding TankerNumber}" Width="100"/>
                            <DataGridTemplateColumn Header="Action" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Edit" Style="{StaticResource MaterialDesignFlatButton}"
                                                Command="{Binding DataContext.EditTankerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Height="26" Padding="6,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </materialDesign:Card>

            <!-- Right: Input Form Card -->
            <materialDesign:Card Grid.Column="1" Padding="20" UniformCornerRadius="10" materialDesign:ElevationAssist.Elevation="Dp1" VerticalAlignment="Top">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="650">
                    <StackPanel>
                        <!-- Form Title -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <materialDesign:PackIcon Kind="PlusCircle" Width="22" Height="22" Foreground="#1565C0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding FormTitle}"
                                       FontSize="16" FontWeight="Bold" Foreground="#1565C0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Form Fields -->
                        <DatePicker SelectedDate="{Binding TankerDate}" materialDesign:HintAssist.Hint="Purchase Date"
                                    Margin="0,0,0,14" Height="48"/>

                        <ComboBox ItemsSource="{Binding FuelTypes}" SelectedItem="{Binding FuelType}"
                                  materialDesign:HintAssist.Hint="Fuel Type"
                                  Margin="0,0,0,14" Height="48"/>

                        <TextBox Text="{Binding InvoiceNumber, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Invoice Number"
                                 materialDesign:HintAssist.HelperText="e.g. INV/2026/104"
                                 Margin="0,0,0,14" Height="48"/>

                        <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                 materialDesign:HintAssist.Hint="Quantity (Litres/Kg)"
                                 materialDesign:HintAssist.HelperText="e.g. 12000"
                                 Margin="0,0,0,14" Height="48"/>

                        <TextBox Text="{Binding PurchaseRate, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                 materialDesign:HintAssist.Hint="Purchase Rate (₹ per Litre/Kg)"
                                 materialDesign:HintAssist.HelperText="e.g. 88.50"
                                 Margin="0,0,0,14" Height="48"/>

                        <TextBox Text="{Binding TotalAmount, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"
                                 materialDesign:HintAssist.Hint="Total Amount" IsReadOnly="True"
                                 Margin="0,0,0,14" Height="48" Background="#F5F5F5"/>

                        <TextBox Text="{Binding Density, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                 materialDesign:HintAssist.Hint="Density (e.g. 0.7450)"
                                 materialDesign:HintAssist.HelperText="e.g. 0.7450"
                                 Margin="0,0,0,14" Height="48"/>

                        <TextBox Text="{Binding TankerNumber, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Tanker Vehicle Number (Optional)"
                                 materialDesign:HintAssist.HelperText="e.g. MH-12-PQ-9876"
                                 Margin="0,0,0,14" Height="48"/>

                        <TextBox Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Remarks (Optional)"
                                 materialDesign:HintAssist.HelperText="e.g. Received in good condition"
                                 Margin="0,0,0,18" Height="48"/>

                        <!-- Action Buttons -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="Save" Command="{Binding SaveCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,4,0" Height="40" Background="#1565C0"/>

                            <Button Grid.Column="1" Content="Clear" Command="{Binding ClearFormCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" Margin="4,0,0,0" Height="40"/>
                        </Grid>

                        <Button Content="Delete Entry" Command="{Binding DeleteCommand}"
                                Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisConverter}}"
                                Style="{StaticResource MaterialDesignFlatButton}" Margin="0,8,0,0" Height="40" Foreground="#C62828"/>
                    </StackPanel>
                </ScrollViewer>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
