<UserControl x:Class="FuelPro.UI.Views.PumpExpensesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:FuelPro.UI.Converters"
             xmlns:viewmodels="clr-namespace:FuelPro.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:PumpExpensesViewModel}">
    <UserControl.Resources>
        <converters:IndianCurrencyConverter x:Key="CurrencyConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        
        <Style TargetType="materialDesign:Card" x:Key="SectionCard">
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Surface}" />
            <Setter Property="UniformCornerRadius" Value="8" />
        </Style>

        <Style TargetType="TextBlock" x:Key="SectionTitle">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="materialDesign:HintAssist.IsFloating" Value="True" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource MaterialDesign.Brush.Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header Card -->
        <materialDesign:Card Grid.Row="0" Margin="16" Padding="16" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CashRegister" Width="28" Height="28" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" Margin="0,0,10,0"/>
                    <TextBlock Text="Expenses Management" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Summary Badges in Header -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Daily Pump Expenses -->
                    <Border Background="#FFF3E0" CornerRadius="12" Padding="12,6" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Pump Exp: " FontWeight="SemiBold" Foreground="#E65100" FontSize="13"/>
                            <TextBlock Text="{Binding TotalPumpExpensesAmount, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" Foreground="#E65100" FontSize="13"/>
                        </StackPanel>
                    </Border>

                    <!-- KP / Personal Ledger Total -->
                    <Border Background="#E8F5E9" CornerRadius="12" Padding="12,6" Margin="0,0,12,0"
                            Visibility="{Binding IsPersonalLedgerEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding PersonalLedgerTitle, StringFormat='{}{0}: '}" FontWeight="SemiBold" Foreground="#2E7D32" FontSize="13"/>
                            <TextBlock Text="{Binding TotalKpAmount, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" Foreground="#2E7D32" FontSize="13"/>
                        </StackPanel>
                    </Border>

                    <!-- Grand Total Expenses -->
                    <Border Background="#E1F5FE" CornerRadius="12" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Grand Total Expenses: " FontWeight="Bold" Foreground="#0277BD" FontSize="14"/>
                            <TextBlock Text="{Binding GrandTotalExpensesAmount, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" Foreground="#0277BD" FontSize="14"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Button Grid.Column="2" Content="Refresh Log" Command="{Binding LoadCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"/>
            </Grid>
        </materialDesign:Card>

        <!-- Main Workspace Grid -->
        <Grid Grid.Row="1" Margin="16,0,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="6*"/>
            </Grid.ColumnDefinitions>

            <!-- Column 1: Add / Edit Form -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <materialDesign:Card Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding FormTitle}" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="New / Clear" Command="{Binding ClearFormCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="32" Padding="8,0"/>
                        </Grid>

                        <Label Content="Expense Date:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding ExpenseDate}" Style="{StaticResource MaterialDesignOutlinedDatePicker}" materialDesign:HintAssist.IsFloating="True" Margin="0,0,0,16"/>

                        <TextBox Text="{Binding Rent, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}" materialDesign:HintAssist.Hint="Rent Expense (₹)" />
                        <TextBox Text="{Binding Salary, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}" materialDesign:HintAssist.Hint="Staff Salary (₹)" />
                        <TextBox Text="{Binding TripSheetLoss, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}" materialDesign:HintAssist.Hint="Trip Sheet Loss (₹)" />
                        <TextBox Text="{Binding DsmShort, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}" materialDesign:HintAssist.Hint="DSM Short / Deficit (₹)" />
                        <TextBox Text="{Binding BankingExpenses, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}" materialDesign:HintAssist.Hint="Banking Expenses (₹)" />
                        <TextBox Text="{Binding BpclPortalExpenses, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}" materialDesign:HintAssist.Hint="BPCL Portal Expenses (₹)" />
                        <TextBox Text="{Binding FuelAndTravel, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}" materialDesign:HintAssist.Hint="Fuel &amp; Travel (₹)" />
                        <TextBox Text="{Binding OilPurchase, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}" materialDesign:HintAssist.Hint="Oil/Inventory Purchases (₹)" />
                        <TextBox Text="{Binding RepairsAndMaintenance, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}" materialDesign:HintAssist.Hint="Repairs &amp; Maintenance (₹)" />
                        <TextBox Text="{Binding ElectricityExpenses, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}" materialDesign:HintAssist.Hint="Electricity Expenses (₹)" />
                        <TextBox Text="{Binding OfficeExpenses, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}" materialDesign:HintAssist.Hint="Office Expenses (₹)" />
                        <TextBox Text="{Binding PrintingExpense, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}" materialDesign:HintAssist.Hint="Printing Expense (₹)" />
                        
                        <!-- Custom Categories Section -->
                        <TextBlock Text="Custom Categories" FontWeight="SemiBold" FontSize="14" Margin="0,8,0,8" Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                        <ItemsControl ItemsSource="{Binding CategoryExpenses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                             <ColumnDefinition Width="2*"/>
                                             <ColumnDefinition Width="8"/>
                                             <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}" 
                                                 materialDesign:HintAssist.Hint="{Binding CategoryName, StringFormat='Remarks for {0}'}" Margin="0"/>
                                        <TextBox Grid.Column="2" Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}" 
                                                 materialDesign:HintAssist.Hint="{Binding CategoryName, StringFormat='{}{0} (₹)'}" Margin="0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Add Custom Category -->
                        <Expander Header="Add Custom Expense Category" Margin="0,0,0,12">
                            <StackPanel Margin="8">
                                <TextBox Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="New Category Name" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,8"/>
                                <Button Content="Add Category" Command="{Binding AddCategoryCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Expander>

                        <Label Content="Remarks / Details:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Optional Remarks" Height="60" TextWrapping="Wrap" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                        <Button Content="Save Expense Entry" Command="{Binding SaveCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Height="48" Margin="0,8,0,0" FontSize="15" FontWeight="Bold"/>
                        <TextBlock Text="{Binding StatusMessage}" Margin="0,10,0,0" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </materialDesign:Card>
            </ScrollViewer>

            <!-- Column 2: History & Personal Ledger -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top Card: Expense Log History -->
                <materialDesign:Card Grid.Row="0" Style="{StaticResource SectionCard}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- History Search Bar -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Expense Log History" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0"/>

                            <!-- Range selector -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                <DatePicker SelectedDate="{Binding HistoryStartDate}" materialDesign:HintAssist.Hint="From" Style="{StaticResource MaterialDesignOutlinedDatePicker}" Width="135" Margin="0,0,8,0" materialDesign:HintAssist.IsFloating="True"/>
                                <DatePicker SelectedDate="{Binding HistoryEndDate}" materialDesign:HintAssist.Hint="To" Style="{StaticResource MaterialDesignOutlinedDatePicker}" Width="135" materialDesign:HintAssist.IsFloating="True"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Print Log" Command="{Binding PrintCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#00695C" BorderBrush="#00695C" Height="40" Padding="12,0" Margin="0,0,8,0"/>
                                <Button Content="Export Excel" Command="{Binding ExportExcelCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#1B5E20" BorderBrush="#1B5E20" Height="40" Padding="12,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- History Table -->
                        <DataGrid Grid.Row="1" ItemsSource="{Binding HistoryExpenses}" AutoGenerateColumns="False" 
                                  IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                                  RowDetailsVisibilityMode="Visible">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Id, StringFormat='#{0}'}" Width="55" FontWeight="Bold"/>
                                <DataGridTextColumn Header="Date" Binding="{Binding ExpenseDate, StringFormat=dd-MMM-yyyy}" Width="110" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="Total Amount" Binding="{Binding TotalAmount, Converter={StaticResource CurrencyConverter}}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Active Expenses Breakdown" Binding="{Binding ActiveFieldsSummary}" Width="2.2*"/>
                                <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks}" Width="1.2*"/>
                                
                                <DataGridTemplateColumn Header="View / Details" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding ToggleExpandCommand}"
                                                    Style="{StaticResource MaterialDesignIconForegroundButton}"
                                                    ToolTip="Toggle Detailed Breakdown (Eye)" Margin="2,0">
                                                <materialDesign:PackIcon Width="20" Height="20">
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="materialDesign:PackIcon">
                                                            <Setter Property="Kind" Value="EyeOutline"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                    <Setter Property="Kind" Value="EyeOffOutline"/>
                                                                    <Setter Property="Foreground" Value="#E65100"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Actions" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource MaterialDesignIconForegroundButton}" ToolTip="Edit Entry" Margin="0,0,4,0">
                                                    <materialDesign:PackIcon Kind="Pencil" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                                                </Button>
                                                <Button Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource MaterialDesignIconForegroundButton}" ToolTip="Delete Entry">
                                                    <materialDesign:PackIcon Kind="Delete" Foreground="Red" />
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>

                            <DataGrid.RowDetailsTemplate>
                                <DataTemplate>
                                    <materialDesign:Card Margin="8,4,8,8" Padding="14,10" Background="#F8FAFC" UniformCornerRadius="8"
                                                         materialDesign:ElevationAssist.Elevation="Dp1"
                                                         Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <materialDesign:PackIcon Kind="ReceiptTextCheckOutline" Width="20" Height="20" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Id, StringFormat='All Expense Fields for Entry #{0}:'}"
                                                               FontWeight="Bold" FontSize="13" Foreground="#0F172A" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding TotalAmount, StringFormat='Total: ₹{0:N2}'}"
                                                           FontWeight="Bold" FontSize="14" Foreground="#2E7D32" VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- Complete Expense Fields Matrix -->
                                            <ItemsControl ItemsSource="{Binding BreakdownItems}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6"
                                                                Margin="0,0,8,8" Padding="10,6" MinWidth="150">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                                                                <TextBlock Text="{Binding Amount, Converter={StaticResource CurrencyConverter}}" FontSize="14" FontWeight="Bold" Foreground="{Binding ColorHex}" Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Remarks & Logged Time -->
                                            <Border Background="#E2E8F0" Height="1" Margin="0,2,0,6"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="Remarks: " FontWeight="SemiBold" FontSize="11" Foreground="#475569"/>
                                                    <TextBlock Text="{Binding Remarks}" FontSize="11" FontStyle="Italic" Foreground="#1E293B"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding CreatedAt, StringFormat='Logged at: {0:dd-MMM-yyyy hh:mm tt}'}" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                            </Grid>
                                        </StackPanel>
                                    </materialDesign:Card>
                                </DataTemplate>
                            </DataGrid.RowDetailsTemplate>
                        </DataGrid>
                    </Grid>
                </materialDesign:Card>

                <!-- Bottom Card: Personal Ledger (if enabled) -->
                <materialDesign:Card Grid.Row="1" Style="{StaticResource SectionCard}" Margin="0" Height="260"
                                     Visibility="{Binding IsPersonalLedgerEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Bank" Width="22" Height="22" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding PersonalLedgerTitle, StringFormat='🏛️ {0} (PWA &amp; Admin Entries)'}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#E8F5E9" CornerRadius="12" Padding="12,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Total: " FontWeight="SemiBold" Foreground="#2E7D32"/>
                                    <TextBlock Text="{Binding TotalKpAmount, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" Foreground="#2E7D32"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding HistoryKpEntries}" AutoGenerateColumns="False" IsReadOnly="True" VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd-MMM-yyyy}" Width="1.2*" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="DSM Name" Binding="{Binding DsmName}" Width="1.5*"/>
                                <DataGridTextColumn Header="Person / Purpose" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTextColumn Header="Slip No" Binding="{Binding SlipNumber}" Width="1.2*"/>
                                <DataGridTextColumn Header="Amount (₹)" Binding="{Binding Amount, Converter={StaticResource CurrencyConverter}}" Width="1.2*" FontWeight="Bold" Foreground="#1565C0"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </materialDesign:Card>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
