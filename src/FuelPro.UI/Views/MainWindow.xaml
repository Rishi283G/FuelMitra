<Window x:Class="FuelPro.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:FuelPro.UI.ViewModels"
        xmlns:views="clr-namespace:FuelPro.UI.Views"
        Title="{Binding WindowTitle}"
        Width="1280" Height="820" MinWidth="1024" MinHeight="768"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DsmEntryViewModel}">
            <views:DsmEntryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FinalCalculationViewModel}">
            <views:FinalCalculationView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DayTotalViewModel}">
            <views:DayTotalView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AgsImportViewModel}">
            <views:AgsImportView/>
        </DataTemplate>
    </Window.Resources>

    <materialDesign:DialogHost Identifier="RootDialog">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="36"/>
            </Grid.RowDefinitions>

            <!-- Sidebar Navigation -->
            <Border Grid.Column="0" Grid.RowSpan="2"
                    Background="{DynamicResource MaterialDesign.Brush.Primary}">
                <StackPanel Margin="0,16,0,0">
                    <!-- App Icon -->
                    <materialDesign:PackIcon Kind="GasStation" Width="36" Height="36"
                                             Foreground="White"
                                             HorizontalAlignment="Center" Margin="0,8,0,24"/>

                    <!-- Dashboard -->
                    <Button Command="{Binding NavigateToDashboardCommand}" ToolTip="Dashboard" Margin="0,4">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="Opacity" Value="0.5" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNavIndex}" Value="0">
                                        <Setter Property="Opacity" Value="1" />
                                        <Setter Property="Background" Value="#33FFFFFF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <materialDesign:PackIcon Kind="ViewDashboard" Width="28" Height="28"/>
                    </Button>

                    <!-- DSM Entry -->
                    <Button Command="{Binding NavigateToDsmEntryCommand}" ToolTip="DSM Entry" Margin="0,4">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="Opacity" Value="0.5" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNavIndex}" Value="1">
                                        <Setter Property="Opacity" Value="1" />
                                        <Setter Property="Background" Value="#33FFFFFF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <materialDesign:PackIcon Kind="ClipboardEdit" Width="28" Height="28"/>
                    </Button>

                    <!-- Final Calculation -->
                    <Button Command="{Binding NavigateToFinalCalculationCommand}" ToolTip="Final Calculation" Margin="0,4">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="Opacity" Value="0.5" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNavIndex}" Value="2">
                                        <Setter Property="Opacity" Value="1" />
                                        <Setter Property="Background" Value="#33FFFFFF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <materialDesign:PackIcon Kind="Calculator" Width="28" Height="28"/>
                    </Button>

                    <!-- Day Total -->
                    <Button Command="{Binding NavigateToDayTotalCommand}" ToolTip="Day Total" Margin="0,4">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="Opacity" Value="0.5" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNavIndex}" Value="3">
                                        <Setter Property="Opacity" Value="1" />
                                        <Setter Property="Background" Value="#33FFFFFF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <materialDesign:PackIcon Kind="CalendarMonth" Width="28" Height="28"/>
                    </Button>

                    <!-- Settings -->
                    <Button Command="{Binding NavigateToSettingsCommand}" ToolTip="Settings" Margin="0,4">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="Opacity" Value="0.5" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNavIndex}" Value="4">
                                        <Setter Property="Opacity" Value="1" />
                                        <Setter Property="Background" Value="#33FFFFFF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <materialDesign:PackIcon Kind="Cog" Width="28" Height="28"/>
                    </Button>

                    <!-- AGS Import -->
                    <Button Command="{Binding NavigateToAgsImportCommand}" ToolTip="AGS Import" Margin="0,4">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="Opacity" Value="0.5" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNavIndex}" Value="5">
                                        <Setter Property="Opacity" Value="1" />
                                        <Setter Property="Background" Value="#33FFFFFF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <materialDesign:PackIcon Kind="FileImport" Width="28" Height="28"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Main Content -->
            <ContentControl Grid.Column="1" Grid.Row="0"
                            Content="{Binding CurrentView}"
                            Margin="0"/>

            <!-- Status Bar -->
            <Border Grid.Column="1" Grid.Row="1"
                    Background="{DynamicResource MaterialDesign.Brush.Primary.Light}"
                    TextElement.Foreground="White"
                    Padding="16,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Account" Width="16" Height="16" Margin="0,0,4,0" Opacity="0.6"/>
                        <TextBlock Text="{Binding CurrentUser}" FontSize="11" Opacity="0.7"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="{Binding StationName}" FontSize="11"
                               HorizontalAlignment="Center" Opacity="0.5"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0">
                        <materialDesign:PackIcon Kind="ContentSave" Width="14" Height="14" Margin="0,0,4,0" Opacity="0.5"/>
                        <TextBlock Text="{Binding LastSaveTime, StringFormat='Last Save: {0}'}"
                                   FontSize="11" Opacity="0.6"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Clock" Width="14" Height="14" Margin="0,0,4,0" Opacity="0.5"/>
                        <TextBlock Text="{Binding CurrentDateTime}" FontSize="11" Opacity="0.7"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </materialDesign:DialogHost>
</Window>
