<Window x:Class="FuelPro.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:FuelPro.UI.ViewModels"
        xmlns:views="clr-namespace:FuelPro.UI.Views"
        Title="{Binding WindowTitle}"
        Width="1280" Height="820" MinWidth="1024" MinHeight="768"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        Icon="pack://application:,,,/Resources/fuel-pump-icon.ico">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DsmEntryViewModel}">
            <views:DsmEntryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OilDefDailyLogViewModel}">
            <views:OilDefDailyLogView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FinalCalculationViewModel}">
            <views:FinalCalculationView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DayTotalViewModel}">
            <views:DayTotalView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AgsImportViewModel}">
            <views:AgsImportView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DsmApprovalQueueViewModel}">
            <views:DsmApprovalQueueView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DsmManagementViewModel}">
            <views:DsmManagementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CardSettlementViewModel}">
            <views:CardSettlementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DebtorManagementViewModel}">
            <views:DebtorManagementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PumpExpensesViewModel}">
            <views:PumpExpensesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PettyCashViewModel}">
            <views:PettyCashView/>
        </DataTemplate>
    </Window.Resources>


    <materialDesign:DialogHost Identifier="RootDialog">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="36"/>
            </Grid.RowDefinitions>

            <!-- Sidebar Navigation -->
            <Border Grid.Column="0" Grid.RowSpan="2"
                    Background="{DynamicResource MaterialDesign.Brush.Primary}">
                <StackPanel Margin="0,16,0,0">
                    <!-- App Icon -->
                    <materialDesign:PackIcon Kind="GasStation" Width="36" Height="36"
                                             Foreground="White"
                                             HorizontalAlignment="Center" Margin="0,8,0,24"/>

                    <!-- DSM Entry -->
                    <Button Command="{Binding NavigateToDsmEntryCommand}" ToolTip="DSM Entry" Margin="0,4">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="Opacity" Value="0.5" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNavIndex}" Value="0">
                                        <Setter Property="Opacity" Value="1" />
                                        <Setter Property="Background" Value="#33FFFFFF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <materialDesign:PackIcon Kind="ClipboardEdit" Width="28" Height="28"/>
                    </Button>

                    <!-- Oil & DEF Log -->
                    <Button Command="{Binding NavigateToOilDefDailyLogCommand}" ToolTip="Oil &amp; DEF Daily Log" Margin="0,4">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="Opacity" Value="0.5" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNavIndex}" Value="1">
                                        <Setter Property="Opacity" Value="1" />
                                        <Setter Property="Background" Value="#33FFFFFF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <materialDesign:PackIcon Kind="Oil" Width="28" Height="28"/>
                    </Button>

                    <!-- Final Calculation -->
                    <Button Command="{Binding NavigateToFinalCalculationCommand}" ToolTip="Final Calculation" Margin="0,4">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="Opacity" Value="0.5" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNavIndex}" Value="2">
                                        <Setter Property="Opacity" Value="1" />
                                        <Setter Property="Background" Value="#33FFFFFF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <materialDesign:PackIcon Kind="Calculator" Width="28" Height="28"/>
                    </Button>

                    <!-- Day Total -->
                    <Button Command="{Binding NavigateToDayTotalCommand}" ToolTip="Day Total" Margin="0,4">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="Opacity" Value="0.5" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNavIndex}" Value="3">
                                        <Setter Property="Opacity" Value="1" />
                                        <Setter Property="Background" Value="#33FFFFFF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <materialDesign:PackIcon Kind="CalendarMonth" Width="28" Height="28"/>
                    </Button>

                    <!-- Debtor Management -->
                    <Button Command="{Binding NavigateToDebtorManagementCommand}" ToolTip="Debtor Management" Margin="0,4">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="Opacity" Value="0.5" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNavIndex}" Value="9">
                                        <Setter Property="Opacity" Value="1" />
                                        <Setter Property="Background" Value="#33FFFFFF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <materialDesign:PackIcon Kind="AccountCash" Width="28" Height="28"/>
                    </Button>

                    <!-- DSM Approval Queue with Badge -->
                    <Button Command="{Binding NavigateToDsmApprovalQueueCommand}" ToolTip="DSM Approval Queue" Margin="0,4">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="Opacity" Value="0.5" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNavIndex}" Value="6">
                                        <Setter Property="Opacity" Value="1" />
                                        <Setter Property="Background" Value="#33FFFFFF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <materialDesign:Badged Badge="{Binding PendingDsmCount}" BadgeColorZoneMode="PrimaryDark">
                            <materialDesign:Badged.Style>
                                <Style TargetType="materialDesign:Badged">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PendingDsmCount}" Value="0">
                                            <Setter Property="Badge" Value="{x:Null}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialDesign:Badged.Style>
                            <materialDesign:PackIcon Kind="BriefcaseCheck" Width="28" Height="28"/>
                        </materialDesign:Badged>
                    </Button>

                    <!-- DSM Management -->
                    <Button Command="{Binding NavigateToDsmManagementCommand}" ToolTip="DSM &amp; Device Management" Margin="0,4">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="Opacity" Value="0.5" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNavIndex}" Value="7">
                                        <Setter Property="Opacity" Value="1" />
                                        <Setter Property="Background" Value="#33FFFFFF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <materialDesign:PackIcon Kind="AccountMultiple" Width="28" Height="28"/>
                    </Button>

                    <!-- Card Settlement -->
                    <Button Command="{Binding NavigateToCardSettlementCommand}" ToolTip="TID Sheet" Margin="0,4">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="Opacity" Value="0.5" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNavIndex}" Value="8">
                                        <Setter Property="Opacity" Value="1" />
                                        <Setter Property="Background" Value="#33FFFFFF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <materialDesign:PackIcon Kind="CreditCardCheck" Width="28" Height="28"/>
                    </Button>

                    <!-- Pump Expenses -->
                    <Button Command="{Binding NavigateToPumpExpensesCommand}" ToolTip="Pump Expenses" Margin="0,4">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="Opacity" Value="0.5" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNavIndex}" Value="10">
                                        <Setter Property="Opacity" Value="1" />
                                        <Setter Property="Background" Value="#33FFFFFF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <materialDesign:PackIcon Kind="CurrencyInr" Width="28" Height="28"/>
                    </Button>

                    <!-- Petty Cash -->
                    <Button Command="{Binding NavigateToPettyCashCommand}" ToolTip="Petty Cash" Margin="0,4">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="Opacity" Value="0.5" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNavIndex}" Value="11">
                                        <Setter Property="Opacity" Value="1" />
                                        <Setter Property="Background" Value="#33FFFFFF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <materialDesign:PackIcon Kind="Wallet" Width="28" Height="28"/>
                    </Button>

                    <!-- AGS Import -->
                    <Button Command="{Binding NavigateToAgsImportCommand}" ToolTip="AGS Import" Margin="0,4">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="Opacity" Value="0.5" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNavIndex}" Value="5">
                                        <Setter Property="Opacity" Value="1" />
                                        <Setter Property="Background" Value="#33FFFFFF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <materialDesign:PackIcon Kind="FileImport" Width="28" Height="28"/>
                    </Button>

                    <!-- Settings -->
                    <Button Command="{Binding NavigateToSettingsCommand}" ToolTip="Settings" Margin="0,4">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="Opacity" Value="0.5" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNavIndex}" Value="4">
                                        <Setter Property="Opacity" Value="1" />
                                        <Setter Property="Background" Value="#33FFFFFF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <materialDesign:PackIcon Kind="Cog" Width="28" Height="28"/>
                    </Button>
                </StackPanel>
            </Border>


            <!-- Main Content Area with Top Toolbar -->
            <Grid Grid.Column="1" Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Persistent Top Toolbar -->
                <Border Grid.Row="0" Background="White" BorderThickness="0,0,0,1" BorderBrush="#E0E0E0" Padding="20,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Station Name -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="GasStation" Width="20" Height="20" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding StationName}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Right: Sync status indicator & Force Sync button -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#F44336"/>
                                        <Setter Property="ToolTip" Value="Offline"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SyncStatusText}" Value="Synced">
                                                <Setter Property="Fill" Value="#4CAF50"/>
                                                <Setter Property="ToolTip" Value="Synced"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SyncStatusText}" Value="Syncing">
                                                <Setter Property="Fill" Value="#FFEB3B"/>
                                                <Setter Property="ToolTip" Value="Syncing"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding SyncStatusText}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,16,0" Opacity="0.8"/>

                            <Button Command="{Binding ForceSyncCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="32" Padding="12,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CloudSync" Width="16" Height="16" Margin="0,0,4,0"/>
                                    <TextBlock Text="Sync Now" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Main Content -->
                <ContentControl Grid.Row="1"
                                Content="{Binding CurrentView}"
                                Margin="0"/>
            </Grid>

            <!-- Status Bar -->
            <Border Grid.Column="1" Grid.Row="1"
                    Background="{DynamicResource MaterialDesign.Brush.Primary.Light}"
                    TextElement.Foreground="White"
                    Padding="16,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Account" Width="16" Height="16" Margin="0,0,4,0" Opacity="0.6"/>
                        <TextBlock Text="{Binding CurrentUser}" FontSize="11" Opacity="0.7"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="{Binding StationName}" FontSize="11"
                               HorizontalAlignment="Center" Opacity="0.5"/>

                    <!-- Sync Status -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0">
                        <materialDesign:PackIcon Kind="CloudSync" Width="14" Height="14" Margin="0,0,4,0" Opacity="0.6"/>
                        <TextBlock Text="{Binding SyncStatusText}" FontSize="11" Opacity="0.6"/>
                        <TextBlock Text=" · " FontSize="11" Opacity="0.3"/>
                        <TextBlock Text="{Binding PendingSyncCount, StringFormat='{}{0} pending'}" FontSize="11" Opacity="0.6"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="16,0">
                        <materialDesign:PackIcon Kind="ContentSave" Width="14" Height="14" Margin="0,0,4,0" Opacity="0.5"/>
                        <TextBlock Text="{Binding LastSyncTime, StringFormat='Last Sync: {0}'}"
                                   FontSize="11" Opacity="0.6"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="16,0">
                        <materialDesign:PackIcon Kind="ContentSave" Width="14" Height="14" Margin="0,0,4,0" Opacity="0.5"/>
                        <TextBlock Text="{Binding LastSaveTime, StringFormat='Last Save: {0}'}"
                                   FontSize="11" Opacity="0.6"/>
                    </StackPanel>

                    <StackPanel Grid.Column="5" Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Clock" Width="14" Height="14" Margin="0,0,4,0" Opacity="0.5"/>
                        <TextBlock Text="{Binding CurrentDateTime}" FontSize="11" Opacity="0.7"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </materialDesign:DialogHost>
</Window>
