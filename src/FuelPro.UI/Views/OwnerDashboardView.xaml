<UserControl x:Class="FuelPro.UI.Views.OwnerDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:FuelPro.UI.Converters">

    <UserControl.Resources>
        <converters:IndianCurrencyConverter x:Key="CurrencyConverter"/>
        <converters:LitresConverter x:Key="LitresConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header Row: Title + Date Picker + Sync Status -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ViewDashboard" Width="28" Height="28"
                                             Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                             VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Owner Dashboard" FontSize="24" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding Presets}" SelectedValue="{Binding SelectedPreset}" materialDesign:HintAssist.Hint="Preset" Style="{StaticResource MaterialDesignOutlinedComboBox}" Width="120" Margin="0,0,8,0"/>
                    <DatePicker SelectedDate="{Binding StartDate}" materialDesign:HintAssist.Hint="Start Date" Width="130" Margin="0,0,8,0">
                        <DatePicker.Style>
                            <Style TargetType="DatePicker" BasedOn="{StaticResource MaterialDesignOutlinedDatePicker}">
                                <Setter Property="IsEnabled" Value="False"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPreset}" Value="Custom">
                                        <Setter Property="IsEnabled" Value="True"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DatePicker.Style>
                    </DatePicker>
                    <DatePicker SelectedDate="{Binding EndDate}" materialDesign:HintAssist.Hint="End Date" Width="130" Margin="0,0,8,0">
                        <DatePicker.Style>
                            <Style TargetType="DatePicker" BasedOn="{StaticResource MaterialDesignOutlinedDatePicker}">
                                <Setter Property="IsEnabled" Value="False"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPreset}" Value="Custom">
                                        <Setter Property="IsEnabled" Value="True"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DatePicker.Style>
                    </DatePicker>
                    <Button Command="{Binding PrintCommand}" Style="{StaticResource MaterialDesignFlatMidBgButton}" Height="48" Padding="12,0" Margin="0,0,8,0" ToolTip="Print Summary">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Printer" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Print" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ExportExcelCommand}" Style="{StaticResource MaterialDesignFlatMidBgButton}" Height="48" Padding="12,0" Background="#1B5E20" BorderBrush="#1B5E20" ToolTip="Export to Excel">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileExcel" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Export" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Prominent Sync Status Card -->
                <materialDesign:Card Grid.Column="2" Padding="16,10"
                                     materialDesign:ElevationAssist.Elevation="Dp2"
                                     UniformCornerRadius="8">
                    <StackPanel Orientation="Horizontal">
                        <!-- Last Updated -->
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Last Updated:" FontSize="10" Opacity="0.5"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding LastSyncDisplay}" FontSize="13"
                                       FontWeight="Bold" Foreground="#00695C"/>
                        </StackPanel>
                        <Border Width="1" Background="#E0E0E0" Margin="0,2"/>
                        <!-- Records Pending -->
                        <StackPanel Margin="24,0,0,0">
                            <TextBlock Text="Records Pending:" FontSize="10" Opacity="0.5"
                                       FontWeight="SemiBold"/>
                            <TextBlock FontSize="16" FontWeight="Bold" HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#4CAF50"/>
                                        <Setter Property="Text" Value="{Binding RecordsPending}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSyncHealthy}" Value="False">
                                                <Setter Property="Foreground" Value="#FF9800"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        
                        <Border Width="1" Background="#E0E0E0" Margin="24,2,0,2"/>
                        
                        <!-- Refresh Button -->
                        <Button Command="{Binding RefreshCommand}" 
                                Style="{StaticResource MaterialDesignIconButton}"
                                Width="36" Height="36" Margin="16,0,0,0"
                                ToolTip="Refresh data from Cloud"
                                IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}">
                            <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" RenderTransformOrigin="0.5,0.5">
                                <materialDesign:PackIcon.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </materialDesign:PackIcon.RenderTransform>
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon" BasedOn="{StaticResource {x:Type materialDesign:PackIcon}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard Name="SpinStoryboard">
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                             From="0" To="360" Duration="0:0:1"
                                                                             RepeatBehavior="Forever"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="SpinStoryboard"/>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                        </Button>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>

            <!-- Loading Indicator (Always visible on top of cards during sync/load) -->
            <ProgressBar Grid.Row="0" IsIndeterminate="{Binding IsLoading}"
                         Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                         Style="{StaticResource MaterialDesignLinearProgressBar}"
                         Height="4" Panel.ZIndex="1000"
                         VerticalAlignment="Bottom" Margin="0,0,0,0"/>

            <!-- KPI Cards Row -->
            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
                <!-- Total Sale -->
                <materialDesign:Card Margin="4" Padding="16" materialDesign:ElevationAssist.Elevation="Dp2"
                                     UniformCornerRadius="12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <materialDesign:PackIcon Kind="CurrencyInr" Foreground="#1565C0" Width="20" Height="20"/>
                            <TextBlock Text="Total Sale" FontSize="12" Opacity="0.6" Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TodayTotalSale, Converter={StaticResource CurrencyConverter}}"
                                   FontSize="20" FontWeight="Bold" Foreground="#1565C0"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Total Litres -->
                <materialDesign:Card Margin="4" Padding="16" materialDesign:ElevationAssist.Elevation="Dp2"
                                     UniformCornerRadius="12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <materialDesign:PackIcon Kind="GasStation" Foreground="#2E7D32" Width="20" Height="20"/>
                            <TextBlock Text="Total Litres" FontSize="12" Opacity="0.6" Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TodayTotalLitres, Converter={StaticResource LitresConverter}}"
                                   FontSize="20" FontWeight="Bold" Foreground="#2E7D32"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Total Collection -->
                <materialDesign:Card Margin="4" Padding="16" materialDesign:ElevationAssist.Elevation="Dp2"
                                     UniformCornerRadius="12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <materialDesign:PackIcon Kind="BankTransfer" Foreground="#F57F17" Width="20" Height="20"/>
                            <TextBlock Text="Collection" FontSize="12" Opacity="0.6" Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TodayTotalCollection, Converter={StaticResource CurrencyConverter}}"
                                   FontSize="20" FontWeight="Bold" Foreground="#F57F17"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Mismatch -->
                <materialDesign:Card Margin="4" Padding="16" materialDesign:ElevationAssist.Elevation="Dp2"
                                     UniformCornerRadius="12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <materialDesign:PackIcon Kind="AlertCircle" Foreground="#C62828" Width="20" Height="20"/>
                            <TextBlock Text="Mismatch" FontSize="12" Opacity="0.6" Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TodayTotalMismatch, Converter={StaticResource CurrencyConverter}}"
                                   FontSize="20" FontWeight="Bold" Foreground="#C62828"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Oil & DEF Sales -->
                <materialDesign:Card Margin="4" Padding="16" materialDesign:ElevationAssist.Elevation="Dp2"
                                     UniformCornerRadius="12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <materialDesign:PackIcon Kind="Oil" Foreground="#6A1B9A" Width="20" Height="20"/>
                            <TextBlock Text="Oil &amp; DEF Sales" FontSize="12" Opacity="0.6" Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding OilDefSalesTotal, Converter={StaticResource CurrencyConverter}}"
                                   FontSize="20" FontWeight="Bold" Foreground="#6A1B9A"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Oil & DEF Profit -->
                <materialDesign:Card Margin="4" Padding="16" materialDesign:ElevationAssist.Elevation="Dp2"
                                     UniformCornerRadius="12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <materialDesign:PackIcon Kind="ChartBox" Foreground="#283593" Width="20" Height="20"/>
                            <TextBlock Text="Oil &amp; DEF Profit" FontSize="12" Opacity="0.6" Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding OilDefProfitTotal, Converter={StaticResource CurrencyConverter}}"
                                   FontSize="20" FontWeight="Bold" Foreground="#283593"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Net Profit -->
                <materialDesign:Card Margin="4" Padding="16" materialDesign:ElevationAssist.Elevation="Dp2"
                                     UniformCornerRadius="12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <materialDesign:PackIcon Kind="TrendingUp" Foreground="#00695C" Width="20" Height="20"/>
                            <TextBlock Text="Net Profit (Range)" FontSize="12" Opacity="0.6" Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding RangeNetProfit, Converter={StaticResource CurrencyConverter}}"
                                   FontSize="20" FontWeight="Bold" Foreground="#00695C"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Outstanding Debtors -->
                <materialDesign:Card Margin="4" Padding="16" materialDesign:ElevationAssist.Elevation="Dp2"
                                     UniformCornerRadius="12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <materialDesign:PackIcon Kind="AccountAlert" Foreground="#BF360C" Width="20" Height="20"/>
                            <TextBlock Text="Outstanding Debtors" FontSize="12" Opacity="0.6" Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding OutstandingDebtors, Converter={StaticResource CurrencyConverter}}"
                                   FontSize="20" FontWeight="Bold" Foreground="#BF360C"/>
                    </StackPanel>
                </materialDesign:Card>
            </UniformGrid>

            <!-- Fuel Breakdown Row -->
            <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,16">
                <!-- HSD -->
                <materialDesign:Card Margin="4" Padding="16" materialDesign:ElevationAssist.Elevation="Dp1"
                                     UniformCornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="HSD - 20KL" FontSize="14" FontWeight="SemiBold" Opacity="0.7"/>
                        <TextBlock Text="{Binding TodayHsdLitres, Converter={StaticResource LitresConverter}}"
                                   FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- MS-I -->
                <materialDesign:Card Margin="4" Padding="16" materialDesign:ElevationAssist.Elevation="Dp1"
                                     UniformCornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="MS - 20KL" FontSize="14" FontWeight="SemiBold" Opacity="0.7"/>
                        <TextBlock Text="{Binding TodayMsILitres, Converter={StaticResource LitresConverter}}"
                                   FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- MS-II -->
                <materialDesign:Card Margin="4" Padding="16" materialDesign:ElevationAssist.Elevation="Dp1"
                                     UniformCornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="HSD - 20KL II" FontSize="14" FontWeight="SemiBold" Opacity="0.7"/>
                        <TextBlock Text="{Binding TodayMsIILitres, Converter={StaticResource LitresConverter}}"
                                   FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                    </StackPanel>
                </materialDesign:Card>
            </UniformGrid>

            <!-- Payment Breakdown Row -->
            <materialDesign:Card Grid.Row="3" Margin="4,0,4,16" Padding="16"
                                 materialDesign:ElevationAssist.Elevation="Dp1" UniformCornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Payment Mode Breakdown" FontSize="14" FontWeight="SemiBold"
                               Margin="0,0,0,12" Opacity="0.7"/>
                    <ItemsControl ItemsSource="{Binding PaymentBreakdown}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <materialDesign:Card Margin="4,4,16,8" Padding="12,8" UniformCornerRadius="8"
                                                     MinWidth="150" Background="#FAFAFA" materialDesign:ElevationAssist.Elevation="Dp0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding CollectionMode}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Amount, Converter={StaticResource CurrencyConverter}}"
                                                   FontSize="16" FontWeight="Bold" Margin="0,3,0,0" Foreground="{Binding DisplayColor}"/>
                                    </StackPanel>
                                </materialDesign:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </materialDesign:Card>

            <!-- DSM Shift Totals Summary -->
            <materialDesign:Card Grid.Row="4" Margin="4,0,4,16" Padding="16"
                                 materialDesign:ElevationAssist.Elevation="Dp1" UniformCornerRadius="8">
                <StackPanel>
                    <TextBlock Text="DSM Shift Totals Summary (Combined per DSM)" FontSize="14" FontWeight="SemiBold"
                               Margin="0,0,0,12" Opacity="0.7"/>
                    <DataGrid ItemsSource="{Binding DsmShiftTotals}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="220">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DSM Name" Binding="{Binding DsmName}" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Sessions" Binding="{Binding SessionsCount}" Width="70"/>
                            <DataGridTextColumn Header="Pumps" Binding="{Binding AssignedPumpsDisplay}"/>
                            <DataGridTextColumn Header="Gross Sales" Binding="{Binding GrossSales, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" Foreground="Green"/>
                            <DataGridTextColumn Header="Digital" Binding="{Binding DigitalTotal, Converter={StaticResource CurrencyConverter}}"/>
                            <DataGridTextColumn Header="Bank Cash" Binding="{Binding CashDeposit, Converter={StaticResource CurrencyConverter}}"/>
                            <DataGridTextColumn Header="Hand Cash" Binding="{Binding CashInHand, Converter={StaticResource CurrencyConverter}}"/>
                            <DataGridTextColumn Header="Debtors" Binding="{Binding Debit, Converter={StaticResource CurrencyConverter}}" Foreground="Red"/>
                            <DataGridTextColumn Header="Expenses" Binding="{Binding Expenses, Converter={StaticResource CurrencyConverter}}" Foreground="Red"/>
                            <DataGridTextColumn Header="Testing" Binding="{Binding Testing, Converter={StaticResource CurrencyConverter}}"/>
                            <DataGridTextColumn Header="Total Collection" Binding="{Binding TotalCollection, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Mismatch" Binding="{Binding Mismatch, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </materialDesign:Card>

            <!-- Summary Footer -->
            <materialDesign:Card Grid.Row="5" Margin="4,0,4,16" Padding="16"
                                 materialDesign:ElevationAssist.Elevation="Dp1" UniformCornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Total DSM Entries" FontSize="11" Opacity="0.5"/>
                        <TextBlock Text="{Binding TotalDsmEntries}" FontSize="18" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Total Expenses" FontSize="11" Opacity="0.5"/>
                        <TextBlock Text="{Binding TodayTotalExpenses, Converter={StaticResource CurrencyConverter}}"
                                   FontSize="18" FontWeight="Bold" Foreground="#BF360C"/>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </ScrollViewer>
</UserControl>
