<UserControl x:Class="FuelPro.UI.Views.OwnerDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:FuelPro.UI.Converters">

    <UserControl.Resources>
        <converters:IndianCurrencyConverter x:Key="CurrencyConverter"/>
        <converters:LitresConverter x:Key="LitresConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header Row: Title + Date Picker + Sync Status -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ViewDashboard" Width="28" Height="28"
                                             Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                             VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Owner Dashboard" FontSize="24" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding Presets}" SelectedValue="{Binding SelectedPreset}" materialDesign:HintAssist.Hint="Preset" Style="{StaticResource MaterialDesignOutlinedComboBox}" Width="120" Margin="0,0,8,0"/>
                    <DatePicker SelectedDate="{Binding StartDate}" materialDesign:HintAssist.Hint="Start Date" Width="130" Margin="0,0,8,0">
                        <DatePicker.Style>
                            <Style TargetType="DatePicker" BasedOn="{StaticResource MaterialDesignOutlinedDatePicker}">
                                <Setter Property="IsEnabled" Value="False"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPreset}" Value="Custom">
                                        <Setter Property="IsEnabled" Value="True"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DatePicker.Style>
                    </DatePicker>
                    <DatePicker SelectedDate="{Binding EndDate}" materialDesign:HintAssist.Hint="End Date" Width="130">
                        <DatePicker.Style>
                            <Style TargetType="DatePicker" BasedOn="{StaticResource MaterialDesignOutlinedDatePicker}">
                                <Setter Property="IsEnabled" Value="False"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPreset}" Value="Custom">
                                        <Setter Property="IsEnabled" Value="True"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DatePicker.Style>
                    </DatePicker>
                </StackPanel>

                <!-- Prominent Sync Status Card -->
                <materialDesign:Card Grid.Column="2" Padding="16,10"
                                     materialDesign:ElevationAssist.Elevation="Dp2"
                                     UniformCornerRadius="8">
                    <StackPanel Orientation="Horizontal">
                        <!-- Last Updated -->
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Last Updated:" FontSize="10" Opacity="0.5"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding LastSyncDisplay}" FontSize="13"
                                       FontWeight="Bold" Foreground="#00695C"/>
                        </StackPanel>
                        <Border Width="1" Background="#E0E0E0" Margin="0,2"/>
                        <!-- Records Pending -->
                        <StackPanel Margin="24,0,0,0">
                            <TextBlock Text="Records Pending:" FontSize="10" Opacity="0.5"
                                       FontWeight="SemiBold"/>
                            <TextBlock FontSize="16" FontWeight="Bold" HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#4CAF50"/>
                                        <Setter Property="Text" Value="{Binding RecordsPending}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSyncHealthy}" Value="False">
                                                <Setter Property="Foreground" Value="#FF9800"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        
                        <Border Width="1" Background="#E0E0E0" Margin="24,2,0,2"/>
                        
                        <!-- Refresh Button -->
                        <Button Command="{Binding RefreshCommand}" 
                                Style="{StaticResource MaterialDesignIconButton}"
                                Width="36" Height="36" Margin="16,0,0,0"
                                ToolTip="Refresh data from Cloud"
                                IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}">
                            <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" RenderTransformOrigin="0.5,0.5">
                                <materialDesign:PackIcon.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </materialDesign:PackIcon.RenderTransform>
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon" BasedOn="{StaticResource {x:Type materialDesign:PackIcon}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard Name="SpinStoryboard">
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                             From="0" To="360" Duration="0:0:1"
                                                                             RepeatBehavior="Forever"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="SpinStoryboard"/>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                        </Button>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>

            <!-- Loading Indicator -->
            <ProgressBar Grid.Row="0" IsIndeterminate="{Binding IsLoading}"
                         Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                         Style="{StaticResource MaterialDesignLinearProgressBar}"
                         VerticalAlignment="Bottom" Margin="0,0,0,-8"/>

            <!-- KPI Cards Row -->
            <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,16">
                <!-- Total Sale -->
                <materialDesign:Card Margin="4" Padding="16" materialDesign:ElevationAssist.Elevation="Dp2"
                                     UniformCornerRadius="12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <materialDesign:PackIcon Kind="CurrencyInr" Foreground="#1565C0" Width="20" Height="20"/>
                            <TextBlock Text="Total Sale" FontSize="12" Opacity="0.6" Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TodayTotalSale, Converter={StaticResource CurrencyConverter}}"
                                   FontSize="22" FontWeight="Bold" Foreground="#1565C0"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Total Litres -->
                <materialDesign:Card Margin="4" Padding="16" materialDesign:ElevationAssist.Elevation="Dp2"
                                     UniformCornerRadius="12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <materialDesign:PackIcon Kind="GasStation" Foreground="#2E7D32" Width="20" Height="20"/>
                            <TextBlock Text="Total Litres" FontSize="12" Opacity="0.6" Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TodayTotalLitres, Converter={StaticResource LitresConverter}}"
                                   FontSize="22" FontWeight="Bold" Foreground="#2E7D32"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Total Collection -->
                <materialDesign:Card Margin="4" Padding="16" materialDesign:ElevationAssist.Elevation="Dp2"
                                     UniformCornerRadius="12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <materialDesign:PackIcon Kind="BankTransfer" Foreground="#F57F17" Width="20" Height="20"/>
                            <TextBlock Text="Collection" FontSize="12" Opacity="0.6" Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TodayTotalCollection, Converter={StaticResource CurrencyConverter}}"
                                   FontSize="22" FontWeight="Bold" Foreground="#F57F17"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Mismatch -->
                <materialDesign:Card Margin="4" Padding="16" materialDesign:ElevationAssist.Elevation="Dp2"
                                     UniformCornerRadius="12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <materialDesign:PackIcon Kind="AlertCircle" Foreground="#C62828" Width="20" Height="20"/>
                            <TextBlock Text="Mismatch" FontSize="12" Opacity="0.6" Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TodayTotalMismatch, Converter={StaticResource CurrencyConverter}}"
                                   FontSize="22" FontWeight="Bold" Foreground="#C62828"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Net Profit -->
                <materialDesign:Card Margin="4" Padding="16" materialDesign:ElevationAssist.Elevation="Dp2"
                                     UniformCornerRadius="12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <materialDesign:PackIcon Kind="TrendingUp" Foreground="#00695C" Width="20" Height="20"/>
                            <TextBlock Text="Net Profit (Range)" FontSize="12" Opacity="0.6" Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding RangeNetProfit, Converter={StaticResource CurrencyConverter}}"
                                   FontSize="22" FontWeight="Bold" Foreground="#00695C"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Outstanding Debtors -->
                <materialDesign:Card Margin="4" Padding="16" materialDesign:ElevationAssist.Elevation="Dp2"
                                     UniformCornerRadius="12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <materialDesign:PackIcon Kind="AccountAlert" Foreground="#BF360C" Width="20" Height="20"/>
                            <TextBlock Text="Outstanding Debtors (Lifetime)" FontSize="12" Opacity="0.6" Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding OutstandingDebtors, Converter={StaticResource CurrencyConverter}}"
                                   FontSize="22" FontWeight="Bold" Foreground="#BF360C"/>
                    </StackPanel>
                </materialDesign:Card>
            </UniformGrid>

            <!-- Fuel Breakdown Row -->
            <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,16">
                <!-- HSD -->
                <materialDesign:Card Margin="4" Padding="16" materialDesign:ElevationAssist.Elevation="Dp1"
                                     UniformCornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="HSD" FontSize="14" FontWeight="SemiBold" Opacity="0.7"/>
                        <TextBlock Text="{Binding TodayHsdLitres, Converter={StaticResource LitresConverter}}"
                                   FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- MS-I -->
                <materialDesign:Card Margin="4" Padding="16" materialDesign:ElevationAssist.Elevation="Dp1"
                                     UniformCornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="MS-I" FontSize="14" FontWeight="SemiBold" Opacity="0.7"/>
                        <TextBlock Text="{Binding TodayMsILitres, Converter={StaticResource LitresConverter}}"
                                   FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- MS-II -->
                <materialDesign:Card Margin="4" Padding="16" materialDesign:ElevationAssist.Elevation="Dp1"
                                     UniformCornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="MS-II" FontSize="14" FontWeight="SemiBold" Opacity="0.7"/>
                        <TextBlock Text="{Binding TodayMsIILitres, Converter={StaticResource LitresConverter}}"
                                   FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                    </StackPanel>
                </materialDesign:Card>
            </UniformGrid>

            <!-- Payment Breakdown Row -->
            <materialDesign:Card Grid.Row="3" Margin="4,0,4,16" Padding="16"
                                 materialDesign:ElevationAssist.Elevation="Dp1" UniformCornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Payment Mode Breakdown" FontSize="14" FontWeight="SemiBold"
                               Margin="0,0,0,12" Opacity="0.7"/>
                    <UniformGrid Columns="5">
                        <StackPanel Margin="4">
                            <TextBlock Text="Cash" FontSize="11" Opacity="0.5"/>
                            <TextBlock Text="{Binding TodayTotalCash, Converter={StaticResource CurrencyConverter}}"
                                       FontSize="16" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Margin="4">
                            <TextBlock Text="PhonePe" FontSize="11" Opacity="0.5"/>
                            <TextBlock Text="{Binding TodayTotalPhonePe, Converter={StaticResource CurrencyConverter}}"
                                       FontSize="16" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Margin="4">
                            <TextBlock Text="PineLabs Card" FontSize="11" Opacity="0.5"/>
                            <TextBlock Text="{Binding TodayTotalCreditCard, Converter={StaticResource CurrencyConverter}}"
                                       FontSize="16" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Margin="4">
                            <TextBlock Text="Petro Card" FontSize="11" Opacity="0.5"/>
                            <TextBlock Text="{Binding TodayTotalPetroCard, Converter={StaticResource CurrencyConverter}}"
                                       FontSize="16" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Margin="4">
                            <TextBlock Text="Debit (Debtors)" FontSize="11" Opacity="0.5"/>
                            <TextBlock Text="{Binding TodayTotalDebit, Converter={StaticResource CurrencyConverter}}"
                                       FontSize="16" FontWeight="Bold" Foreground="#E65100"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </materialDesign:Card>

            <!-- Summary Footer -->
            <materialDesign:Card Grid.Row="4" Margin="4,0,4,16" Padding="16"
                                 materialDesign:ElevationAssist.Elevation="Dp1" UniformCornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Total DSM Entries" FontSize="11" Opacity="0.5"/>
                        <TextBlock Text="{Binding TotalDsmEntries}" FontSize="18" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Total Expenses" FontSize="11" Opacity="0.5"/>
                        <TextBlock Text="{Binding TodayTotalExpenses, Converter={StaticResource CurrencyConverter}}"
                                   FontSize="18" FontWeight="Bold" Foreground="#BF360C"/>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </ScrollViewer>
</UserControl>
