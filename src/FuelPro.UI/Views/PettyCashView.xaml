<UserControl x:Class="FuelPro.UI.Views.PettyCashView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:FuelPro.UI.Converters">
    <UserControl.Resources>
        <converters:IndianCurrencyConverter x:Key="CurrencyConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <materialDesign:PackIcon Kind="Wallet" Width="28" Height="28" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Petty Cash Management" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Add cash to petty cash and view log history. Shift-level expenses are automatically logged and deducted from here." FontSize="12" Opacity="0.6"/>
        </StackPanel>

        <!-- Cards Row -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Balance Card -->
            <materialDesign:Card Grid.Column="0" Margin="0,0,12,0" Padding="16" UniformCornerRadius="10" materialDesign:ElevationAssist.Elevation="Dp2" Background="{DynamicResource MaterialDesign.Brush.Primary.Dark}" Foreground="White">
                <StackPanel>
                    <TextBlock Text="CURRENT BALANCE" FontSize="11" FontWeight="SemiBold" Opacity="0.8"/>
                    <TextBlock Text="{Binding Balance, Converter={StaticResource CurrencyConverter}}" FontSize="28" FontWeight="Bold" Margin="0,6,0,0"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- Additions Card -->
            <materialDesign:Card Grid.Column="1" Margin="6,0,6,0" Padding="16" UniformCornerRadius="10" materialDesign:ElevationAssist.Elevation="Dp1">
                <StackPanel>
                    <TextBlock Text="TOTAL ADDITIONS" FontSize="11" FontWeight="SemiBold" Foreground="Green"/>
                    <TextBlock Text="{Binding TotalAdditions, Converter={StaticResource CurrencyConverter}}" FontSize="28" FontWeight="Bold" Margin="0,6,0,0" Foreground="Green"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- Deductions Card -->
            <materialDesign:Card Grid.Column="2" Margin="12,0,0,0" Padding="16" UniformCornerRadius="10" materialDesign:ElevationAssist.Elevation="Dp1">
                <StackPanel>
                    <TextBlock Text="TOTAL DEDUCTIONS" FontSize="11" FontWeight="SemiBold" Foreground="Red"/>
                    <TextBlock Text="{Binding TotalDeductions, Converter={StaticResource CurrencyConverter}, StringFormat='-{0}'}" FontSize="28" FontWeight="Bold" Margin="0,6,0,0" Foreground="Red"/>
                </StackPanel>
            </materialDesign:Card>
        </Grid>

        <!-- Main Body -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="6*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Form -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" MaxHeight="600" Margin="0,0,16,0">
                <materialDesign:Card Padding="24" UniformCornerRadius="10" materialDesign:ElevationAssist.Elevation="Dp1" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Add Cash Addition" FontSize="16" FontWeight="Bold" Margin="0,0,16,16" Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>

                        <DatePicker SelectedDate="{Binding Date}" materialDesign:HintAssist.Hint="Addition Date"
                                    Style="{StaticResource MaterialDesignOutlinedDatePicker}" Margin="0,0,0,14" Height="48"/>

                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Description (e.g. Added by Owner, Opening Cash)"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,14" Height="48"/>

                        <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Amount (₹)"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,24" Height="48"/>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Add Cash" Style="{StaticResource MaterialDesignRaisedButton}"
                                    Command="{Binding SaveAdditionCommand}"
                                    Height="44" Width="140"/>
                            <Button Content="Cancel" Style="{StaticResource MaterialDesignFlatButton}"
                                    Command="{Binding CancelCommand}"
                                    Height="44" Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>
            </ScrollViewer>

            <!-- Right Grid -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Transaction Log History" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" VerticalAlignment="Center"/>
                </Grid>
                
                <DataGrid Grid.Row="1" ItemsSource="{Binding History}" AutoGenerateColumns="False" IsReadOnly="True"
                          materialDesign:DataGridAssist.CellPadding="10 8" VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat='{}{0:dd-MMM-yyyy}'}" Width="110"/>
                        
                        <!-- Type Column with custom cell style to color Addition/Deduction -->
                        <DataGridTemplateColumn Header="Type" Width="95">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Type}" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="Addition">
                                                        <Setter Property="Foreground" Value="Green"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="Deduction">
                                                        <Setter Property="Foreground" Value="Red"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*"/>
                        
                        <!-- Amount Column with colored styles -->
                        <DataGridTemplateColumn Header="Amount" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock FontWeight="SemiBold" HorizontalAlignment="Right">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="Addition">
                                                        <Setter Property="Text" Value="{Binding Amount, Converter={StaticResource CurrencyConverter}}"/>
                                                        <Setter Property="Foreground" Value="Green"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="Deduction">
                                                        <Setter Property="Text" Value="{Binding Amount, Converter={StaticResource CurrencyConverter}}"/>
                                                        <Setter Property="Foreground" Value="Red"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Actions Column enabled only for manual Additions -->
                        <DataGridTemplateColumn Header="Actions" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Delete" Foreground="#D32F2F"
                                            Command="{Binding DataContext.DeleteTransactionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Height="26" Padding="6,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="Deduction">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
