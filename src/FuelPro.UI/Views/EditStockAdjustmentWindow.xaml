<Window x:Class="FuelPro.UI.Views.EditStockAdjustmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Edit Stock Adjustment"
        Width="500" Height="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        FontFamily="{materialDesign:MaterialDesignFont}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <materialDesign:PackIcon Kind="WrenchOutline" Width="26" Height="26" Foreground="#E65100" VerticalAlignment="Center"/>
            <TextBlock Text="Edit Stock Adjustment" FontSize="18" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Form Fields -->
        <StackPanel Grid.Row="1" VerticalAlignment="Top">
            <TextBlock x:Name="ProductLabel" Text="Product: Castrol Oil" FontSize="14" FontWeight="SemiBold" Foreground="#00796B" Margin="0,0,0,12"/>

            <DatePicker x:Name="AdjustmentDatePicker" materialDesign:HintAssist.Hint="Adjustment Date"
                        Margin="0,0,0,14" Height="48"
                        Style="{StaticResource MaterialDesignOutlinedDatePicker}"/>

            <TextBox x:Name="QuantityTextBox" materialDesign:HintAssist.Hint="Adjustment Quantity (+/-)"
                     Margin="0,0,0,14" Height="48"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

            <ComboBox x:Name="TypeComboBox" materialDesign:HintAssist.Hint="Reason / Adjustment Type"
                      Margin="0,0,0,14" Height="48"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"/>

            <TextBox x:Name="RemarksTextBox" materialDesign:HintAssist.Hint="Remarks / Notes"
                     Margin="0,0,0,14" Height="48"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
        </StackPanel>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0"/>
            <Button Content="Save Changes" Click="Save_Click" Style="{StaticResource MaterialDesignRaisedButton}" Background="#E65100" BorderBrush="#E65100"/>
        </StackPanel>
    </Grid>
</Window>
