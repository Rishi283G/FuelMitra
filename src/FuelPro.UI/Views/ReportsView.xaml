<UserControl x:Class="FuelPro.UI.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:FuelPro.UI.Converters">
    <UserControl.Resources>
        <converters:EqualToVisibilityConverter x:Key="EqualToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,24">
            <materialDesign:PackIcon Kind="FileChart" Width="28" Height="28" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="Reporting &amp; Printing Center" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Content Card -->
        <materialDesign:Card Grid.Row="1" MaxWidth="600" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32" UniformCornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp2">
            <StackPanel HorizontalAlignment="Center" Width="450">
                <materialDesign:PackIcon Kind="PrinterEye" Width="80" Height="80" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock Text="Generate &amp; Print Reports" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="Select a report type, configure the date range, and click to print or preview the HTML/PDF format." TextAlignment="Center" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,24" FontSize="13"/>
                
                <!-- Report Type Selection -->
                <ComboBox SelectedValue="{Binding SelectedReportType}" SelectedValuePath="Content"
                          materialDesign:HintAssist.Hint="Report Type" Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Margin="0,0,0,20" Height="48" FontWeight="SemiBold">
                    <ComboBoxItem Content="DSR" ContentStringFormat="Daily Sales Register (DSR)"/>
                    <ComboBoxItem Content="MonthlyPL" ContentStringFormat="Monthly Profit &amp; Loss Statement"/>
                </ComboBox>

                <!-- Conditional Date Selector: DSR (Single Date) -->
                <StackPanel Visibility="{Binding SelectedReportType, Converter={StaticResource EqualToVisibilityConverter}, ConverterParameter=DSR}" Margin="0,0,0,24">
                    <DatePicker SelectedDate="{Binding SelectedDate}" materialDesign:HintAssist.Hint="Select Date"
                                Style="{StaticResource MaterialDesignOutlinedDatePicker}" Height="48"/>
                </StackPanel>

                <!-- Conditional Month/Year Selector: MonthlyPL -->
                <Grid Visibility="{Binding SelectedReportType, Converter={StaticResource EqualToVisibilityConverter}, ConverterParameter=MonthlyPL}" Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear}"
                              materialDesign:HintAssist.Hint="Year" Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              Margin="0,0,6,0" Height="48"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Months}" SelectedItem="{Binding SelectedMonthName}"
                              materialDesign:HintAssist.Hint="Month" Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              Margin="6,0,0,0" Height="48"/>
                </Grid>

                <!-- Buttons Area -->
                <UniformGrid Columns="2" Margin="0,0,0,16">
                    <Button Command="{Binding PrintReportCommand}" Content="Print / PDF" Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="{DynamicResource MaterialDesign.Brush.Primary}" BorderBrush="{DynamicResource MaterialDesign.Brush.Primary}"
                            Margin="4" Height="44"/>
                    
                    <Button Command="{Binding ExportMonthlyReportCommand}" Content="Export Excel" Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="4" Height="44" Foreground="#1B5E20" BorderBrush="#1B5E20"/>
                </UniformGrid>
                
                <!-- Status Message -->
                <TextBlock Text="{Binding StatusMessage}" FontSize="13" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,12,0,0" FontWeight="SemiBold"/>
                
                <ProgressBar IsIndeterminate="{Binding IsLoading}" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource MaterialDesignCircularProgressBar}" Margin="0,12,0,0" HorizontalAlignment="Center" Width="24" Height="24"/>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</UserControl>
