<Window x:Class="FuelPro.UI.Views.DeveloperMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:FuelPro.UI.ViewModels"
        xmlns:converters="clr-namespace:FuelPro.UI.Converters"
        Title="Rashtra Technologies — PyroSync Developer Administrative Tools"
        Width="1100" Height="750" MinWidth="1024" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        Icon="pack://application:,,,/Resources/fuel-pump-icon.ico">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <converters:IntToColorConverter x:Key="IntToColorConverter"/>
        <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>
    </Window.Resources>

    <materialDesign:DialogHost Identifier="DeveloperDialog">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="36"/>
            </Grid.RowDefinitions>

            <!-- Sidebar Navigation (Developer Dark Slate styling) -->
            <Border Grid.Column="0" Grid.RowSpan="2" Background="#263238">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,24,0,0">
                        <materialDesign:PackIcon Kind="ShieldAlert" Width="42" Height="42" Foreground="#FF5252" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="DEVELOPER TOOLS" FontSize="14" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Rashtra Technologies" FontSize="10" Foreground="White" Opacity="0.5" HorizontalAlignment="Center" Margin="0,0,0,24"/>
                    </StackPanel>

                    <!-- Navigation Options -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="8,0">
                        <Button Command="{Binding SelectTabCommand}" CommandParameter="0" ToolTip="User Management" Height="48" Margin="0,2" HorizontalContentAlignment="Left">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatMidBgButton}">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="Opacity" Value="0.6" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedNavIndex}" Value="0">
                                            <Setter Property="Opacity" Value="1" />
                                            <Setter Property="Background" Value="#37474F" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountMultiple" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="User Profiles" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding SelectTabCommand}" CommandParameter="1" ToolTip="Cloud Credentials" Height="48" Margin="0,2" HorizontalContentAlignment="Left">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatMidBgButton}">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="Opacity" Value="0.6" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedNavIndex}" Value="1">
                                            <Setter Property="Opacity" Value="1" />
                                            <Setter Property="Background" Value="#37474F" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CloudKey" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Cloud Config" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding SelectTabCommand}" CommandParameter="2" ToolTip="Diagnostics &amp; Sync Engine" Height="48" Margin="0,2" HorizontalContentAlignment="Left">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatMidBgButton}">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="Opacity" Value="0.6" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedNavIndex}" Value="2">
                                            <Setter Property="Opacity" Value="1" />
                                            <Setter Property="Background" Value="#37474F" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="DatabaseSearch" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Diagnostics &amp; Logs" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding SelectTabCommand}" CommandParameter="3" ToolTip="License Key Status" Height="48" Margin="0,2" HorizontalContentAlignment="Left">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatMidBgButton}">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="Opacity" Value="0.6" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedNavIndex}" Value="3">
                                            <Setter Property="Opacity" Value="1" />
                                            <Setter Property="Background" Value="#37474F" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Key" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Licensing Status" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SelectTabCommand}" CommandParameter="4" ToolTip="Data Integrity Scanner" Height="48" Margin="0,2" HorizontalContentAlignment="Left">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatMidBgButton}">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="Opacity" Value="0.6" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedNavIndex}" Value="4">
                                            <Setter Property="Opacity" Value="1" />
                                            <Setter Property="Background" Value="#37474F" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IntegrityHasIssues}" Value="True">
                                            <Setter Property="Foreground" Value="#FFEB3B" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="DatabaseCheck" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Data Integrity" FontSize="13" VerticalAlignment="Center"/>
                                <Border Background="#E53935" CornerRadius="8" Padding="5,1" Margin="8,0,0,0"
                                        Visibility="{Binding IntegrityHasIssues, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="!" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </StackPanel>
                        </Button>

                        <!-- Tab 5: Client Features -->
                        <Button Command="{Binding SelectTabCommand}" CommandParameter="5" ToolTip="Client Features &amp; Page Matrix" Height="48" Margin="0,2" HorizontalContentAlignment="Left">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatMidBgButton}">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="Opacity" Value="0.6" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedNavIndex}" Value="5">
                                            <Setter Property="Opacity" Value="1" />
                                            <Setter Property="Background" Value="#37474F" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TuneVariant" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Client Features" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Tab 6: Station & Collections -->
                        <Button Command="{Binding SelectTabCommand}" CommandParameter="6" ToolTip="Station Layout, Pumps, Tanks &amp; Collections" Height="48" Margin="0,2" HorizontalContentAlignment="Left">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatMidBgButton}">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="Opacity" Value="0.6" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedNavIndex}" Value="6">
                                            <Setter Property="Opacity" Value="1" />
                                            <Setter Property="Background" Value="#37474F" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="GasStation" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Station &amp; Collections" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    </ScrollViewer>


                    <Button Grid.Row="2" Command="{Binding ExitCommand}" Content="Exit Tools" Margin="16,0,16,24" Height="40" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="White" BorderBrush="White" Opacity="0.5"/>
                </Grid>
            </Border>

            <!-- Main Workspace Area -->
            <TabControl Grid.Column="1" Grid.Row="0" SelectedIndex="{Binding SelectedNavIndex}" BorderThickness="0" Background="Transparent" Padding="24,16">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </TabControl.ItemContainerStyle>

                <!-- Tab 0: User Management -->
                <TabItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="User Management" FontSize="24" FontWeight="Bold" Foreground="#37474F" Margin="0,0,0,16"/>

                        <!-- Grid representing users list -->
                        <materialDesign:Card Grid.Row="1" Padding="16" UniformCornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp2" Margin="0,0,0,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Active Accounts" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding Users}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="300" materialDesign:DataGridAssist.CellPadding="12 8">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="User ID" Binding="{Binding UserId}" Width="80"/>
                                        <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="*"/>
                                        <DataGridTextColumn Header="Assigned Role" Binding="{Binding Role}" Width="150"/>
                                        
                                        <DataGridTemplateColumn Header="Active" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ToggleButton IsChecked="{Binding IsActive, Mode=OneWay}"
                                                                  Command="{Binding DataContext.ToggleUserActiveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding}"
                                                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="Actions" Width="180">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Reset PIN" Style="{StaticResource MaterialDesignOutlinedButton}" Height="28" Padding="12,0" FontSize="11"
                                                            Command="{Binding DataContext.ResetUserPinCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            IsEnabled="{Binding IsDeveloper, Converter={StaticResource InverseBoolConverter}}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </materialDesign:Card>

                        <!-- Add User -->
                        <materialDesign:Card Grid.Row="2" Padding="16" UniformCornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp2">
                            <StackPanel>
                                <TextBlock Text="Create Security Profile" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                                             materialDesign:HintAssist.Hint="Username" materialDesign:HintAssist.IsFloating="True"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                    <TextBox Grid.Column="1" Text="{Binding NewPin, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,8,0"
                                             materialDesign:HintAssist.Hint="PIN" materialDesign:HintAssist.IsFloating="True"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                    <ComboBox Grid.Column="2" ItemsSource="{Binding RoleOptions}" SelectedItem="{Binding NewRole}" Margin="8,0,0,0"
                                              materialDesign:HintAssist.Hint="System Role" materialDesign:HintAssist.IsFloating="True"
                                              Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Generate Account" Command="{Binding CreateUserCommand}" Height="40" Padding="24,0" Style="{StaticResource MaterialDesignRaisedButton}"/>
                                    <TextBlock Text="{Binding UserStatusMessage}" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="13" FontWeight="SemiBold" Foreground="#D32F2F"/>
                                </StackPanel>
                            </StackPanel>
                        </materialDesign:Card>
                    </Grid>
                </TabItem>

                <!-- Tab 1: Cloud Configuration -->
                <TabItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Cloud Synchronization settings" FontSize="24" FontWeight="Bold" Foreground="#37474F" Margin="0,0,0,16"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <materialDesign:Card Padding="24" UniformCornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp2" VerticalAlignment="Top">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <materialDesign:PackIcon Kind="CloudSync" Width="24" Height="24" Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                    <TextBlock Text="Protected Credentials" FontSize="18" FontWeight="SemiBold" Margin="8,0"/>
                                </StackPanel>

                                <!-- Notice/Warning -->
                                <Border Background="#FFF3E0" BorderBrush="#FFE0B2" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,24">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Alert" Width="20" Height="20" Foreground="#E65100" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <TextBlock Text="Production sync configuration is locked by default. Click 'Unlock Configuration' to perform modifications." VerticalAlignment="Center" Foreground="#E65100" FontWeight="SemiBold" FontSize="12"/>
                                    </StackPanel>
                                </Border>

                                <!-- Supabase Settings Row -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding SupabaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{Binding IsConfigLocked}"
                                             materialDesign:HintAssist.Hint="Supabase URL" materialDesign:HintAssist.IsFloating="True"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                </Grid>

                                 <TextBox Text="{Binding SupabaseApiKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"
                                          IsReadOnly="{Binding IsConfigLocked}"
                                          materialDesign:HintAssist.Hint="Supabase Anon API Key" materialDesign:HintAssist.IsFloating="True"
                                          Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                                 <TextBox Text="{Binding SupabaseServiceRoleKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"
                                          IsReadOnly="{Binding IsConfigLocked}"
                                          materialDesign:HintAssist.Hint="Supabase Service Role Key (Admin)" materialDesign:HintAssist.IsFloating="True"
                                          Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                                <!-- Station ID with Copy & Generate -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding StationId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                                             IsReadOnly="{Binding IsConfigLocked}"
                                             materialDesign:HintAssist.Hint="Station ID (Shared Pump Identity)" materialDesign:HintAssist.IsFloating="True"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                    <Button Grid.Column="1" Content="Copy" Command="{Binding CopyStationIdCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="50" Margin="0,0,8,0" Padding="16,0" VerticalAlignment="Center"/>
                                    <Button Grid.Column="2" Content="Generate ID" Command="{Binding GenerateStationIdCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="50" Padding="16,0" VerticalAlignment="Center"
                                            IsEnabled="{Binding IsConfigLocked, Converter={StaticResource InverseBoolConverter}}"/>
                                </Grid>

                                <!-- Machine ID (Read-only) -->
                                <TextBox Text="{Binding MachineId, Mode=OneWay}" Margin="0,0,0,16"
                                         IsReadOnly="True"
                                         materialDesign:HintAssist.Hint="Machine ID (Read-only Device Identity)" materialDesign:HintAssist.IsFloating="True"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                                <CheckBox Content="Enable Cloud Sync Pipeline" IsChecked="{Binding SyncEnabled}" 
                                          IsEnabled="{Binding IsConfigLocked, Converter={StaticResource InverseBoolConverter}}"
                                          Margin="0,0,0,24" FontSize="14" FontWeight="SemiBold"/>

                                <!-- Dedicated Connection Status Panel -->
                                <Border BorderThickness="1" BorderBrush="#CFD8DC" CornerRadius="8" Padding="16" Margin="0,0,0,24" Background="#ECEFF1">
                                    <StackPanel>
                                        <TextBlock Text="Station Connection Info" FontSize="14" FontWeight="Bold" Foreground="#37474F" Margin="0,0,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Cloud Status:" FontSize="11" Opacity="0.6"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="#D32F2F"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCloudConnected}" Value="True">
                                                                        <Setter Property="Fill" Value="#388E3C"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock FontSize="13" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Offline"/>
                                                                <Setter Property="Foreground" Value="#D32F2F"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCloudConnected}" Value="True">
                                                                        <Setter Property="Text" Value="Connected to Cloud ✓"/>
                                                                        <Setter Property="Foreground" Value="#388E3C"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Local Machine Identity:" FontSize="11" Opacity="0.6"/>
                                                <TextBlock Text="{Binding MachineId}" FontSize="13" FontWeight="Bold" Foreground="#37474F" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                        <Separator Margin="0,12" Background="#CFD8DC"/>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="GasStation" Width="16" Height="16" Foreground="#37474F" VerticalAlignment="Center"/>
                                            <TextBlock Text="Current Station ID: " FontSize="12" Foreground="#37474F" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                            <TextBlock Text="{Binding StationId}" FontSize="12" FontWeight="Bold" Foreground="#37474F" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Unlock Settings" Command="{Binding UnlockConfigurationCommand}" Height="40" Padding="20,0" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,12,0" 
                                            Visibility="{Binding IsConfigLocked, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <Button Content="Save Credentials" Command="{Binding SaveCloudConfigCommand}" Height="40" Padding="24,0" Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,12,0"
                                            IsEnabled="{Binding IsConfigLocked, Converter={StaticResource InverseBoolConverter}}"/>
                                    <Button Content="Test Connection" Command="{Binding TestConnectionCommand}" Height="40" Padding="20,0" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,16,0"
                                            IsEnabled="{Binding IsConfigLocked, Converter={StaticResource InverseBoolConverter}}"/>
                                    <TextBlock Text="{Binding ConfigStatusMessage}" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                            </StackPanel>
                                </materialDesign:Card>

                                <!-- Application Branding -->
                                <materialDesign:Card Padding="24" UniformCornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp2" Margin="0,16,0,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                            <materialDesign:PackIcon Kind="ImageEdit" Width="24" Height="24" Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                            <TextBlock Text="Application Branding" FontSize="18" FontWeight="SemiBold" Margin="8,0"/>
                                        </StackPanel>

                                        <!-- Light Logo Path -->
                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding ApplicationLogoPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                                                     materialDesign:HintAssist.Hint="Application Light Logo Path" materialDesign:HintAssist.IsFloating="True"
                                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                            <Button Grid.Column="1" Content="Browse" Command="{Binding BrowseLogoCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="50" Padding="16,0" VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Dark Logo Path -->
                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding ApplicationLogoDarkPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                                                     materialDesign:HintAssist.Hint="Application Dark Logo Path" materialDesign:HintAssist.IsFloating="True"
                                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                            <Button Grid.Column="1" Content="Browse" Command="{Binding BrowseDarkLogoCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="50" Padding="16,0" VerticalAlignment="Center"/>
                                        </Grid>

                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Save Logo Paths" Command="{Binding SaveLogoPathCommand}" Height="40" Padding="24,0" Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,16,0"/>
                                            <TextBlock Text="{Binding LogoStatusMessage}" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </StackPanel>
                                </materialDesign:Card>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!-- Tab 2: Diagnostics & Logs -->
                <TabItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Diagnostics Control Hub" FontSize="24" FontWeight="Bold" Foreground="#37474F" Margin="0,0,0,16"/>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left column: Db Counts & Info -->
                            <StackPanel Grid.Column="0">
                                <materialDesign:Card Padding="16" UniformCornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp2" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Sync Dashboard" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                        <Grid Margin="0,0,0,8">
                                            <TextBlock Text="Connection Status:" Opacity="0.6" FontSize="12"/>
                                            <TextBlock Text="{Binding ConnectionStatus}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#388E3C"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <TextBlock Text="Last Sync Time:" Opacity="0.6" FontSize="12"/>
                                            <TextBlock Text="{Binding LastSyncTime}" HorizontalAlignment="Right" FontWeight="Bold"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,16">
                                            <TextBlock Text="Pending Logs:" Opacity="0.6" FontSize="12"/>
                                            <TextBlock Text="{Binding PendingRecords}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#F57C00"/>
                                        </Grid>
                                        
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                            <Button Content="Sync Now" Command="{Binding ForceSyncNowCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="32" Padding="12,0" FontSize="11" Margin="0,0,8,0"/>
                                            <Button Content="Retry Failed" Command="{Binding RetryFailedSyncCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="32" Padding="12,0" FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>
                                </materialDesign:Card>

                                <materialDesign:Card Padding="16" UniformCornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp2" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Database Record Counts" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <DataGrid Grid.Row="1" ItemsSource="{Binding TableCounts}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="280" materialDesign:DataGridAssist.CellPadding="8 4">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Table" Binding="{Binding TableName}" Width="*"/>
                                                <DataGridTextColumn Header="Records" Binding="{Binding Count}" Width="80"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </materialDesign:Card>

                                <Button Content="Force Full Resync" Command="{Binding ForceFullResyncCommand}" Height="40" Style="{StaticResource MaterialDesignRaisedButton}" Background="#D32F2F" BorderBrush="#D32F2F" Foreground="White" Width="200" HorizontalAlignment="Left"/>
                            </StackPanel>

                            <!-- Right column: Log Viewer -->
                            <materialDesign:Card Grid.Column="2" Padding="16" UniformCornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp2">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                        <TextBlock Text="Recent Logs Viewer (app-.log)" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Button Content="Refresh Logs" Command="{Binding LoadSyncLogsCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="28" Padding="12,0" FontSize="11" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <TextBox Grid.Row="1" Text="{Binding SyncLogsText, Mode=OneWay}" IsReadOnly="True" 
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             AcceptsReturn="True" TextWrapping="NoWrap"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                             FontFamily="Consolas" FontSize="11" Margin="0,4,0,0"
                                             Height="460" VerticalAlignment="Stretch"/>
                                </Grid>
                            </materialDesign:Card>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- Tab 3: License Management -->
                <TabItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Licensing Status" FontSize="24" FontWeight="Bold" Foreground="#37474F" Margin="0,0,0,16"/>

                        <materialDesign:Card Grid.Row="1" Padding="24" UniformCornerRadius="16" Background="White" materialDesign:ElevationAssist.Elevation="Dp2" VerticalAlignment="Top">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <materialDesign:PackIcon Kind="Key" Width="28" Height="28" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Product Licensing Status" FontSize="20" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Grid Margin="0,0,0,24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Status:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LicenseStatus}" Foreground="#388E3C" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Product Name:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LicenseProductName}" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Customer Name:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding LicenseCustomerName}" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Business/Pump Name:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding LicenseBusinessName}" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Mobile Number:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding LicenseMobileNumber}" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="10" Grid.Column="0" Text="License Type:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding LicenseType}" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="12" Grid.Column="0" Text="Activation Date:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="12" Grid.Column="1" Text="{Binding LicenseActivationDate}" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="14" Grid.Column="0" Text="Expiry Date:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="14" Grid.Column="1" Text="{Binding LicenseExpiryDate}" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="16" Grid.Column="0" Text="Device ID:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="16" Grid.Column="1" Text="{Binding LicenseDeviceId, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" VerticalAlignment="Center"/>
                                </Grid>

                                <Button Content="Copy Activation Details" Command="{Binding CopyLicenseInfoCommand}" Height="40" Padding="24,0" Style="{StaticResource MaterialDesignRaisedButton}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </materialDesign:Card>
                    </Grid>
                </TabItem>

                <!-- Tab 4: Data Integrity -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,16,24">

                            <!-- Header -->
                            <TextBlock Text="Data Integrity" FontSize="24" FontWeight="Bold" Foreground="#37474F" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding IntegrityScanTimestamp}" FontSize="12" Foreground="#90A4AE" Margin="0,0,0,16"/>

                            <!-- Action bar -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Button Command="{Binding RunIntegrityScanCommand}"
                                        IsEnabled="{Binding IsRunningIntegrityScan, Converter={StaticResource InverseBoolConverter}}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Background="#1565C0" Foreground="White" Height="36" Padding="16,0" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="DatabaseSearch" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Run Full Scan" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <materialDesign:Card Padding="12,8" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp1"
                                                     Visibility="{Binding IsRunningIntegrityScan, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <ProgressBar IsIndeterminate="True" Width="20" Height="20" Margin="0,0,10,0"
                                                     Style="{StaticResource MaterialDesignCircularProgressBar}" Value="0"/>
                                        <TextBlock Text="Scanning..." VerticalAlignment="Center" FontSize="12"/>
                                    </StackPanel>
                                </materialDesign:Card>
                            </StackPanel>

                            <!-- Status message -->
                            <materialDesign:Card Padding="14,10" UniformCornerRadius="8" Margin="0,0,0,16"
                                                 materialDesign:ElevationAssist.Elevation="Dp1">
                                <TextBlock Text="{Binding IntegrityScanMessage}" FontSize="13" TextWrapping="Wrap"
                                           Foreground="#37474F" FontWeight="SemiBold"/>
                            </materialDesign:Card>

                            <!-- Summary cards -->
                            <UniformGrid Columns="5" Margin="0,0,0,20">
                                <!-- DSM Duplicates -->
                                <materialDesign:Card Margin="0,0,8,0" Padding="16,12" UniformCornerRadius="10" materialDesign:ElevationAssist.Elevation="Dp2">
                                    <StackPanel>
                                        <TextBlock Text="DSM Duplicates" FontSize="11" Foreground="#78909C" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding IntegrityDsmDuplicates}" FontSize="28" FontWeight="Bold"
                                                   Foreground="{Binding IntegrityDsmDuplicates, Converter={StaticResource IntToColorConverter}, ConverterParameter=red}"/>
                                    </StackPanel>
                                </materialDesign:Card>
                                <!-- Debit Duplicates -->
                                <materialDesign:Card Margin="0,0,8,0" Padding="16,12" UniformCornerRadius="10" materialDesign:ElevationAssist.Elevation="Dp2">
                                    <StackPanel>
                                        <TextBlock Text="Debit Duplicates" FontSize="11" Foreground="#78909C" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding IntegrityDebitDuplicates}" FontSize="28" FontWeight="Bold"
                                                   Foreground="{Binding IntegrityDebitDuplicates, Converter={StaticResource IntToColorConverter}, ConverterParameter=orange}"/>
                                    </StackPanel>
                                </materialDesign:Card>
                                <!-- Repayment Duplicates -->
                                <materialDesign:Card Margin="0,0,8,0" Padding="16,12" UniformCornerRadius="10" materialDesign:ElevationAssist.Elevation="Dp2">
                                    <StackPanel>
                                        <TextBlock Text="Repayment Dupes" FontSize="11" Foreground="#78909C" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding IntegrityRepaymentDuplicates}" FontSize="28" FontWeight="Bold"
                                                   Foreground="{Binding IntegrityRepaymentDuplicates, Converter={StaticResource IntToColorConverter}, ConverterParameter=orange}"/>
                                    </StackPanel>
                                </materialDesign:Card>
                                <!-- Orphans -->
                                <materialDesign:Card Margin="0,0,8,0" Padding="16,12" UniformCornerRadius="10" materialDesign:ElevationAssist.Elevation="Dp2">
                                    <StackPanel>
                                        <TextBlock Text="Orphan Records" FontSize="11" Foreground="#78909C" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding IntegrityOrphans}" FontSize="28" FontWeight="Bold"
                                                   Foreground="{Binding IntegrityOrphans, Converter={StaticResource IntToColorConverter}, ConverterParameter=orange}"/>
                                    </StackPanel>
                                </materialDesign:Card>
                                <!-- Broken FKs -->
                                <materialDesign:Card Padding="16,12" UniformCornerRadius="10" materialDesign:ElevationAssist.Elevation="Dp2">
                                    <StackPanel>
                                        <TextBlock Text="Broken FK" FontSize="11" Foreground="#78909C" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding IntegrityBrokenFks}" FontSize="28" FontWeight="Bold"
                                                   Foreground="{Binding IntegrityBrokenFks, Converter={StaticResource IntToColorConverter}, ConverterParameter=red}"/>
                                    </StackPanel>
                                </materialDesign:Card>
                            </UniformGrid>

                            <!-- Recent DSM Entries Inspector & Repair Tools -->
                            <materialDesign:Card Padding="16" UniformCornerRadius="12" Margin="0,0,0,16"
                                                 materialDesign:ElevationAssist.Elevation="Dp2">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="DatabaseEdit" Width="20" Height="20" Margin="0,0,8,0"
                                                                      Foreground="#1565C0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Recent DSM Entries (Inspector &amp; Repair)" FontSize="15" FontWeight="Bold"
                                                       Foreground="#37474F" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <TextBox Grid.Column="2" Text="{Binding DsmSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="16,0,8,0" Padding="8,4" Height="32"
                                                 materialDesign:HintAssist.Hint="Filter Name/Date/Pump..."
                                                 materialDesign:HintAssist.IsFloating="False"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                                        <Button Grid.Column="3" Command="{Binding LoadRecentDsmEntriesCommand}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Height="32" Padding="12,0" FontSize="11">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Refresh List" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <DataGrid ItemsSource="{Binding FilteredRecentDsmEntries}" AutoGenerateColumns="False"
                                              IsReadOnly="True" MaxHeight="300"
                                              materialDesign:DataGridAssist.CellPadding="10 6">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="ID" Binding="{Binding IdDisplay}" Width="70"/>
                                            <DataGridTextColumn Header="Date / Shift" Binding="{Binding ShiftDate, StringFormat='dd-MMM-yyyy'}" Width="110"/>
                                            <DataGridTextColumn Header="DSM Name" Binding="{Binding DsmName}" Width="110" FontWeight="Bold"/>
                                            <DataGridTextColumn Header="Pump" Binding="{Binding PumpLabel}" Width="75"/>
                                            <DataGridTextColumn Header="Origin" Binding="{Binding Origin}" Width="100"/>
                                            <DataGridTextColumn Header="Gross Sale" Binding="{Binding GrossSales, StringFormat='₹#,##0.00'}" Width="100" FontWeight="SemiBold"/>
                                            <DataGridTextColumn Header="Collection" Binding="{Binding TotalCollection, StringFormat='₹#,##0.00'}" Width="100"/>
                                            <DataGridTextColumn Header="Mismatch" Binding="{Binding Mismatch, StringFormat='₹#,##0.00'}" Width="90"/>

                                            <DataGridTemplateColumn Header="Status / Warning" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <materialDesign:PackIcon Kind="AlertCircle" Width="14" Height="14" Margin="0,0,4,0" Foreground="#E53935"
                                                                                      Visibility="{Binding HasCorruption, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                            <TextBlock Text="{Binding StatusMessage}" FontSize="11" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasCorruption}" Value="True">
                                                                                <Setter Property="Foreground" Value="#E53935"/>
                                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTemplateColumn Header="Actions" Width="160">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <Button Content="Fix"
                                                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                                                    Foreground="#1565C0" BorderBrush="#1565C0"
                                                                    Height="24" Padding="8,0" FontSize="10" Margin="0,0,6,0"
                                                                    Command="{Binding DataContext.FixCorruptedDsmEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"/>
                                                            <Button Content="Delete"
                                                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                                                    Foreground="#E53935" BorderBrush="#E53935"
                                                                    Height="24" Padding="8,0" FontSize="10"
                                                                    Command="{Binding DataContext.DeleteAnyDsmEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </materialDesign:Card>

                            <!-- DSM Entry Duplicates -->
                            <materialDesign:Card Padding="16" UniformCornerRadius="12" Margin="0,0,0,16"
                                                 materialDesign:ElevationAssist.Elevation="Dp2"
                                                 Visibility="{Binding IntegrityDsmDuplicates, Converter={StaticResource IntToVisibilityConverter}}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="ContentDuplicate" Width="18" Height="18" Margin="0,0,8,0"
                                                                      Foreground="#E53935" VerticalAlignment="Center"/>
                                            <TextBlock Text="Duplicate DSM Entries" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="#E53935" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <CheckBox Content="Select All"
                                                      IsChecked="{Binding IsAllDsmSelected, Mode=TwoWay}"
                                                      VerticalAlignment="Center" Margin="0,0,16,0"
                                                      FontSize="12" Foreground="#37474F"/>
                                            <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                                    Background="#E53935" BorderBrush="#E53935" Foreground="White"
                                                    Height="28" Padding="10,0" FontSize="11" Margin="0,0,8,0"
                                                    Command="{Binding DeleteSelectedDsmEntriesCommand}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="DeleteSweep" Width="14" Height="14" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding SelectedDsmCount, StringFormat='Delete Selected ({0})'}"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Content="Delete ALL Duplicates"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                                    Foreground="#E53935" BorderBrush="#E53935"
                                                    Height="28" Padding="10,0" FontSize="11"
                                                    Command="{Binding DeleteAllDsmEntriesCommand}"/>
                                        </StackPanel>
                                    </Grid>
                                    <DataGrid ItemsSource="{Binding DuplicateDsmGroups}" AutoGenerateColumns="False"
                                              IsReadOnly="True" MaxHeight="240"
                                              materialDesign:DataGridAssist.CellPadding="10 6">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Width="45">
                                                <DataGridTemplateColumn.Header>
                                                    <CheckBox IsChecked="{Binding DataContext.IsAllDsmSelected, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </DataGridTemplateColumn.Header>
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Business Key" Binding="{Binding BusinessKey}" Width="*"/>
                                            <DataGridTextColumn Header="Original ID" Binding="{Binding OriginalEntryId}" Width="90"/>
                                            <DataGridTextColumn Header="Duplicate ID" Binding="{Binding DuplicateEntryId}" Width="90"/>
                                            <DataGridTextColumn Header="Dup Created" Binding="{Binding DuplicateCreatedAt, StringFormat=dd-MMM-yy HH:mm}" Width="130"/>
                                            <DataGridTextColumn Header="Nozzles" Binding="{Binding DuplicateNozzleCount}" Width="65"/>
                                            <DataGridTextColumn Header="Debits" Binding="{Binding DuplicateDebitCount}" Width="55"/>
                                            <DataGridTextColumn Header="Has Payment" Binding="{Binding DuplicateHasPayment}" Width="90"/>
                                            <DataGridTemplateColumn Header="Action" Width="120">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="Delete Duplicate"
                                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                                Foreground="#E53935" BorderBrush="#E53935"
                                                                Height="26" Padding="8,0" FontSize="11"
                                                                Command="{Binding DataContext.DeleteDuplicateDsmEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </materialDesign:Card>

                            <!-- Debit Entry Duplicates -->
                            <materialDesign:Card Padding="16" UniformCornerRadius="12" Margin="0,0,0,16"
                                                 materialDesign:ElevationAssist.Elevation="Dp2"
                                                 Visibility="{Binding IntegrityDebitDuplicates, Converter={StaticResource IntToVisibilityConverter}}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="ContentDuplicate" Width="18" Height="18" Margin="0,0,8,0"
                                                                      Foreground="#F57C00" VerticalAlignment="Center"/>
                                            <TextBlock Text="Duplicate Debit Entries" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="#F57C00" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <CheckBox Content="Select All"
                                                      IsChecked="{Binding IsAllDebitSelected, Mode=TwoWay}"
                                                      VerticalAlignment="Center" Margin="0,0,16,0"
                                                      FontSize="12" Foreground="#37474F"/>
                                            <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                                    Background="#F57C00" BorderBrush="#F57C00" Foreground="White"
                                                    Height="28" Padding="10,0" FontSize="11" Margin="0,0,8,0"
                                                    Command="{Binding DeleteSelectedDebitGroupsCommand}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="DeleteSweep" Width="14" Height="14" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding SelectedDebitCount, StringFormat='Delete Selected ({0})'}"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Content="Delete ALL Duplicates"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                                    Foreground="#F57C00" BorderBrush="#F57C00"
                                                    Height="28" Padding="10,0" FontSize="11"
                                                    Command="{Binding DeleteAllDebitGroupsCommand}"/>
                                        </StackPanel>
                                    </Grid>
                                    <DataGrid ItemsSource="{Binding DuplicateDebitGroups}" AutoGenerateColumns="False"
                                              IsReadOnly="True" MaxHeight="200"
                                              materialDesign:DataGridAssist.CellPadding="10 6">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Width="45">
                                                <DataGridTemplateColumn.Header>
                                                    <CheckBox IsChecked="{Binding DataContext.IsAllDebitSelected, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </DataGridTemplateColumn.Header>
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="DsmEntry ID" Binding="{Binding DsmEntryId}" Width="90"/>
                                            <DataGridTextColumn Header="Debtor" Binding="{Binding DebtorName}" Width="*"/>
                                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat='₹#,##0.00'}" Width="110"/>
                                            <DataGridTextColumn Header="Dupe Count" Binding="{Binding DuplicateCount}" Width="80"/>
                                            <DataGridTemplateColumn Header="Action" Width="120">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="Delete Dupes"
                                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                                Foreground="#F57C00" BorderBrush="#F57C00"
                                                                Height="26" Padding="8,0" FontSize="11"
                                                                Command="{Binding DataContext.DeleteDuplicateDebitGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </materialDesign:Card>

                            <!-- Repayment Duplicates -->
                            <materialDesign:Card Padding="16" UniformCornerRadius="12" Margin="0,0,0,16"
                                                 materialDesign:ElevationAssist.Elevation="Dp2"
                                                 Visibility="{Binding IntegrityRepaymentDuplicates, Converter={StaticResource IntToVisibilityConverter}}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="ContentDuplicate" Width="18" Height="18" Margin="0,0,8,0"
                                                                      Foreground="#F57C00" VerticalAlignment="Center"/>
                                            <TextBlock Text="Duplicate Creditor Repayments" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="#F57C00" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <CheckBox Content="Select All"
                                                      IsChecked="{Binding IsAllRepaymentSelected, Mode=TwoWay}"
                                                      VerticalAlignment="Center" Margin="0,0,16,0"
                                                      FontSize="12" Foreground="#37474F"/>
                                            <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                                    Background="#F57C00" BorderBrush="#F57C00" Foreground="White"
                                                    Height="28" Padding="10,0" FontSize="11" Margin="0,0,8,0"
                                                    Command="{Binding DeleteSelectedRepaymentGroupsCommand}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="DeleteSweep" Width="14" Height="14" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding SelectedRepaymentCount, StringFormat='Delete Selected ({0})'}"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Content="Delete ALL Duplicates"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                                    Foreground="#F57C00" BorderBrush="#F57C00"
                                                    Height="28" Padding="10,0" FontSize="11"
                                                    Command="{Binding DeleteAllRepaymentGroupsCommand}"/>
                                        </StackPanel>
                                    </Grid>
                                    <DataGrid ItemsSource="{Binding DuplicateRepaymentGroups}" AutoGenerateColumns="False"
                                              IsReadOnly="True" MaxHeight="200"
                                              materialDesign:DataGridAssist.CellPadding="10 6">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Width="45">
                                                <DataGridTemplateColumn.Header>
                                                    <CheckBox IsChecked="{Binding DataContext.IsAllRepaymentSelected, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </DataGridTemplateColumn.Header>
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Creditor" Binding="{Binding CreditorName}" Width="*"/>
                                            <DataGridTextColumn Header="Date" Binding="{Binding RepaymentDate, StringFormat=dd-MMM-yy}" Width="90"/>
                                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat='₹#,##0.00'}" Width="110"/>
                                            <DataGridTextColumn Header="Mode" Binding="{Binding PaymentMode}" Width="80"/>
                                            <DataGridTextColumn Header="Dupes" Binding="{Binding DuplicateCount}" Width="60"/>
                                            <DataGridTemplateColumn Header="Action" Width="120">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="Delete Dupes"
                                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                                Foreground="#F57C00" BorderBrush="#F57C00"
                                                                Height="26" Padding="8,0" FontSize="11"
                                                                Command="{Binding DataContext.DeleteDuplicateRepaymentGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </materialDesign:Card>

                            <!-- Orphan Records -->
                            <materialDesign:Card Padding="16" UniformCornerRadius="12" Margin="0,0,0,16"
                                                 materialDesign:ElevationAssist.Elevation="Dp2"
                                                 Visibility="{Binding IntegrityOrphans, Converter={StaticResource IntToVisibilityConverter}}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="LinkOff" Width="18" Height="18" Margin="0,0,8,0"
                                                                      Foreground="#F57C00" VerticalAlignment="Center"/>
                                            <TextBlock Text="Orphan Child Records" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="#F57C00" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button HorizontalAlignment="Right"
                                                Content="Delete All Orphans"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Foreground="#E53935" BorderBrush="#E53935"
                                                Height="30" Padding="12,0" FontSize="11"
                                                Command="{Binding DeleteAllOrphansCommand}"/>
                                    </Grid>
                                    <DataGrid ItemsSource="{Binding OrphanRecords}" AutoGenerateColumns="False"
                                              IsReadOnly="True" MaxHeight="200"
                                              materialDesign:DataGridAssist.CellPadding="10 6">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Entity Type" Binding="{Binding EntityType}" Width="140"/>
                                            <DataGridTextColumn Header="ID" Binding="{Binding EntityId}" Width="70"/>
                                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </materialDesign:Card>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Tab 5: Client Features & Page Access Matrix -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="False" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                        <StackPanel Margin="0,0,0,24">
                            <!-- Header & Action Bar -->
                            <materialDesign:Card Padding="16,12" Margin="0,0,0,16" Background="#263238">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <materialDesign:PackIcon Kind="TuneVariant" Width="22" Height="22" Foreground="#80CBC4" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Client Features &amp; Page Access Matrix" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Enable or disable individual pages and modules independently for Manager, Owner, and Integrations." FontSize="12" Foreground="#CFD8DC"/>
                                        <TextBlock Text="{Binding FeatureStatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="#80CBC4" Margin="0,6,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Filter Role:" Foreground="#ECEFF1" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                                        <ComboBox ItemsSource="{Binding FeatureRoleFilterOptions}" SelectedItem="{Binding SelectedFeatureRoleFilter}"
                                                  Width="110" Height="32" Foreground="White" Background="#37474F" Margin="0,0,12,0"/>

                                        <Button Content="Current Client Preset" Command="{Binding ApplyClientPresetCommand}" CommandParameter="CurrentClient"
                                                Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#80CBC4" BorderBrush="#80CBC4"
                                                Height="32" Padding="10,0" Margin="0,0,8,0" FontSize="11"/>

                                        <Button Content="All Features On" Command="{Binding ApplyClientPresetCommand}" CommandParameter="Full"
                                                Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#ECEFF1" BorderBrush="#ECEFF1"
                                                Height="32" Padding="10,0" Margin="0,0,12,0" FontSize="11"/>

                                        <Button Content="Save All Features" Command="{Binding SaveFeaturesCommand}"
                                                Style="{StaticResource MaterialDesignRaisedButton}" Background="#00897B" BorderBrush="#00897B" Foreground="White"
                                                Height="34" Padding="16,0" FontSize="12" FontWeight="Bold"/>
                                    </StackPanel>
                                </Grid>
                            </materialDesign:Card>

                            <!-- Feature Settings Table -->
                            <materialDesign:Card Padding="0" Background="#263238">
                                <DataGrid ItemsSource="{Binding FilteredFeatureSettings}" AutoGenerateColumns="False"
                                          CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#37474F" Background="Transparent" Foreground="White"
                                          RowBackground="#263238" AlternatingRowBackground="#1E272C"
                                          materialDesign:DataGridAssist.CellPadding="12 10" FontSize="13">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                            <Setter Property="Background" Value="#1A2327"/>
                                            <Setter Property="Foreground" Value="#80CBC4"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Padding" Value="12,8"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Role" Binding="{Binding TargetRole}" Width="100" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#ECEFF1"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="140" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#CFD8DC"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Feature / Page Name (Editable)" Binding="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Width="240" IsReadOnly="False">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="Foreground" Value="#81C784"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                            <DataGridTextColumn.EditingElementStyle>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="Background" Value="#1E272C"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </Style>
                                            </DataGridTextColumn.EditingElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Description / Purpose" Binding="{Binding Description}" Width="*" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#ECEFF1"/>
                                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn Header="Enabled" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              Style="{StaticResource MaterialDesignFilterChipPrimaryCheckBox}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </materialDesign:Card>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Tab 6: Station Layout & Dynamic Collections Master -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="False" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                        <StackPanel Margin="0,0,0,24">
                            <!-- Section 1: Station Operational Entities (Pumps & Nozzles) -->
                            <materialDesign:Card Padding="16,12" Margin="0,0,0,16" Background="#263238">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <materialDesign:PackIcon Kind="GasStation" Width="22" Height="22" Foreground="#FFB74D" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Station Layout (Pumps, Nozzles &amp; Tanks)" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Configure physical pumps, nozzles, connected fuel products, and storage tanks." FontSize="12" Foreground="#CFD8DC"/>
                                        <TextBlock Text="{Binding StationStatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="#FFB74D" Margin="0,6,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="+ Add Pump" Command="{Binding AddPumpCommand}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#FFB74D" BorderBrush="#FFB74D"
                                                Height="32" Padding="12,0" Margin="0,0,8,0" FontSize="11"/>

                                        <Button Content="+ Add Tank" Command="{Binding AddTankCommand}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#90CAF9" BorderBrush="#90CAF9"
                                                Height="32" Padding="12,0" Margin="0,0,8,0" FontSize="11"/>

                                        <Button Content="Save Tanks" Command="{Binding SaveTanksCommand}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#90CAF9" BorderBrush="#90CAF9"
                                                Height="32" Padding="12,0" Margin="0,0,12,0" FontSize="11"/>

                                        <Button Content="Save Station Layout" Command="{Binding SaveStationLayoutCommand}"
                                                Style="{StaticResource MaterialDesignRaisedButton}" Background="#F57C00" BorderBrush="#F57C00" Foreground="White"
                                                Height="34" Padding="16,0" FontSize="12" FontWeight="Bold"/>
                                    </StackPanel>
                                </Grid>
                            </materialDesign:Card>

                            <!-- Pumps Visual Mapping Cards -->
                            <ItemsControl ItemsSource="{Binding ConfiguredPumps}" Margin="0,0,0,16">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <materialDesign:Card Width="375" Margin="0,0,16,16" Padding="12" Background="#1E272C">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,8">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="GasStationOutline" Width="18" Height="18" Foreground="#FFB74D" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding PumpId, StringFormat='Pump #{0}'}" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <Button Content="+ Nozzle" Command="{Binding DataContext.AddNozzleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                                Style="{StaticResource MaterialDesignFlatButton}" Foreground="#80CBC4" Height="26" Padding="6,0" FontSize="10"/>
                                                        <Button Content="Delete" Command="{Binding DataContext.RemovePumpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                                Style="{StaticResource MaterialDesignFlatButton}" Foreground="#E57373" Height="26" Padding="6,0" FontSize="10"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Nozzles in this pump -->
                                                <ItemsControl ItemsSource="{Binding Nozzles}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#263238" CornerRadius="4" Padding="8,4" Margin="0,0,0,6">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="1*"/>
                                                                        <ColumnDefinition Width="1.4*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                        <TextBlock Text="N:" FontSize="11" Foreground="#CFD8DC" Margin="0,0,2,0"/>
                                                                        <TextBox Text="{Binding NozzleNumber, UpdateSourceTrigger=PropertyChanged}" Width="28" Foreground="White" FontWeight="Bold" FontSize="12" TextAlignment="Center"/>
                                                                    </StackPanel>

                                                                    <ComboBox Grid.Column="1" ItemsSource="{Binding DataContext.AvailableFuelTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                              SelectedItem="{Binding FuelType, UpdateSourceTrigger=PropertyChanged}"
                                                                              Height="28" FontSize="11" Foreground="#80CBC4" Margin="0,0,6,0" ToolTip="Fuel Product">
                                                                        <ComboBox.ItemContainerStyle>
                                                                            <Style TargetType="ComboBoxItem">
                                                                                <Setter Property="Foreground" Value="White"/>
                                                                                <Setter Property="Background" Value="#263238"/>
                                                                                <Setter Property="FontSize" Value="12"/>
                                                                            </Style>
                                                                        </ComboBox.ItemContainerStyle>
                                                                    </ComboBox>

                                                                    <!-- Connected Tank Dropdown -->
                                                                    <ComboBox Grid.Column="2" ItemsSource="{Binding DataContext.AvailableTankNames, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                              SelectedItem="{Binding TankName, UpdateSourceTrigger=PropertyChanged}"
                                                                              IsEditable="True" Height="28" FontSize="11" Foreground="#90CAF9" Margin="0,0,6,0" ToolTip="Connected Storage Tank">
                                                                        <ComboBox.ItemContainerStyle>
                                                                            <Style TargetType="ComboBoxItem">
                                                                                <Setter Property="Foreground" Value="White"/>
                                                                                <Setter Property="Background" Value="#263238"/>
                                                                                <Setter Property="FontSize" Value="12"/>
                                                                            </Style>
                                                                        </ComboBox.ItemContainerStyle>
                                                                    </ComboBox>

                                                                    <Button Grid.Column="3" Content="✕" Command="{Binding DataContext.RemoveNozzleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="#E57373" Height="24" Width="24" Padding="0"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </materialDesign:Card>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Tanks Grid -->
                            <materialDesign:Card Padding="12" Margin="0,0,0,16" Background="#263238">
                                <StackPanel>
                                    <TextBlock Text="Configured Storage Tanks" FontSize="14" FontWeight="Bold" Foreground="#90CAF9" Margin="0,0,0,8"/>
                                    <DataGrid ItemsSource="{Binding ConfiguredTanks}" AutoGenerateColumns="False"
                                              CanUserAddRows="False" Background="Transparent" Foreground="White"
                                              RowBackground="#263238" AlternatingRowBackground="#1E272C"
                                              materialDesign:DataGridAssist.CellPadding="10 6" FontSize="12">
                                        <DataGrid.ColumnHeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                                <Setter Property="Background" Value="#1A2327"/>
                                                <Setter Property="Foreground" Value="#90CAF9"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </Style>
                                        </DataGrid.ColumnHeaderStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Tank Name" Binding="{Binding TankName}" Width="200"/>
                                            <DataGridTextColumn Header="Capacity (KL)" Binding="{Binding CapacityKL}" Width="120"/>
                                            <DataGridTextColumn Header="Fuel Product" Binding="{Binding FuelType}" Width="150"/>
                                            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="80"/>
                                            <DataGridTemplateColumn Header="Actions" Width="100">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="Delete" Command="{Binding DataContext.DeleteTankCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                                Style="{StaticResource MaterialDesignFlatButton}" Foreground="#E57373" Height="24" Padding="6,0" FontSize="10"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </materialDesign:Card>

                            <!-- Section 2: Dynamic Collection Types Master -->
                            <materialDesign:Card Padding="16,12" Margin="0,0,0,16" Background="#263238">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <materialDesign:PackIcon Kind="CreditCardMultiple" Width="22" Height="22" Foreground="#81C784" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Dynamic Collection Types Master" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Configure payment methods (SBI Redeem, Paytm, QR, Mobikwik, PhonePe, Cards, etc.) with TID reconciliation settings." FontSize="12" Foreground="#CFD8DC"/>
                                        <TextBlock Text="{Binding CollectionStatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="#81C784" Margin="0,6,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="+ Add Collection Type" Command="{Binding AddCollectionTypeCommand}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#81C784" BorderBrush="#81C784"
                                                Height="32" Padding="12,0" Margin="0,0,8,0" FontSize="11"/>

                                        <Button Content="Save Collection Types" Command="{Binding SaveCollectionsCommand}"
                                                Style="{StaticResource MaterialDesignRaisedButton}" Background="#388E3C" BorderBrush="#388E3C" Foreground="White"
                                                Height="34" Padding="16,0" FontSize="12" FontWeight="Bold"/>
                                    </StackPanel>
                                </Grid>
                            </materialDesign:Card>

                            <!-- Collection Types Table -->
                            <materialDesign:Card Padding="0" Background="#263238">
                                <DataGrid ItemsSource="{Binding ConfiguredCollectionTypes}" AutoGenerateColumns="False"
                                          CanUserAddRows="False" GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#37474F" Background="Transparent" Foreground="White"
                                          RowBackground="#263238" AlternatingRowBackground="#1E272C"
                                          materialDesign:DataGridAssist.CellPadding="10 6" FontSize="12">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                            <Setter Property="Background" Value="#1A2327"/>
                                            <Setter Property="Foreground" Value="#81C784"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Order" Binding="{Binding DisplayOrder, UpdateSourceTrigger=PropertyChanged}" Width="50" IsReadOnly="True"/>
                                        <DataGridTemplateColumn Header="Code" Width="140">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Foreground="#80CBC4" FontWeight="SemiBold"
                                                             Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="#546E7A" FontSize="12" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Display Name" Width="200">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Foreground="White" FontWeight="Bold"
                                                             Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="#546E7A" FontSize="12" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Category" Width="120">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Foreground="#CFD8DC"
                                                             Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="#546E7A" FontSize="12" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridCheckBoxColumn Header="Requires TID / Batch" Binding="{Binding HasTidBatch, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                                        <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                        <DataGridTemplateColumn Header="Reorder / Actions" Width="200">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="▲" Command="{Binding DataContext.MoveCollectionUpCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                                Style="{StaticResource MaterialDesignFlatButton}" Foreground="#80CBC4" Height="24" Width="24" Padding="0"/>
                                                        <Button Content="▼" Command="{Binding DataContext.MoveCollectionDownCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                                Style="{StaticResource MaterialDesignFlatButton}" Foreground="#80CBC4" Height="24" Width="24" Padding="0" Margin="4,0,8,0"/>
                                                        <Button Content="Remove" Command="{Binding DataContext.DeleteCollectionTypeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                                Style="{StaticResource MaterialDesignFlatButton}" Foreground="#E57373" Height="24" Padding="6,0" FontSize="10"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </materialDesign:Card>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

            </TabControl>


            <!-- Bottom Status Bar -->
            <Border Grid.Column="1" Grid.Row="1" Background="#37474F" TextElement.Foreground="White" Padding="16,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ShieldAlert" Width="14" Height="14" Margin="0,0,4,0" Opacity="0.8" VerticalAlignment="Center"/>
                        <TextBlock Text="Rashtra Technologies Developer Account" FontSize="11" Opacity="0.8" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="{Binding DiagnosticsMessage}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFEB3B"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Clock" Width="14" Height="14" Margin="0,0,4,0" Opacity="0.5" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentDateTime}" FontSize="11" Opacity="0.8" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </materialDesign:DialogHost>
</Window>
