<Window x:Class="FuelPro.UI.Views.DeveloperMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:FuelPro.UI.ViewModels"
        xmlns:converters="clr-namespace:FuelPro.UI.Converters"
        Title="Rashtra Technologies — PyroSync Developer Administrative Tools"
        Width="1100" Height="750" MinWidth="1024" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        Icon="pack://application:,,,/Resources/fuel-pump-icon.ico">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </Window.Resources>

    <materialDesign:DialogHost Identifier="DeveloperDialog">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="36"/>
            </Grid.RowDefinitions>

            <!-- Sidebar Navigation (Developer Dark Slate styling) -->
            <Border Grid.Column="0" Grid.RowSpan="2" Background="#263238">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,24,0,0">
                        <materialDesign:PackIcon Kind="ShieldAlert" Width="42" Height="42" Foreground="#FF5252" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="DEVELOPER TOOLS" FontSize="14" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Rashtra Technologies" FontSize="10" Foreground="White" Opacity="0.5" HorizontalAlignment="Center" Margin="0,0,0,24"/>
                    </StackPanel>

                    <!-- Navigation Options -->
                    <StackPanel Grid.Row="1" Margin="8,0">
                        <Button Command="{Binding SelectTabCommand}" CommandParameter="0" ToolTip="User Management" Height="48" Margin="0,2" HorizontalContentAlignment="Left">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatMidBgButton}">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="Opacity" Value="0.6" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedNavIndex}" Value="0">
                                            <Setter Property="Opacity" Value="1" />
                                            <Setter Property="Background" Value="#37474F" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountMultiple" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="User Profiles" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding SelectTabCommand}" CommandParameter="1" ToolTip="Cloud Credentials" Height="48" Margin="0,2" HorizontalContentAlignment="Left">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatMidBgButton}">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="Opacity" Value="0.6" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedNavIndex}" Value="1">
                                            <Setter Property="Opacity" Value="1" />
                                            <Setter Property="Background" Value="#37474F" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CloudKey" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Cloud Config" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding SelectTabCommand}" CommandParameter="2" ToolTip="Diagnostics &amp; Sync Engine" Height="48" Margin="0,2" HorizontalContentAlignment="Left">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatMidBgButton}">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="Opacity" Value="0.6" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedNavIndex}" Value="2">
                                            <Setter Property="Opacity" Value="1" />
                                            <Setter Property="Background" Value="#37474F" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="DatabaseSearch" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Diagnostics &amp; Logs" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding SelectTabCommand}" CommandParameter="3" ToolTip="License Key Status" Height="48" Margin="0,2" HorizontalContentAlignment="Left">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatMidBgButton}">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="Opacity" Value="0.6" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedNavIndex}" Value="3">
                                            <Setter Property="Opacity" Value="1" />
                                            <Setter Property="Background" Value="#37474F" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Key" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Licensing Status" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Button Grid.Row="2" Command="{Binding ExitCommand}" Content="Exit Tools" Margin="16,0,16,24" Height="40" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="White" BorderBrush="White" Opacity="0.5"/>
                </Grid>
            </Border>

            <!-- Main Workspace Area -->
            <TabControl Grid.Column="1" Grid.Row="0" SelectedIndex="{Binding SelectedNavIndex}" BorderThickness="0" Background="Transparent" Padding="24,16">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </TabControl.ItemContainerStyle>

                <!-- Tab 0: User Management -->
                <TabItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="User Management" FontSize="24" FontWeight="Bold" Foreground="#37474F" Margin="0,0,0,16"/>

                        <!-- Grid representing users list -->
                        <materialDesign:Card Grid.Row="1" Padding="16" UniformCornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp2" Margin="0,0,0,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Active Accounts" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding Users}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="300" materialDesign:DataGridAssist.CellPadding="12 8">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="User ID" Binding="{Binding UserId}" Width="80"/>
                                        <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="*"/>
                                        <DataGridTextColumn Header="Assigned Role" Binding="{Binding Role}" Width="150"/>
                                        
                                        <DataGridTemplateColumn Header="Active" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ToggleButton IsChecked="{Binding IsActive, Mode=OneWay}"
                                                                  Command="{Binding DataContext.ToggleUserActiveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding}"
                                                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="Actions" Width="180">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Reset PIN" Style="{StaticResource MaterialDesignOutlinedButton}" Height="28" Padding="12,0" FontSize="11"
                                                            Command="{Binding DataContext.ResetUserPinCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </materialDesign:Card>

                        <!-- Add User -->
                        <materialDesign:Card Grid.Row="2" Padding="16" UniformCornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp2">
                            <StackPanel>
                                <TextBlock Text="Create Security Profile" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                                             materialDesign:HintAssist.Hint="Username" materialDesign:HintAssist.IsFloating="True"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                    <TextBox Grid.Column="1" Text="{Binding NewPin, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,8,0"
                                             materialDesign:HintAssist.Hint="PIN" materialDesign:HintAssist.IsFloating="True"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                    <ComboBox Grid.Column="2" ItemsSource="{Binding RoleOptions}" SelectedItem="{Binding NewRole}" Margin="8,0,0,0"
                                              materialDesign:HintAssist.Hint="System Role" materialDesign:HintAssist.IsFloating="True"
                                              Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Generate Account" Command="{Binding CreateUserCommand}" Height="40" Padding="24,0" Style="{StaticResource MaterialDesignRaisedButton}"/>
                                    <TextBlock Text="{Binding UserStatusMessage}" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="13" FontWeight="SemiBold" Foreground="#D32F2F"/>
                                </StackPanel>
                            </StackPanel>
                        </materialDesign:Card>
                    </Grid>
                </TabItem>

                <!-- Tab 1: Cloud Configuration -->
                <TabItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Cloud Synchronization settings" FontSize="24" FontWeight="Bold" Foreground="#37474F" Margin="0,0,0,16"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <materialDesign:Card Padding="24" UniformCornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp2" VerticalAlignment="Top">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <materialDesign:PackIcon Kind="CloudSync" Width="24" Height="24" Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                    <TextBlock Text="Protected Credentials" FontSize="18" FontWeight="SemiBold" Margin="8,0"/>
                                </StackPanel>

                                <!-- Notice/Warning -->
                                <Border Background="#FFF3E0" BorderBrush="#FFE0B2" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,24">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Alert" Width="20" Height="20" Foreground="#E65100" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <TextBlock Text="Production sync configuration is locked by default. Click 'Unlock Configuration' to perform modifications." VerticalAlignment="Center" Foreground="#E65100" FontWeight="SemiBold" FontSize="12"/>
                                    </StackPanel>
                                </Border>

                                <!-- Supabase Settings Row -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding SupabaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{Binding IsConfigLocked}"
                                             materialDesign:HintAssist.Hint="Supabase URL" materialDesign:HintAssist.IsFloating="True"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                </Grid>

                                <TextBox Text="{Binding SupabaseApiKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"
                                         IsReadOnly="{Binding IsConfigLocked}"
                                         materialDesign:HintAssist.Hint="Supabase Api Key (Service / Anon Role)" materialDesign:HintAssist.IsFloating="True"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                                <!-- Station ID with Copy & Generate -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding StationId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                                             IsReadOnly="{Binding IsConfigLocked}"
                                             materialDesign:HintAssist.Hint="Station ID (Shared Pump Identity)" materialDesign:HintAssist.IsFloating="True"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                    <Button Grid.Column="1" Content="Copy" Command="{Binding CopyStationIdCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="50" Margin="0,0,8,0" Padding="16,0" VerticalAlignment="Center"/>
                                    <Button Grid.Column="2" Content="Generate ID" Command="{Binding GenerateStationIdCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="50" Padding="16,0" VerticalAlignment="Center"
                                            IsEnabled="{Binding IsConfigLocked, Converter={StaticResource InverseBoolConverter}}"/>
                                </Grid>

                                <!-- Machine ID (Read-only) -->
                                <TextBox Text="{Binding MachineId, Mode=OneWay}" Margin="0,0,0,16"
                                         IsReadOnly="True"
                                         materialDesign:HintAssist.Hint="Machine ID (Read-only Device Identity)" materialDesign:HintAssist.IsFloating="True"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                                <CheckBox Content="Enable Cloud Sync Pipeline" IsChecked="{Binding SyncEnabled}" 
                                          IsEnabled="{Binding IsConfigLocked, Converter={StaticResource InverseBoolConverter}}"
                                          Margin="0,0,0,24" FontSize="14" FontWeight="SemiBold"/>

                                <!-- Dedicated Connection Status Panel -->
                                <Border BorderThickness="1" BorderBrush="#CFD8DC" CornerRadius="8" Padding="16" Margin="0,0,0,24" Background="#ECEFF1">
                                    <StackPanel>
                                        <TextBlock Text="Station Connection Info" FontSize="14" FontWeight="Bold" Foreground="#37474F" Margin="0,0,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Cloud Status:" FontSize="11" Opacity="0.6"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="#D32F2F"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCloudConnected}" Value="True">
                                                                        <Setter Property="Fill" Value="#388E3C"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock FontSize="13" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Offline"/>
                                                                <Setter Property="Foreground" Value="#D32F2F"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCloudConnected}" Value="True">
                                                                        <Setter Property="Text" Value="Connected to Cloud ✓"/>
                                                                        <Setter Property="Foreground" Value="#388E3C"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Local Machine Identity:" FontSize="11" Opacity="0.6"/>
                                                <TextBlock Text="{Binding MachineId}" FontSize="13" FontWeight="Bold" Foreground="#37474F" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                        <Separator Margin="0,12" Background="#CFD8DC"/>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="GasStation" Width="16" Height="16" Foreground="#37474F" VerticalAlignment="Center"/>
                                            <TextBlock Text="Current Station ID: " FontSize="12" Foreground="#37474F" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                            <TextBlock Text="{Binding StationId}" FontSize="12" FontWeight="Bold" Foreground="#37474F" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Unlock Settings" Command="{Binding UnlockConfigurationCommand}" Height="40" Padding="20,0" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,12,0" 
                                            Visibility="{Binding IsConfigLocked, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <Button Content="Save Credentials" Command="{Binding SaveCloudConfigCommand}" Height="40" Padding="24,0" Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,12,0"
                                            IsEnabled="{Binding IsConfigLocked, Converter={StaticResource InverseBoolConverter}}"/>
                                    <Button Content="Test Connection" Command="{Binding TestConnectionCommand}" Height="40" Padding="20,0" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,16,0"
                                            IsEnabled="{Binding IsConfigLocked, Converter={StaticResource InverseBoolConverter}}"/>
                                    <TextBlock Text="{Binding ConfigStatusMessage}" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                            </StackPanel>
                                </materialDesign:Card>


                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!-- Tab 2: Diagnostics & Logs -->
                <TabItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Diagnostics Control Hub" FontSize="24" FontWeight="Bold" Foreground="#37474F" Margin="0,0,0,16"/>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left column: Db Counts & Info -->
                            <StackPanel Grid.Column="0">
                                <materialDesign:Card Padding="16" UniformCornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp2" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Sync Dashboard" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                        <Grid Margin="0,0,0,8">
                                            <TextBlock Text="Connection Status:" Opacity="0.6" FontSize="12"/>
                                            <TextBlock Text="{Binding ConnectionStatus}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#388E3C"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <TextBlock Text="Last Sync Time:" Opacity="0.6" FontSize="12"/>
                                            <TextBlock Text="{Binding LastSyncTime}" HorizontalAlignment="Right" FontWeight="Bold"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,16">
                                            <TextBlock Text="Pending Logs:" Opacity="0.6" FontSize="12"/>
                                            <TextBlock Text="{Binding PendingRecords}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#F57C00"/>
                                        </Grid>
                                        
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                            <Button Content="Sync Now" Command="{Binding ForceSyncNowCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="32" Padding="12,0" FontSize="11" Margin="0,0,8,0"/>
                                            <Button Content="Retry Failed" Command="{Binding RetryFailedSyncCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="32" Padding="12,0" FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>
                                </materialDesign:Card>

                                <materialDesign:Card Padding="16" UniformCornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp2" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Database Record Counts" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <DataGrid Grid.Row="1" ItemsSource="{Binding TableCounts}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="280" materialDesign:DataGridAssist.CellPadding="8 4">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Table" Binding="{Binding TableName}" Width="*"/>
                                                <DataGridTextColumn Header="Records" Binding="{Binding Count}" Width="80"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </materialDesign:Card>

                                <Button Content="Force Full Resync" Command="{Binding ForceFullResyncCommand}" Height="40" Style="{StaticResource MaterialDesignRaisedButton}" Background="#D32F2F" BorderBrush="#D32F2F" Foreground="White" Width="200" HorizontalAlignment="Left"/>
                            </StackPanel>

                            <!-- Right column: Log Viewer -->
                            <materialDesign:Card Grid.Column="2" Padding="16" UniformCornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp2">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                        <TextBlock Text="Recent Logs Viewer (app-.log)" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Button Content="Refresh Logs" Command="{Binding LoadSyncLogsCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="28" Padding="12,0" FontSize="11" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <TextBox Grid.Row="1" Text="{Binding SyncLogsText, Mode=OneWay}" IsReadOnly="True" 
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             AcceptsReturn="True" TextWrapping="NoWrap"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                             FontFamily="Consolas" FontSize="11" Margin="0,4,0,0"
                                             Height="460" VerticalAlignment="Stretch"/>
                                </Grid>
                            </materialDesign:Card>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- Tab 3: License Management -->
                <TabItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Licensing Status" FontSize="24" FontWeight="Bold" Foreground="#37474F" Margin="0,0,0,16"/>

                        <materialDesign:Card Grid.Row="1" Padding="24" UniformCornerRadius="16" Background="White" materialDesign:ElevationAssist.Elevation="Dp2" VerticalAlignment="Top">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <materialDesign:PackIcon Kind="Key" Width="28" Height="28" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Product Licensing Status" FontSize="20" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Grid Margin="0,0,0,24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Status:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LicenseStatus}" Foreground="#388E3C" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Product Name:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LicenseProductName}" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Customer Name:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding LicenseCustomerName}" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Business/Pump Name:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding LicenseBusinessName}" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Mobile Number:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding LicenseMobileNumber}" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="10" Grid.Column="0" Text="License Type:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding LicenseType}" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="12" Grid.Column="0" Text="Activation Date:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="12" Grid.Column="1" Text="{Binding LicenseActivationDate}" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="14" Grid.Column="0" Text="Expiry Date:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="14" Grid.Column="1" Text="{Binding LicenseExpiryDate}" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="16" Grid.Column="0" Text="Device ID:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="16" Grid.Column="1" Text="{Binding LicenseDeviceId, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" VerticalAlignment="Center"/>
                                </Grid>

                                <Button Content="Copy Activation Details" Command="{Binding CopyLicenseInfoCommand}" Height="40" Padding="24,0" Style="{StaticResource MaterialDesignRaisedButton}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </materialDesign:Card>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- Bottom Status Bar -->
            <Border Grid.Column="1" Grid.Row="1" Background="#37474F" TextElement.Foreground="White" Padding="16,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ShieldAlert" Width="14" Height="14" Margin="0,0,4,0" Opacity="0.8" VerticalAlignment="Center"/>
                        <TextBlock Text="Rashtra Technologies Developer Account" FontSize="11" Opacity="0.8" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="{Binding DiagnosticsMessage}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFEB3B"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Clock" Width="14" Height="14" Margin="0,0,4,0" Opacity="0.5" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentDateTime}" FontSize="11" Opacity="0.8" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </materialDesign:DialogHost>
</Window>
