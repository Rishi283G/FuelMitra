<UserControl x:Class="FuelPro.UI.Views.CardSettlementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:FuelPro.UI.Converters">
    <UserControl.Resources>
        <converters:IndianCurrencyConverter x:Key="CurrencyConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <Style TargetType="TextBlock" x:Key="RightAlignedTextBlockStyle">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header and Date/Shift Selection -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CardAccountDetails" Width="28" Height="28" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="TID Sheet" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <DatePicker SelectedDate="{Binding SelectedDate}" materialDesign:HintAssist.Hint="Select Date" Style="{StaticResource MaterialDesignOutlinedDatePicker}" Width="150" Margin="0,0,12,0" Height="48"/>
                    <ComboBox ItemsSource="{Binding ShiftOptions}" SelectedItem="{Binding SelectedShift}" materialDesign:HintAssist.Hint="Select Shift" Style="{StaticResource MaterialDesignOutlinedComboBox}" Width="120" Height="48" Visibility="Collapsed"/>
                    <Button Command="{Binding PrintCommand}" Style="{StaticResource MaterialDesignFlatMidBgButton}" Height="48" Padding="12,0" Margin="0,0,8,0" ToolTip="Print Report">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Printer" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Print" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ExportExcelCommand}" Style="{StaticResource MaterialDesignFlatMidBgButton}" Height="48" Padding="12,0" Background="#1B5E20" BorderBrush="#1B5E20" ToolTip="Export to Excel">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileExcel" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Export" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <ProgressBar Grid.Row="1" IsIndeterminate="{Binding IsLoading}" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource MaterialDesignLinearProgressBar}" Margin="0,0,0,16"/>

            <!-- Status Message (when no data) -->
            <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" FontSize="16" Foreground="OrangeRed" HorizontalAlignment="Center" Margin="0,20" FontWeight="SemiBold"
                       Visibility="{Binding HasData, Converter={StaticResource InverseBoolToVisibilityConverter}, FallbackValue=Visible}"/>

            <!-- Main Content (grids and totals) -->
            <Grid Grid.Row="3" Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <!-- TAB CONTROL FOR SETTLEMENTS -->
                    <TabControl ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                                materialDesign:ColorZoneAssist.Mode="Standard" Margin="0,0,0,16">
                        <TabControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4,2">
                                    <TextBlock Text="{Binding TabHeader}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                    <Border Background="#E8F5E9" CornerRadius="10" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TotalAmount, Converter={StaticResource CurrencyConverter}}"
                                                   FontSize="11" FontWeight="Bold" Foreground="#2E7D32"/>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate>
                            <DataTemplate>
                                <materialDesign:Card Padding="16" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp2">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Text="{Binding SectionTitle}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                            <TextBlock Text="{Binding TotalAmount, StringFormat=' (Total: ₹{0:N2})'}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                        </StackPanel>
                                        <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"
                                                  materialDesign:DataGridAssist.CellPadding="8 6" HeadersVisibility="Column" MaxHeight="280">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="No" Binding="{Binding RomanIndex}" IsReadOnly="True" Width="60"/>
                                                <DataGridTextColumn Header="Salesperson (DSM)" Binding="{Binding DsmName}" IsReadOnly="True" Width="220"/>
                                                <DataGridTemplateColumn Header="Slot" Width="180">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="2,4">
                                                                <TextBlock Text="{Binding Slot}" FontWeight="Bold" FontSize="12"/>
                                                                <TextBlock Text="{Binding SlotDisplaySubtitle}" FontSize="9.5" Foreground="#64766D" FontWeight="Normal" Margin="0,1,0,0"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="TID" Binding="{Binding Tid}" IsReadOnly="True" Width="160"/>
                                                <DataGridTextColumn Header="Batch No" Binding="{Binding Batch}" IsReadOnly="True" Width="200"/>
                                                <DataGridTextColumn Header="Amount" Binding="{Binding Amount, Converter={StaticResource CurrencyConverter}}" IsReadOnly="True" Width="*" ElementStyle="{StaticResource RightAlignedTextBlockStyle}"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </materialDesign:Card>
                            </DataTemplate>
                        </TabControl.ContentTemplate>
                    </TabControl>

                    <!-- SECTION 4: TID SHEET HISTORY LOGS -->
                    <materialDesign:Card Margin="0,0,0,16" Padding="16" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp2">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <materialDesign:PackIcon Kind="History" Width="20" Height="20" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="TID Sheet History Logs (Last 15 Days)" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding PreviousTidSheets}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="220" SelectionMode="Single"
                                      materialDesign:DataGridAssist.CellPadding="8 6" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat='dd MMM yyyy'}" Width="130"/>
                                    <DataGridTemplateColumn Header="Payment Modes Breakdown" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ItemsControl ItemsSource="{Binding CollectionGroups}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#F5F5F5" CornerRadius="6" Padding="6,2" Margin="3,2" BorderBrush="#E0E0E0" BorderThickness="1">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding DisplayName}" FontSize="11" Opacity="0.7" Margin="0,0,4,0"/>
                                                                    <TextBlock Text="{Binding TotalAmount, Converter={StaticResource CurrencyConverter}}" FontSize="11" FontWeight="Bold" Foreground="#1565C0"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Grand Total" Binding="{Binding GrandTotal, Converter={StaticResource CurrencyConverter}}" Width="140" FontWeight="Bold" ElementStyle="{StaticResource RightAlignedTextBlockStyle}"/>
                                    <DataGridTemplateColumn Header="Action" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Load" 
                                                        Command="{Binding DataContext.SelectHistoryDateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                        CommandParameter="{Binding Date}"
                                                        Style="{StaticResource MaterialDesignFlatButton}" Height="28"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </materialDesign:Card>
                </StackPanel>

                <!-- FOOTER ACTIONS -->
                <materialDesign:Card Grid.Row="1" Padding="16" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp3" Background="#FAFAFA">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Command="{Binding PrintCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Width="120" Height="40">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Printer" Width="20" Height="20" Margin="0,0,6,0"/>
                                <TextBlock Text="Print" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
