<UserControl x:Class="FuelPro.UI.Views.SalaryCalculationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:FuelPro.UI.Converters">
    <UserControl.Resources>
        <converters:IndianCurrencyConverter x:Key="CurrencyConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.7"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="MaterialDesignTextBlockCenter" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="MaterialDesignTextBlockRight" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <materialDesign:PackIcon Kind="AccountCash" Width="28" Height="28" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="DSM Salary &amp; Payroll Management" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Tabbed Content -->
        <TabControl Grid.Row="1" materialDesign:ColorZoneAssist.Mode="Standard">
            
            <!-- Tab 1: Monthly Payroll Sheets -->
            <TabItem Header="Monthly Payroll sheet">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Filter Area -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                        <ComboBox ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear}"
                                  materialDesign:HintAssist.Hint="Year" Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  Width="120" Margin="0,0,12,0" Height="48"/>
                        
                        <ComboBox ItemsSource="{Binding Months}" SelectedItem="{Binding SelectedMonthName}"
                                  materialDesign:HintAssist.Hint="Month" Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  Width="150" Margin="0,0,16,0" Height="48"/>
                        
                        <Button Content="Refresh" Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding LoadSalariesCommand}" Height="48" Padding="12,0" Margin="0,0,8,0"/>
                        <Button Command="{Binding PrintCommand}" Style="{StaticResource MaterialDesignFlatMidBgButton}" Height="48" Padding="12,0" Margin="0,0,8,0" ToolTip="Print Report">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Printer" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Print" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ExportExcelCommand}" Style="{StaticResource MaterialDesignFlatMidBgButton}" Height="48" Padding="12,0" Background="#1B5E20" BorderBrush="#1B5E20" ToolTip="Export to Excel">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileExcel" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Export" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <ProgressBar Grid.Row="0" VerticalAlignment="Bottom" IsIndeterminate="{Binding IsLoading}"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 Style="{StaticResource MaterialDesignLinearProgressBar}" Margin="0,0,0,-4"/>

                    <!-- Salary Calculation Sheet Grid -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding SalaryRows}" AutoGenerateColumns="False" CanUserAddRows="False"
                              materialDesign:DataGridAssist.CellPadding="10 8" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Employee Name" Binding="{Binding DsmName}" IsReadOnly="True" Width="1.5*"/>
                            
                            <DataGridTemplateColumn Header="Salary Type" IsReadOnly="True" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SalaryType}" FontWeight="SemiBold"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Rate (Base)" Binding="{Binding BaseSalary, Converter={StaticResource CurrencyConverter}}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="Shifts" Binding="{Binding ShiftsWorked}" IsReadOnly="True" Width="60" ElementStyle="{StaticResource MaterialDesignTextBlockCenter}"/>
                            <DataGridTextColumn Header="Days" Binding="{Binding UniqueDaysWorked}" IsReadOnly="True" Width="60" ElementStyle="{StaticResource MaterialDesignTextBlockCenter}"/>
                            <DataGridTextColumn Header="Earned Base" Binding="{Binding EarnedBase, Converter={StaticResource CurrencyConverter}}" IsReadOnly="True" Width="1.2*" ElementStyle="{StaticResource MaterialDesignTextBlockRight}"/>
                            <DataGridTextColumn Header="Short Recovery" Binding="{Binding ShortRecovery, Converter={StaticResource CurrencyConverter}}" IsReadOnly="True" Width="1.2*" Foreground="#C62828" ElementStyle="{StaticResource MaterialDesignTextBlockRight}"/>
                            
                            <!-- Editable Fields -->
                            <DataGridTemplateColumn Header="Advance Paid (₹)" Width="1.2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding AdvancePaid, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" PreviewTextInput="NumberValidationTextBox"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Other Adj (₹)" Width="1.2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding OtherAdjustments, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" PreviewTextInput="NumberValidationTextBox"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Remarks / Adjustments" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Adv Recovery" Binding="{Binding PendingAdvanceDeduction, Converter={StaticResource CurrencyConverter}}" IsReadOnly="True" Width="1.2*" Foreground="#C62828" ElementStyle="{StaticResource MaterialDesignTextBlockRight}"/>
                            <DataGridTextColumn Header="Remaining Adv" Binding="{Binding RemainingPendingAdvance, Converter={StaticResource CurrencyConverter}}" IsReadOnly="True" Width="1.2*" ElementStyle="{StaticResource MaterialDesignTextBlockRight}"/>
                            <DataGridTextColumn Header="Net Salary" Binding="{Binding NetSalary, Converter={StaticResource CurrencyConverter}}" IsReadOnly="True" Width="1.5*" FontWeight="Bold" Foreground="#2E7D32" ElementStyle="{StaticResource MaterialDesignTextBlockRight}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Save / Commit Row -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <TextBlock Text="* Note: Double-click to edit Advance Paid, Other Adjustments and Remarks fields." VerticalAlignment="Center" Margin="0,0,24,0" Opacity="0.6" FontSize="11"/>
                        <Button Content="Save Payroll Sheet" Style="{StaticResource MaterialDesignRaisedButton}"
                                Command="{Binding SaveAdjustmentsCommand}" Width="200" Height="40" Background="#2E7D32" BorderBrush="#2E7D32"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Tab 2: DSM Profiles Configuration -->
            <TabItem Header="DSM Employee Profiles">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Profile Grid -->
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="DSM Profile Directory" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                        <DataGrid ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" AutoGenerateColumns="False" IsReadOnly="True"
                                  materialDesign:DataGridAssist.CellPadding="10 8" Height="480">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Employee Name" Binding="{Binding DsmName}" Width="2*"/>
                                <DataGridTextColumn Header="Salary Structure" Binding="{Binding SalaryType}" Width="*"/>
                                <DataGridTextColumn Header="Base Salary / Rate" Binding="{Binding BaseSalary, Converter={StaticResource CurrencyConverter}}" Width="*"/>
                                <DataGridTextColumn Header="Pending Advance" Binding="{Binding PendingAdvance, Converter={StaticResource CurrencyConverter}}" Width="*"/>
                                <DataGridTextColumn Header="Monthly Deduction" Binding="{Binding MonthlyAdvanceDeduction, Converter={StaticResource CurrencyConverter}}" Width="*"/>
                                <DataGridTextColumn Header="Joining Date" Binding="{Binding JoiningDate, StringFormat='{}{0:dd-MMM-yyyy}'}" Width="1.2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>

                    <!-- Right: Add/Edit Card -->
                    <StackPanel Grid.Column="1">
                        <!-- Add Profile Panel (If SelectedProfile is null) -->
                        <materialDesign:Card Padding="16" UniformCornerRadius="8" Margin="0,0,0,16" materialDesign:ElevationAssist.Elevation="Dp1"
                                             Visibility="{Binding SelectedProfile, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverted}">
                            <StackPanel>
                                <TextBlock Text="Create DSM Profile" FontSize="16" FontWeight="Bold" Margin="0,0,0,16" Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                
                                <TextBox Text="{Binding NewProfile.DsmName, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Full Name"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12" Height="48"/>
                                
                                <ComboBox SelectedValue="{Binding NewProfile.SalaryType}" SelectedValuePath="Content" materialDesign:HintAssist.Hint="Salary Mode"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,12" Height="48">
                                    <ComboBoxItem Content="FixedMonthly"/>
                                    <ComboBoxItem Content="PerShift"/>
                                    <ComboBoxItem Content="PerDay"/>
                                </ComboBox>
                                
                                <TextBox Text="{Binding NewProfile.BaseSalary, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Base Rate / Monthly Salary"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12" Height="48" PreviewTextInput="NumberValidationTextBox"/>
                                
                                <TextBox Text="{Binding NewProfile.PendingAdvance, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Pending Advance (₹)"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12" Height="48" PreviewTextInput="NumberValidationTextBox"/>
                                
                                <TextBox Text="{Binding NewProfile.MonthlyAdvanceDeduction, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Monthly Deduction (₹)"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12" Height="48" PreviewTextInput="NumberValidationTextBox"/>
                                
                                <DatePicker SelectedDate="{Binding NewProfile.JoiningDate}" materialDesign:HintAssist.Hint="Joining Date"
                                            Style="{StaticResource MaterialDesignOutlinedDatePicker}" Margin="0,0,0,24" Height="48"/>
                                
                                <Button Content="Register Employee" Style="{StaticResource MaterialDesignRaisedButton}"
                                        Command="{Binding AddProfileCommand}" Height="40"/>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Edit Profile Panel (If SelectedProfile is not null) -->
                        <materialDesign:Card Padding="16" UniformCornerRadius="8" Margin="0,0,0,16" materialDesign:ElevationAssist.Elevation="Dp1"
                                             Visibility="{Binding SelectedProfile, Converter={StaticResource NullToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Modify Profile" FontSize="16" FontWeight="Bold" Margin="0,0,0,16" Foreground="#FF8F00"/>
                                
                                <TextBox Text="{Binding SelectedProfile.DsmName, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Full Name"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12" Height="48"/>
                                
                                <ComboBox SelectedValue="{Binding SelectedProfile.SalaryType}" SelectedValuePath="Content" materialDesign:HintAssist.Hint="Salary Mode"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,12" Height="48">
                                    <ComboBoxItem Content="FixedMonthly"/>
                                    <ComboBoxItem Content="PerShift"/>
                                    <ComboBoxItem Content="PerDay"/>
                                </ComboBox>
                                
                                <TextBox Text="{Binding SelectedProfile.BaseSalary, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Base Rate / Monthly Salary"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12" Height="48" PreviewTextInput="NumberValidationTextBox"/>
                                
                                <TextBox Text="{Binding SelectedProfile.PendingAdvance, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Pending Advance (₹)"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12" Height="48" PreviewTextInput="NumberValidationTextBox"/>
                                
                                <TextBox Text="{Binding SelectedProfile.MonthlyAdvanceDeduction, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Monthly Deduction (₹)"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12" Height="48" PreviewTextInput="NumberValidationTextBox"/>
                                
                                <DatePicker SelectedDate="{Binding SelectedProfile.JoiningDate}" materialDesign:HintAssist.Hint="Joining Date"
                                            Style="{StaticResource MaterialDesignOutlinedDatePicker}" Margin="0,0,0,24" Height="48"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Update" Style="{StaticResource MaterialDesignRaisedButton}"
                                            Command="{Binding UpdateProfileCommand}" Margin="0,0,4,0" Background="#FF8F00" BorderBrush="#FF8F00"/>
                                    <Button Grid.Column="1" Content="Delete" Style="{StaticResource MaterialDesignFlatButton}"
                                            Command="{Binding DeleteProfileCommand}" Margin="4,0,0,0" Foreground="#C62828"/>
                                </Grid>
                                
                                <Button Content="Cancel Edit" Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Click="CancelEdit_Click" Margin="0,8,0,0"/>
                            </StackPanel>
                        </materialDesign:Card>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
