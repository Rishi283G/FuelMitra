<UserControl x:Class="FuelPro.UI.Views.FinalCalculationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:FuelPro.UI.Converters"
             xmlns:viewmodels="clr-namespace:FuelPro.UI.ViewModels"
             xmlns:views="clr-namespace:FuelPro.UI.Views"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:FinalCalculationViewModel}"
             d:DesignHeight="800" d:DesignWidth="1200"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <converters:IndianCurrencyConverter x:Key="CurrencyConverter" />
        <converters:LitreFormatConverter x:Key="LitreConverter" />
        <converters:DifferenceBadgeConverter x:Key="DiffBadgeConverter" />
        <converters:DifferenceBadgeBrushConverter x:Key="DiffBadgeBrushConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <converters:InverseBoolConverter x:Key="InverseBool" />
        <converters:PumpIdDisplayConverter x:Key="PumpIdConverter" />
        <converters:FuelTypeToBrushConverter x:Key="FuelTypeToBrushConverter" />
        <converters:FuelTypeToLightBgBrushConverter x:Key="FuelTypeToLightBgBrushConverter" />

        <Style TargetType="materialDesign:Card" x:Key="SectionCard">
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Surface}" />
            <Setter Property="UniformCornerRadius" Value="8" />
        </Style>

        <Style TargetType="TextBlock" x:Key="SectionTitle">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Divider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource MaterialDesign.Brush.Divider}" />
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource MaterialDesign.Brush.Divider}" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource MaterialDesign.Brush.Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <materialDesign:Card Grid.Row="0" Margin="16" Padding="16" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="0,0,24,0">
                    <materialDesign:PackIcon Kind="Calculator" Width="24" Height="24" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" Margin="0,0,8,0"/>
                    <TextBlock Text="Final Calculation" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>

                <DatePicker Grid.Column="1" materialDesign:HintAssist.Hint="Select Date" Style="{StaticResource MaterialDesignFloatingHintDatePicker}"
                            SelectedDate="{Binding SelectedDate}" Width="150" Margin="0,0,16,0" IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}"/>

                <ComboBox Grid.Column="2" materialDesign:HintAssist.Hint="Shift" Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                          ItemsSource="{Binding ShiftOptions}" SelectedItem="{Binding SelectedShift}" Width="100" IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StringFormat='Shift {0}'}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                    <Border Background="{DynamicResource MaterialDesign.Brush.Error.Light}" CornerRadius="4" Padding="8,4" 
                            Visibility="{Binding IsShiftLocked, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Lock" Foreground="{DynamicResource MaterialDesign.Brush.Error}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="SHIFT LOCKED" Foreground="{DynamicResource MaterialDesign.Brush.Error}" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MaterialDesign.Brush.Error}" Margin="16,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button Content="Load/Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0" />
                    <Button Command="{Binding ExportExcelCommand}" Style="{StaticResource MaterialDesignFlatMidBgButton}" Height="36" Padding="12,0" Margin="0,0,8,0" Background="#1B5E20" BorderBrush="#1B5E20" ToolTip="Export Shift Total to Excel" IsEnabled="{Binding HasData}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileExcel" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Export Excel" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <ComboBox ItemsSource="{Binding ManagerOptions}" SelectedItem="{Binding SelectedManager}" IsEditable="True"
                              materialDesign:HintAssist.Hint="Manager Name" Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                              Width="140" Margin="0,0,8,0" VerticalAlignment="Center" IsEnabled="{Binding HasData}"/>
                    <Button Content="Print" Click="PrintButton_Click" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0" IsEnabled="{Binding HasData}" />
                    <Button Content="Lock Shift" Command="{Binding LockShiftCommand}" Style="{StaticResource MaterialDesignRaisedButton}"
                            IsEnabled="{Binding HasData}" Visibility="{Binding IsShiftLocked, Converter={StaticResource InverseBoolToVis}}" />
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <!-- MAIN CONTENT -->
        <ScrollViewer Grid.Row="1" Padding="16,0,16,16" VerticalScrollBarVisibility="Auto">
            <Grid Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><!-- Row 0: Nozzle Readings (top) -->
                    <RowDefinition Height="Auto" /><!-- Row 1: DSM Summary + Reconciliation -->
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*" />
                    <ColumnDefinition Width="4*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                    <!-- TABLE A: DSM SUMMARY -->
                    <materialDesign:Card Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="A. DSM Summary" Style="{StaticResource SectionTitle}" />
                            <DataGrid ItemsSource="{Binding DsmSummaryRows}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="300">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="DSM" Binding="{Binding DsmName}" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="Pump" Binding="{Binding PumpLabel}" />
                                    <DataGridTextColumn Header="Phone Pe (M)" Binding="{Binding PhonePeMorning, Converter={StaticResource CurrencyConverter}}" />
                                    <DataGridTextColumn Header="Phone Pe (N)" Binding="{Binding PhonePeNight, Converter={StaticResource CurrencyConverter}}" />
                                    <DataGridTextColumn Header="PineLab (M)" Binding="{Binding CreditCardMorning, Converter={StaticResource CurrencyConverter}}" />
                                    <DataGridTextColumn Header="PineLab (N)" Binding="{Binding CreditCardNight, Converter={StaticResource CurrencyConverter}}" />
                                    <DataGridTextColumn Header="Petro Card" Binding="{Binding PetroCard, Converter={StaticResource CurrencyConverter}}" />
                                    <DataGridTextColumn Header="Bank Cash" Binding="{Binding CashDeposit, Converter={StaticResource CurrencyConverter}}" />
                                    <DataGridTextColumn Header="Debtors" Binding="{Binding Debit, Converter={StaticResource CurrencyConverter}}" Foreground="Red" />
                                    <DataGridTextColumn Header="Expenses" Binding="{Binding Expenses, Converter={StaticResource CurrencyConverter}}" Foreground="Red"/>
                                    <DataGridTextColumn Header="Testing" Binding="{Binding Testing, Converter={StaticResource CurrencyConverter}}" />
                                    <DataGridTextColumn Header="Hand Cash" Binding="{Binding CashInHand, Converter={StaticResource CurrencyConverter}}" />
                                    <DataGridTextColumn Header="Gross Sale" Binding="{Binding GrossSales, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" Foreground="Green" />
                                </DataGrid.Columns>
                            </DataGrid>
                            
                            <Border Background="{DynamicResource MaterialDesign.Brush.Primary.Light}" Padding="8" Margin="0,8,0,0" CornerRadius="4">
                                <Grid DataContext="{Binding DsmSummaryTotals}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="TOTAL" FontWeight="Bold" Foreground="White" />
                                    <TextBlock Grid.Column="1" Text="{Binding PhonePeMorning, Converter={StaticResource CurrencyConverter}}" Foreground="White" Margin="8,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding PhonePeNight, Converter={StaticResource CurrencyConverter}}" Foreground="White" Margin="8,0" />
                                    <TextBlock Grid.Column="3" Text="{Binding CreditCardMorning, Converter={StaticResource CurrencyConverter}}" Foreground="White" Margin="8,0" />
                                    <TextBlock Grid.Column="4" Text="{Binding CreditCardNight, Converter={StaticResource CurrencyConverter}}" Foreground="White" Margin="8,0" />
                                    <TextBlock Grid.Column="5" Text="{Binding PetroCard, Converter={StaticResource CurrencyConverter}}" Foreground="White" Margin="8,0" />
                                    <TextBlock Grid.Column="6" Text="{Binding CashDeposit, Converter={StaticResource CurrencyConverter}}" Foreground="White" Margin="8,0" />
                                    <TextBlock Grid.Column="7" Text="{Binding Debit, Converter={StaticResource CurrencyConverter}}" Foreground="White" Margin="8,0" />
                                    <TextBlock Grid.Column="8" Text="{Binding Expenses, Converter={StaticResource CurrencyConverter}}" Foreground="White" Margin="8,0" />
                                    <TextBlock Grid.Column="9" Text="{Binding Testing, Converter={StaticResource CurrencyConverter}}" Foreground="White" Margin="8,0" />
                                    <TextBlock Grid.Column="10" Text="{Binding CashInHand, Converter={StaticResource CurrencyConverter}}" Foreground="White" Margin="8,0" />
                                    <TextBlock Grid.Column="11" Text="{Binding GrossSales, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" Foreground="White" Margin="8,0" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- COMBINED DSM SHIFT TOTALS -->
                    <materialDesign:Card Style="{StaticResource SectionCard}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="DSM Shift Totals Summary (Combined per DSM)" Style="{StaticResource SectionTitle}" />
                            <DataGrid ItemsSource="{Binding DsmShiftTotals}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="220">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="DSM" Binding="{Binding DsmName}" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="Sessions" Binding="{Binding SessionsCount}" Width="70" />
                                    <DataGridTextColumn Header="Pumps" Binding="{Binding AssignedPumpsDisplay}" />
                                    <DataGridTextColumn Header="Gross Sale" Binding="{Binding GrossSales, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" Foreground="Green" />
                                    <DataGridTextColumn Header="Digital Total" Binding="{Binding DigitalTotal, Converter={StaticResource CurrencyConverter}}" />
                                    <DataGridTextColumn Header="Bank Cash" Binding="{Binding CashDeposit, Converter={StaticResource CurrencyConverter}}" />
                                    <DataGridTextColumn Header="Hand Cash" Binding="{Binding CashInHand, Converter={StaticResource CurrencyConverter}}" />
                                    <DataGridTextColumn Header="Debtors" Binding="{Binding Debit, Converter={StaticResource CurrencyConverter}}" Foreground="Red" />
                                    <DataGridTextColumn Header="Expenses" Binding="{Binding Expenses, Converter={StaticResource CurrencyConverter}}" Foreground="Red"/>
                                    <DataGridTextColumn Header="Testing" Binding="{Binding Testing, Converter={StaticResource CurrencyConverter}}" />
                                    <DataGridTextColumn Header="Total Collection" Binding="{Binding TotalCollection, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" />
                                    <DataGridTextColumn Header="Mismatch" Binding="{Binding Mismatch, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- TABLE C: CREDITORS -->
                    <materialDesign:Card Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="C. Debtors / Debit Register" Style="{StaticResource SectionTitle}" Margin="0" />
                                <TextBlock Text="{Binding CreditorsTotal, Converter={StaticResource CurrencyConverter}, StringFormat='Total: {0}'}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource MaterialDesign.Brush.Error}" />
                            </Grid>
                            <DataGrid ItemsSource="{Binding CreditorRows}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="200">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="DSM Name" Binding="{Binding DsmName}" Width="2*" />
                                    <DataGridTextColumn Header="Pump" Binding="{Binding PumpId, Converter={StaticResource PumpIdConverter}}" Width="*" />
                                    <DataGridTextColumn Header="Debtor Name" Binding="{Binding DebtorName}" Width="3*" />
                                    <DataGridTextColumn Header="Slip No" Binding="{Binding ChequeNo}" Width="2*" />
                                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, Converter={StaticResource CurrencyConverter}}" Width="2*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- DEBTOR RECOVERIES -->
                    <materialDesign:Card Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="C2. Debtor Recoveries (Collections)" Style="{StaticResource SectionTitle}" Margin="0" />
                                <TextBlock Text="{Binding CurrentReport.DebtorRepaymentsTotal, Converter={StaticResource CurrencyConverter}, StringFormat='Total: {0}'}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="16" Foreground="Green" />
                            </Grid>
                            
                            <!-- Repayments List -->
                            <DataGrid ItemsSource="{Binding DebtorRepayments}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="200">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Debtor" Binding="{Binding CreditorName}" Width="2*" />
                                    <DataGridTextColumn Header="Mode" Binding="{Binding PaymentMode}" Width="*" />
                                    <DataGridTextColumn Header="Details" Binding="{Binding ReferenceDisplay}" Width="2*" />
                                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, Converter={StaticResource CurrencyConverter}}" Width="1.5*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- TABLE D: EXPENSES -->
                    <materialDesign:Card Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="D. Expenses Register" Style="{StaticResource SectionTitle}" Margin="0" />
                                <TextBlock Text="{Binding ExpensesTotal, Converter={StaticResource CurrencyConverter}, StringFormat='Total: {0}'}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource MaterialDesign.Brush.Error}" />
                            </Grid>
                            
                            <Grid Margin="0,0,0,12" Visibility="{Binding IsShiftLocked, Converter={StaticResource InverseBoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding NewExpenseDescription, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Shift Expense Description" Margin="0,0,8,0" />
                                <TextBox Grid.Column="1" Text="{Binding NewExpenseAmount, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Amount" Width="100" Margin="0,0,8,0" />
                                <Button Grid.Column="2" Content="Add Expense" Command="{Binding AddShiftExpenseCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" />
                            </Grid>

                            <DataGrid ItemsSource="{Binding ExpenseRows}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="200">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="DSM / Shift" Binding="{Binding DsmName}" Width="2*" />
                                    <DataGridTextColumn Header="Pump" Binding="{Binding PumpId, Converter={StaticResource PumpIdConverter}}" Width="*" />
                                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="4*" />
                                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, Converter={StaticResource CurrencyConverter}}" Width="2*" />
                                    <DataGridTemplateColumn Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.RemoveShiftExpenseCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                        CommandParameter="{Binding ExpenseId}"
                                                        Style="{StaticResource MaterialDesignIconForegroundButton}" ToolTip="Remove" 
                                                        Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}"
                                                        IsEnabled="{Binding DataContext.IsShiftLocked, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource InverseBool}}">
                                                    <materialDesign:PackIcon Kind="Delete" Foreground="Red" />
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </materialDesign:Card>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
                    
                    <!-- TABLE E: FUEL DISPENSED & SALE -->
                    <materialDesign:Card Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="E. Fuel Dispensed &amp; Sale" Style="{StaticResource SectionTitle}" />
                            <DataGrid AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Type" Binding="{Binding FuelType}" Width="2*" />
                                    <DataGridTextColumn Header="Litres" Binding="{Binding Litres, Converter={StaticResource LitreConverter}}" Width="2*" />
                                    <DataGridTextColumn Header="Rate" Binding="{Binding Rate, Converter={StaticResource CurrencyConverter}}" Width="1.5*" />
                                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, Converter={StaticResource CurrencyConverter}}" Width="2*" FontWeight="Bold" />
                                </DataGrid.Columns>
                                <DataGrid.Items>
                                    <!-- Using dynamic binding to viewmodel properties via an anonymous type wrapper in code-behind or just static layout. For simplicity in XAML, we use static layout with binding -->
                                </DataGrid.Items>
                            </DataGrid>
                            
                            <!-- Static Layout for Table E to easily bind to individual properties -->
                            <Border BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}" BorderThickness="1" CornerRadius="4">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Headers -->
                                    <Border Grid.Row="0" Grid.ColumnSpan="4" Background="{DynamicResource MaterialDesign.Brush.Primary.Light}" Padding="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="2*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Type" Foreground="White" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="1" Text="Litres" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="2" Text="Rate" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="3" Text="Amount" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>

                                    <!-- HSD -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="HSD - 20KL" Padding="8" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding HsdLitres, Converter={StaticResource LitreConverter}}" Padding="8" TextAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding HsdRate, Converter={StaticResource CurrencyConverter}}" Padding="8" TextAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding HsdAmount, Converter={StaticResource CurrencyConverter}}" Padding="8" TextAlignment="Right" FontWeight="Bold" VerticalAlignment="Center"/>

                                    <!-- MS-I -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="MS - 20KL" Padding="8" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MsILitres, Converter={StaticResource LitreConverter}}" Padding="8" TextAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding MsIRate, Converter={StaticResource CurrencyConverter}}" Padding="8" TextAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding MsIAmount, Converter={StaticResource CurrencyConverter}}" Padding="8" TextAlignment="Right" FontWeight="Bold" VerticalAlignment="Center"/>

                                    <!-- MS-II -->
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="HSD - 20KL II" Padding="8" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding MsIILitres, Converter={StaticResource LitreConverter}}" Padding="8" TextAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding MsIIRate, Converter={StaticResource CurrencyConverter}}" Padding="8" TextAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding MsIIAmount, Converter={StaticResource CurrencyConverter}}" Padding="8" TextAlignment="Right" FontWeight="Bold" VerticalAlignment="Center"/>

                                    <!-- MS Total -->
                                    <Border Grid.Row="4" Grid.ColumnSpan="4" Background="#F5F5F5" BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}" BorderThickness="0,1,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="2*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Petrol Total" Padding="8" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding MsTotalLitres, Converter={StaticResource LitreConverter}}" Padding="8" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="3" Text="{Binding MsTotalAmount, Converter={StaticResource CurrencyConverter}}" Padding="8" TextAlignment="Right" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Total Fuel -->
                                    <Border Grid.Row="5" Grid.ColumnSpan="4" Background="{DynamicResource MaterialDesign.Brush.Surface}" BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}" BorderThickness="0,1,0,1">
                                        <Grid Margin="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="2*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Total Fuel" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding TotalLitres, Converter={StaticResource LitreConverter}}" TextAlignment="Right" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="3" Text="{Binding TotalFuelSaleAmount, Converter={StaticResource CurrencyConverter}}" TextAlignment="Right" FontWeight="Bold" Foreground="Green"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- TABLE B: CASH DETAILS -->
                    <materialDesign:Card Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="B. Cash Details" Style="{StaticResource SectionTitle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- B1: Cash 1 -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Bank Deposit" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding Cash1Total, Converter={StaticResource CurrencyConverter}, StringFormat='Total: {0}'}" FontSize="18" FontWeight="Bold" />
                                </StackPanel>

                                <!-- B2: Cash 2 -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Cash In Hand" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding Cash2Total, Converter={StaticResource CurrencyConverter}, StringFormat='Total: {0}'}" FontSize="18" FontWeight="Bold" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- TABLE F: RECONCILIATION -->
                    <materialDesign:Card Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="F. Final Reconciliation" Style="{StaticResource SectionTitle}" />
                            
                            <DataGrid ItemsSource="{Binding ReconciliationRows}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="None" MaxHeight="500">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Binding="{Binding Description}" Width="*" />
                                    <DataGridTextColumn Binding="{Binding Amount, Converter={StaticResource CurrencyConverter}}" Width="120">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            
                            <Border BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,8,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Total Amount (A)" FontWeight="Bold" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ReconciliationTotal, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Gross Sale (B)" FontWeight="Bold" Margin="0,8,0,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GrossSaleTotal, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" Margin="0,8,0,0"/>
                                </Grid>
                            </Border>

                            <Border Margin="0,16,0,0" Padding="16" CornerRadius="8" Background="{Binding Difference, Converter={StaticResource DiffBadgeBrushConverter}}">
                                <Grid>
                                    <TextBlock Text="Difference:" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="16" />
                                    <TextBlock Text="{Binding Difference, Converter={StaticResource DiffBadgeConverter}}" HorizontalAlignment="Right" Foreground="White" FontWeight="Bold" FontSize="20" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                        </StackPanel>
                    </materialDesign:Card>

                 </StackPanel>

                <!-- Nozzle Readings Grid Section (top of page) -->
                <materialDesign:Card Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource SectionCard}" Margin="0,0,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Nozzle Readings &amp; Tank Status" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                            <Button Content="Save Dip/Stock" Command="{Binding SaveTankStocksCommand}" 
                                    Style="{StaticResource MaterialDesignRaisedButton}" Background="#2E7D32" BorderBrush="#2E7D32"
                                    HorizontalAlignment="Right" Height="30" Padding="12,0" FontSize="12"
                                    IsEnabled="{Binding IsShiftLocked, Converter={StaticResource InverseBool}}"/>
                        </Grid>
                        
                        <ItemsControl ItemsSource="{Binding NozzleGroups}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <materialDesign:Card Margin="8" Padding="12" materialDesign:ElevationAssist.Elevation="Dp1" Background="{Binding GroupName, Converter={StaticResource FuelTypeToLightBgBrushConverter}}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            
                                            <!-- Group Header -->
                                            <Border Grid.Row="0" Background="{Binding GroupName, Converter={StaticResource FuelTypeToBrushConverter}}" CornerRadius="4" Padding="8" Margin="0,0,0,12">
                                                <TextBlock Text="{Binding GroupName}" FontWeight="Bold" Foreground="White" FontSize="15" HorizontalAlignment="Center"/>
                                            </Border>
                                            
                                             <!-- Tank Info (Grid Layout) -->
                                             <Grid Grid.Row="1" Margin="0,0,0,12">
                                                 <Grid.RowDefinitions>
                                                     <RowDefinition Height="Auto" />
                                                     <RowDefinition Height="Auto" />
                                                     <RowDefinition Height="Auto" />
                                                     <RowDefinition Height="Auto" />
                                                 </Grid.RowDefinitions>
                                                 <Grid.ColumnDefinitions>
                                                     <ColumnDefinition Width="*" />
                                                     <ColumnDefinition Width="*" />
                                                 </Grid.ColumnDefinitions>

                                                 <!-- Row 0: Dip (Top Left) and Stock (Top Right) editable inputs -->
                                                 <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="4,2" VerticalAlignment="Center">
                                                     <TextBlock Text="Dip: " FontWeight="Bold" FontSize="13" Opacity="0.85" VerticalAlignment="Center"/>
                                                     <TextBox Text="{Binding Dip, UpdateSourceTrigger=LostFocus, StringFormat={}{0:N2}}" FontWeight="Bold" FontSize="13" Width="60" 
                                                              IsEnabled="{Binding DataContext.IsShiftLocked, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBool}}"/>
                                                     <TextBlock Text=" mm" Opacity="0.75" FontSize="13" VerticalAlignment="Center"/>
                                                 </StackPanel>
                                                 <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="4,2" VerticalAlignment="Center">
                                                     <TextBlock Text="Stock: " FontWeight="Bold" FontSize="13" Foreground="Green" VerticalAlignment="Center"/>
                                                     <TextBox Text="{Binding Stock, UpdateSourceTrigger=LostFocus, StringFormat={}{0:N2}}" FontWeight="Bold" FontSize="13" Foreground="Green" Width="70" 
                                                              IsEnabled="{Binding DataContext.IsShiftLocked, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBool}}"/>
                                                     <TextBlock Text=" Ltr" FontWeight="Bold" FontSize="13" Foreground="Green" VerticalAlignment="Center"/>
                                                 </StackPanel>

                                                 <!-- Row 1: Opening Stock and Sales -->
                                                 <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="4,2" VerticalAlignment="Center">
                                                     <TextBlock Text="Opening: " Opacity="0.6" FontSize="11" VerticalAlignment="Center"/>
                                                     <TextBlock Text="{Binding OpeningStock, StringFormat={}{0:N2}}" FontWeight="SemiBold" Opacity="0.8" FontSize="11" VerticalAlignment="Center"/>
                                                     <TextBlock Text=" L" Opacity="0.6" FontSize="11" VerticalAlignment="Center"/>
                                                 </StackPanel>
                                                 <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="4,2" VerticalAlignment="Center">
                                                     <TextBlock Text="Sales: " Opacity="0.6" FontSize="11" VerticalAlignment="Center"/>
                                                     <TextBlock Text="{Binding FuelDispensed, StringFormat={}{0:N2}}" FontWeight="SemiBold" Opacity="0.8" FontSize="11" VerticalAlignment="Center"/>
                                                     <TextBlock Text=" L" Opacity="0.6" FontSize="11" VerticalAlignment="Center"/>
                                                 </StackPanel>

                                                 <!-- Row 2: Testing and Receipts -->
                                                 <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="4,2" VerticalAlignment="Center">
                                                     <TextBlock Text="Testing: " Opacity="0.6" FontSize="11" VerticalAlignment="Center"/>
                                                     <TextBlock Text="{Binding TestingLitres, StringFormat={}{0:N2}}" FontWeight="SemiBold" Opacity="0.8" FontSize="11" VerticalAlignment="Center"/>
                                                     <TextBlock Text=" L" Opacity="0.6" FontSize="11" VerticalAlignment="Center"/>
                                                 </StackPanel>
                                                 <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="4,2" VerticalAlignment="Center">
                                                     <TextBlock Text="Receipts: " Opacity="0.6" FontSize="11" VerticalAlignment="Center"/>
                                                     <TextBlock Text="{Binding Receipts, StringFormat={}{0:N2}}" FontWeight="SemiBold" Opacity="0.8" FontSize="11" VerticalAlignment="Center"/>
                                                     <TextBlock Text=" L" Opacity="0.6" FontSize="11" VerticalAlignment="Center"/>
                                                 </StackPanel>

                                                 <!-- Row 3: Calculated Stock -->
                                                 <Border Grid.Row="3" Grid.ColumnSpan="2" BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}" BorderThickness="0,1,0,0" Margin="0,4,0,0" Padding="0,4,0,0">
                                                     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="4,2">
                                                         <TextBlock Text="Calculated: " Opacity="0.7" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                                         <TextBlock Text="{Binding CalculatedStock, StringFormat={}{0:N2}}" FontWeight="Bold" Opacity="0.9" FontSize="11" VerticalAlignment="Center"/>
                                                         <TextBlock Text=" L" Opacity="0.7" FontSize="11" VerticalAlignment="Center"/>
                                                     </StackPanel>
                                                 </Border>
                                             </Grid>
                                            
                                            <!-- Nozzles Table -->
                                            <StackPanel Grid.Row="2">
                                                <!-- Table Header -->
                                                <Border BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}" BorderThickness="0,0,0,1" Padding="0,4,0,4" Margin="0,0,0,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="60" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="NOZ" FontWeight="Bold" FontSize="11" Opacity="0.7" Margin="4,0,0,0"/>
                                                        <TextBlock Grid.Column="1" Text="OPENING" FontWeight="Bold" FontSize="11" Opacity="0.7" HorizontalAlignment="Right"/>
                                                        <TextBlock Grid.Column="2" Text="CLOSING" FontWeight="Bold" FontSize="11" Opacity="0.7" HorizontalAlignment="Right"/>
                                                        <TextBlock Grid.Column="3" Text="SALE" FontWeight="Bold" FontSize="11" Opacity="0.7" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Table Rows -->
                                                <ItemsControl ItemsSource="{Binding FlatNozzles}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}" BorderThickness="0,0,0,1" Padding="0,6,0,6">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasReading}" Value="False">
                                                                                <Setter Property="Opacity" Value="0.4" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="60" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="{Binding NozzleNumber, StringFormat='N{0}'}" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding OpeningReading, StringFormat='{}{0:F2}'}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="2" Text="{Binding ClosingReading, StringFormat='{}{0:F2}'}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="3" Text="{Binding SaleLitres, Converter={StaticResource LitreConverter}}" FontWeight="Bold" Foreground="Green" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Grid>
                                    </materialDesign:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </materialDesign:Card>

                <!-- DEBTOR MANAGEMENT SECTION -->
                <materialDesign:Card Grid.Row="3" Grid.ColumnSpan="2" Margin="0,16,0,0" Padding="0" UniformCornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp3">
                    <views:DebtorManagementView DataContext="{Binding DebtorManagementVm}" MinHeight="650"/>
                </materialDesign:Card>

            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
