<UserControl x:Class="FuelPro.UI.Views.DayTotalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:FuelPro.UI.Converters"
             xmlns:viewmodels="clr-namespace:FuelPro.UI.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:DayTotalViewModel}"
             d:DesignHeight="1000" d:DesignWidth="1200"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <converters:IndianCurrencyConverter x:Key="CurrencyConverter" />
        <converters:LitreFormatConverter x:Key="LitreConverter" />
        <converters:DifferenceBadgeConverter x:Key="DiffBadgeConverter" />
        <converters:DifferenceBadgeBrushConverter x:Key="DiffBadgeBrushConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <converters:InverseBoolConverter x:Key="InverseBool" />
        <converters:PumpIdDisplayConverter x:Key="PumpIdConverter" />
        <converters:FuelTypeToBrushConverter x:Key="FuelTypeToBrushConverter" />
        <converters:FuelTypeToLightBgBrushConverter x:Key="FuelTypeToLightBgBrushConverter" />

        <Style TargetType="materialDesign:Card" x:Key="SectionCard">
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Surface}" />
            <Setter Property="UniformCornerRadius" Value="8" />
        </Style>

        <Style TargetType="TextBlock" x:Key="SectionTitle">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Divider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource MaterialDesign.Brush.Divider}" />
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource MaterialDesign.Brush.Divider}" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource MaterialDesign.Brush.Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <materialDesign:Card Grid.Row="0" Margin="16" Padding="16" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="0,0,24,0">
                    <materialDesign:PackIcon Kind="CalendarMonth" Width="24" Height="24" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" Margin="0,0,8,0"/>
                    <TextBlock Text="Day Total Reconciliation" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                              Width="130" Margin="0,0,8,0" materialDesign:HintAssist.Hint="Range Preset"
                              Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                              IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}"/>
                    <DatePicker SelectedDate="{Binding StartDate}" Width="130" Margin="0,0,8,0"
                                materialDesign:HintAssist.Hint="From Date"
                                Style="{StaticResource MaterialDesignFloatingHintDatePicker}"
                                IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}"/>
                    <DatePicker SelectedDate="{Binding EndDate}" Width="130"
                                materialDesign:HintAssist.Hint="To Date"
                                Style="{StaticResource MaterialDesignFloatingHintDatePicker}"
                                IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MaterialDesign.Brush.Error}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Content="Load Day Data" Command="{Binding RefreshCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding ManagerOptions}" SelectedItem="{Binding SelectedShift1Manager}" IsEditable="True"
                              materialDesign:HintAssist.Hint="Shift 1 Manager" Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                              Width="130" Margin="0,0,8,0" VerticalAlignment="Center" IsEnabled="{Binding HasData}"/>
                    <ComboBox ItemsSource="{Binding ManagerOptions}" SelectedItem="{Binding SelectedShift2Manager}" IsEditable="True"
                              materialDesign:HintAssist.Hint="Shift 2 Manager" Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                              Width="130" Margin="0,0,8,0" VerticalAlignment="Center" IsEnabled="{Binding HasData}"/>
                    <Button Command="{Binding ExportExcelCommand}" Style="{StaticResource MaterialDesignFlatMidBgButton}" Height="36" Padding="12,0" Margin="0,0,8,0" Background="#1B5E20" BorderBrush="#1B5E20" ToolTip="Export Day Total to Excel" IsEnabled="{Binding HasData}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileExcel" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Export Excel" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Content="Print" Click="PrintButton_Click" Style="{StaticResource MaterialDesignOutlinedButton}" IsEnabled="{Binding HasData}" />
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <!-- MAIN CONTENT -->
        <ScrollViewer Grid.Row="1" Padding="16,0,16,16" VerticalScrollBarVisibility="Auto">
            <Grid Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><!-- Row 0: Nozzle Readings (top) -->
                    <RowDefinition Height="Auto" /><!-- Row 1: Collections + Summary -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*" />
                    <ColumnDefinition Width="4*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">

                    <!-- TABLE 2: COLLECTIONS -->
                    <materialDesign:Card Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="2. Total Digital &amp; Cash Collections" Style="{StaticResource SectionTitle}" Margin="0" />
                                <TextBlock Text="{Binding TotalDigitalAndCash, Converter={StaticResource CurrencyConverter}, StringFormat='Total: {0}'}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                            </Grid>
                            
                            <Grid Margin="0,12,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Headers -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Collection Mode" FontWeight="SemiBold" Opacity="0.6" FontSize="12" Margin="4,4,4,8"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Day (Morning)" FontWeight="SemiBold" Opacity="0.6" FontSize="12" HorizontalAlignment="Right" Margin="4,4,4,8"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Night" FontWeight="SemiBold" Opacity="0.6" FontSize="12" HorizontalAlignment="Right" Margin="4,4,4,8"/>
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="Total" FontWeight="SemiBold" Opacity="0.6" FontSize="12" HorizontalAlignment="Right" Margin="4,4,4,8"/>

                                <!-- Cash Row -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Cash Collection" FontSize="14" VerticalAlignment="Center" Margin="4,6"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="-" FontSize="14" HorizontalAlignment="Right" Opacity="0.4" VerticalAlignment="Center" Margin="4,6"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="-" FontSize="14" HorizontalAlignment="Right" Opacity="0.4" VerticalAlignment="Center" Margin="4,6"/>
                                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding SplitCash, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" FontSize="14" Foreground="#2E7D32" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="4,6"/>

                                <!-- PhonePe Direct Row -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="PhonePe Direct" FontSize="14" VerticalAlignment="Center" Margin="4,6"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PhonePeMorningTotal, Converter={StaticResource CurrencyConverter}}" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="4,6"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding PhonePeNightTotal, Converter={StaticResource CurrencyConverter}}" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="4,6"/>
                                <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding PhonePeTotal, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" FontSize="14" Foreground="#1565C0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="4,6"/>

                                <!-- PhonePe Card Row REMOVED - not used by this client -->

                                <!-- PineLabs Card Row -->
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="PineLabs Card" FontSize="14" VerticalAlignment="Center" Margin="4,6"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CreditCardMorningTotal, Converter={StaticResource CurrencyConverter}}" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="4,6"/>
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding CreditCardNightTotal, Converter={StaticResource CurrencyConverter}}" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="4,6"/>
                                <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding CreditCardTotal, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" FontSize="14" Foreground="#E65100" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="4,6"/>

                                <!-- Petro Card Row -->
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Petro Card" FontSize="14" VerticalAlignment="Center" Margin="4,6"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="-" FontSize="14" HorizontalAlignment="Right" Opacity="0.4" VerticalAlignment="Center" Margin="4,6"/>
                                <TextBlock Grid.Row="4" Grid.Column="2" Text="-" FontSize="14" HorizontalAlignment="Right" Opacity="0.4" VerticalAlignment="Center" Margin="4,6"/>
                                <TextBlock Grid.Row="4" Grid.Column="3" Text="{Binding PetroCardTotal, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" FontSize="14" Foreground="#6A1B9A" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="4,6"/>

                                <!-- Credit Row -->
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Credit (Debtors)" FontSize="14" VerticalAlignment="Center" Margin="4,6"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="-" FontSize="14" HorizontalAlignment="Right" Opacity="0.4" VerticalAlignment="Center" Margin="4,6"/>
                                <TextBlock Grid.Row="5" Grid.Column="2" Text="-" FontSize="14" HorizontalAlignment="Right" Opacity="0.4" VerticalAlignment="Center" Margin="4,6"/>
                                <TextBlock Grid.Row="5" Grid.Column="3" Text="{Binding SplitCredit, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" FontSize="14" Foreground="#BF360C" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="4,6"/>

                                <!-- Others Row -->
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Other Collections" FontSize="14" VerticalAlignment="Center" Margin="4,6"/>
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="-" FontSize="14" HorizontalAlignment="Right" Opacity="0.4" VerticalAlignment="Center" Margin="4,6"/>
                                <TextBlock Grid.Row="6" Grid.Column="2" Text="-" FontSize="14" HorizontalAlignment="Right" Opacity="0.4" VerticalAlignment="Center" Margin="4,6"/>
                                <TextBlock Grid.Row="6" Grid.Column="3" Text="{Binding OthersTotal, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" FontSize="14" Foreground="#F57F17" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="4,6"/>
                            </Grid>
                        </StackPanel>
                    </materialDesign:Card>
                    
                    <!-- TABLE 4: EXPENSES -->
                    <materialDesign:Card Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="4. Day Expenses" Style="{StaticResource SectionTitle}" Margin="0" />
                                <TextBlock Text="{Binding ExpensesTotal, Converter={StaticResource CurrencyConverter}, StringFormat='Total: {0}'}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="16" Foreground="Red" />
                            </Grid>
                            <DataGrid ItemsSource="{Binding ExpenseRows}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="200" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="DSM / Shift" Binding="{Binding DsmName}" Width="*" />
                                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*" />
                                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, Converter={StaticResource CurrencyConverter}}" Width="Auto" FontWeight="Bold" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </materialDesign:Card>

                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
                    
                    <!-- TABLE 3: CREDITORS -->
                    <materialDesign:Card Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="3. Debtors / Debit Register" Style="{StaticResource SectionTitle}" Margin="0" />
                                <TextBlock Text="{Binding CreditorsTotal, Converter={StaticResource CurrencyConverter}, StringFormat='Total: {0}'}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource MaterialDesign.Brush.Error}" />
                            </Grid>
                            <DataGrid ItemsSource="{Binding CreditorRows}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="300">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="DSM" Binding="{Binding DsmName}" Width="*" />
                                    <DataGridTextColumn Header="Debtor Name" Binding="{Binding DebtorName}" Width="2*" />
                                    <DataGridTextColumn Header="Slip No" Binding="{Binding ChequeNo}" Width="*" />
                                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, Converter={StaticResource CurrencyConverter}}" Width="Auto" FontWeight="Bold"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- DAY DEBTOR RECOVERIES -->
                    <materialDesign:Card Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="3b. Day Debtor Recoveries (Collections)" Style="{StaticResource SectionTitle}" Margin="0" />
                                <TextBlock Text="{Binding CurrentReport.DebtorRepaymentsTotal, Converter={StaticResource CurrencyConverter}, StringFormat='Total: {0}'}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="16" Foreground="Green" />
                            </Grid>
                            <DataGrid ItemsSource="{Binding DebtorRepayments}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="300">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Debtor Name" Binding="{Binding CreditorName}" Width="2*" />
                                    <DataGridTextColumn Header="Mode" Binding="{Binding PaymentMode}" Width="*" />
                                    <DataGridTextColumn Header="Details" Binding="{Binding ReferenceDisplay}" Width="2*" />
                                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, Converter={StaticResource CurrencyConverter}}" Width="Auto" FontWeight="Bold"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- TABLE 5: RECONCILIATION -->
                    <materialDesign:Card Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="5. Final Day Reconciliation" Style="{StaticResource SectionTitle}" />
                            
                            <Border BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}" BorderThickness="0,0,0,1" Margin="0,0,0,8" Padding="0,0,0,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Digital &amp; Cash Collection" Margin="0,4" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TotalDigitalAndCash, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" Margin="0,4" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Debtors" Margin="0,4" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CreditorsTotal, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" Margin="0,4" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Total Expenses" Margin="0,4" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ExpensesTotal, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" Margin="0,4" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding MsTestingLabel}" Margin="0,4" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding MsTesting, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" Margin="0,4" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding HsdTestingLabel}" Margin="0,4" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding HsdTesting, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" Margin="0,4" />

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding HsdTesting2Label}" Margin="0,4" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding HsdTesting2, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" Margin="0,4" />

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="{Binding CngTestingLabel}" Margin="0,4" />
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding CngTesting, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" Margin="0,4" />
                                    
                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Total DSM Short" Margin="0,4" FontWeight="Bold" Foreground="Red" />
                                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding TotalDsmShort, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" Foreground="Red" Margin="0,4" />
                                </Grid>
                            </Border>
                            
                            <Border BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,8,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Total Collection (A)" FontWeight="Bold" FontSize="16" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ReconciliationTotalAmount, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Total Day Sale (B)" FontWeight="Bold" Margin="0,8,0,0" FontSize="16"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GrossDaySaleTotal, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" Margin="0,8,0,0" FontSize="16" Foreground="Green"/>
                                </Grid>
                            </Border>

                            <Border Margin="0,24,0,0" Padding="16" CornerRadius="8" Background="{Binding Difference, Converter={StaticResource DiffBadgeBrushConverter}}">
                                <Grid>
                                    <TextBlock Text="Difference:" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="16" />
                                    <TextBlock Text="{Binding Difference, Converter={StaticResource DiffBadgeConverter}}" HorizontalAlignment="Right" Foreground="White" FontWeight="Bold" FontSize="20" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                        </StackPanel>
                    </materialDesign:Card>

                </StackPanel>

                <!-- 1. Nozzle-wise Fuel Sale & Tank Status (top of page) -->
                <materialDesign:Card Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource SectionCard}" Margin="0,0,0,0">
                    <StackPanel>
                        <TextBlock Text="1. Nozzle-wise Fuel Sale &amp; Tank Status (Shift A Opening to Shift B Closing)" Style="{StaticResource SectionTitle}" />
                        
                        <ItemsControl ItemsSource="{Binding NozzleGroups}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <materialDesign:Card Margin="8" Padding="12" materialDesign:ElevationAssist.Elevation="Dp1" Background="{Binding GroupName, Converter={StaticResource FuelTypeToLightBgBrushConverter}}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            
                                            <!-- Group Header -->
                                            <Border Grid.Row="0" Background="{DynamicResource MaterialDesign.Brush.Primary.Light}" CornerRadius="4" Padding="8" Margin="0,0,0,12">
                                                <TextBlock Text="{Binding GroupName}" FontWeight="Bold" Foreground="White" FontSize="15" HorizontalAlignment="Center"/>
                                            </Border>
                                            
                                             <!-- Tank Info (Grid Layout) -->
                                             <Grid Grid.Row="1" Margin="0,0,0,12">
                                                 <Grid.RowDefinitions>
                                                     <RowDefinition Height="Auto" />
                                                     <RowDefinition Height="Auto" />
                                                     <RowDefinition Height="Auto" />
                                                     <RowDefinition Height="Auto" />
                                                 </Grid.RowDefinitions>
                                                 <Grid.ColumnDefinitions>
                                                     <ColumnDefinition Width="*" />
                                                     <ColumnDefinition Width="*" />
                                                 </Grid.ColumnDefinitions>

                                                 <!-- Row 0: Dip (Top Left) and Stock (Top Right) -->
                                                 <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="4,2" VerticalAlignment="Center">
                                                     <TextBlock Text="Dip: " FontWeight="Bold" FontSize="13" Opacity="0.85" VerticalAlignment="Center"/>
                                                     <TextBlock Text="{Binding Dip, StringFormat={}{0:N2}}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                                     <TextBlock Text=" mm" Opacity="0.75" FontSize="13" VerticalAlignment="Center"/>
                                                 </StackPanel>
                                                 <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="4,2" VerticalAlignment="Center">
                                                     <TextBlock Text="Stock: " FontWeight="Bold" FontSize="13" Foreground="Green" VerticalAlignment="Center"/>
                                                     <TextBlock Text="{Binding Stock, StringFormat={}{0:N2}}" FontWeight="Bold" FontSize="13" Foreground="Green" VerticalAlignment="Center"/>
                                                     <TextBlock Text=" Ltr" FontWeight="Bold" FontSize="13" Foreground="Green" VerticalAlignment="Center"/>
                                                 </StackPanel>

                                                 <!-- Row 1: Opening Stock and Sales -->
                                                 <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="4,2" VerticalAlignment="Center">
                                                     <TextBlock Text="Opening: " Opacity="0.6" FontSize="11" VerticalAlignment="Center"/>
                                                     <TextBlock Text="{Binding OpeningStock, StringFormat={}{0:N2}}" FontWeight="SemiBold" Opacity="0.8" FontSize="11" VerticalAlignment="Center"/>
                                                     <TextBlock Text=" L" Opacity="0.6" FontSize="11" VerticalAlignment="Center"/>
                                                 </StackPanel>
                                                 <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="4,2" VerticalAlignment="Center">
                                                     <TextBlock Text="Sales: " Opacity="0.6" FontSize="11" VerticalAlignment="Center"/>
                                                     <TextBlock Text="{Binding FuelDispensed, StringFormat={}{0:N2}}" FontWeight="SemiBold" Opacity="0.8" FontSize="11" VerticalAlignment="Center"/>
                                                     <TextBlock Text=" L" Opacity="0.6" FontSize="11" VerticalAlignment="Center"/>
                                                 </StackPanel>

                                                 <!-- Row 2: Testing and Receipts -->
                                                 <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="4,2" VerticalAlignment="Center">
                                                     <TextBlock Text="Testing: " Opacity="0.6" FontSize="11" VerticalAlignment="Center"/>
                                                     <TextBlock Text="{Binding TestingLitres, StringFormat={}{0:N2}}" FontWeight="SemiBold" Opacity="0.8" FontSize="11" VerticalAlignment="Center"/>
                                                     <TextBlock Text=" L" Opacity="0.6" FontSize="11" VerticalAlignment="Center"/>
                                                 </StackPanel>
                                                 <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="4,2" VerticalAlignment="Center">
                                                     <TextBlock Text="Receipts: " Opacity="0.6" FontSize="11" VerticalAlignment="Center"/>
                                                     <TextBlock Text="{Binding Receipts, StringFormat={}{0:N2}}" FontWeight="SemiBold" Opacity="0.8" FontSize="11" VerticalAlignment="Center"/>
                                                     <TextBlock Text=" L" Opacity="0.6" FontSize="11" VerticalAlignment="Center"/>
                                                 </StackPanel>

                                                 <!-- Row 3: Calculated Stock -->
                                                 <Border Grid.Row="3" Grid.ColumnSpan="2" BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}" BorderThickness="0,1,0,0" Margin="0,4,0,0" Padding="0,4,0,0">
                                                     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="4,2">
                                                         <TextBlock Text="Calculated: " Opacity="0.7" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                                         <TextBlock Text="{Binding CalculatedStock, StringFormat={}{0:N2}}" FontWeight="Bold" Opacity="0.9" FontSize="11" VerticalAlignment="Center"/>
                                                         <TextBlock Text=" L" Opacity="0.7" FontSize="11" VerticalAlignment="Center"/>
                                                     </StackPanel>
                                                 </Border>
                                             </Grid>
                                            
                                            <!-- Nozzles Table -->
                                            <StackPanel Grid.Row="2">
                                                <!-- Table Header -->
                                                <Border BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}" BorderThickness="0,0,0,1" Padding="0,4,0,4" Margin="0,0,0,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="60" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="NOZ" FontWeight="Bold" FontSize="11" Opacity="0.7" Margin="4,0,0,0"/>
                                                        <TextBlock Grid.Column="1" Text="OPENING" FontWeight="Bold" FontSize="11" Opacity="0.7" HorizontalAlignment="Right"/>
                                                        <TextBlock Grid.Column="2" Text="CLOSING" FontWeight="Bold" FontSize="11" Opacity="0.7" HorizontalAlignment="Right"/>
                                                        <TextBlock Grid.Column="3" Text="SALE" FontWeight="Bold" FontSize="11" Opacity="0.7" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Table Rows -->
                                                <ItemsControl ItemsSource="{Binding FlatNozzles}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}" BorderThickness="0,0,0,1" Padding="0,6,0,6">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasReading}" Value="False">
                                                                                <Setter Property="Opacity" Value="0.4" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="60" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="{Binding NozzleNumber, StringFormat='N{0}'}" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding OpeningReading, StringFormat='{}{0:F2}'}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="2" Text="{Binding ClosingReading, StringFormat='{}{0:F2}'}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="3" Text="{Binding SaleLitres, Converter={StaticResource LitreConverter}}" FontWeight="Bold" Foreground="Green" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Grid>
                                    </materialDesign:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        
                        <!-- Totals Bar -->
                        <Border Background="{DynamicResource MaterialDesign.Brush.Primary.Light}" Padding="12" Margin="8,16,8,8" CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="TOTAL DAY FUEL SALE" FontWeight="Bold" Foreground="White" FontSize="15" />
                                <TextBlock Grid.Column="1" Text="{Binding TotalDayLitres, Converter={StaticResource LitreConverter}, StringFormat='Total Litres: {0}'}" Foreground="White" Margin="0,0,24,0" FontWeight="Bold" FontSize="15" />
                                <TextBlock Grid.Column="2" Text="{Binding TotalDayFuelSaleAmount, Converter={StaticResource CurrencyConverter}, StringFormat='Amount: {0}'}" FontWeight="Bold" Foreground="White" FontSize="15" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </materialDesign:Card>

            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
