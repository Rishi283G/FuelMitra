<UserControl x:Class="FuelPro.UI.Views.DayTotalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:FuelPro.UI.Converters"
             xmlns:viewmodels="clr-namespace:FuelPro.UI.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:DayTotalViewModel}"
             d:DesignHeight="1000" d:DesignWidth="1200"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <converters:IndianCurrencyConverter x:Key="CurrencyConverter" />
        <converters:LitreFormatConverter x:Key="LitreConverter" />
        <converters:DifferenceBadgeConverter x:Key="DiffBadgeConverter" />
        <converters:DifferenceBadgeBrushConverter x:Key="DiffBadgeBrushConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <converters:InverseBoolConverter x:Key="InverseBool" />
        <converters:PumpIdDisplayConverter x:Key="PumpIdConverter" />

        <Style TargetType="materialDesign:Card" x:Key="SectionCard">
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Surface}" />
            <Setter Property="UniformCornerRadius" Value="8" />
        </Style>

        <Style TargetType="TextBlock" x:Key="SectionTitle">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style TargetType="DataGrid" BasedOn="{StaticResource MaterialDesignDataGrid}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Divider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource MaterialDesign.Brush.Divider}" />
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource MaterialDesign.Brush.Divider}" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource MaterialDesign.Brush.Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <materialDesign:Card Grid.Row="0" Margin="16" Padding="16" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="0,0,24,0">
                    <materialDesign:PackIcon Kind="CalendarMonth" Width="24" Height="24" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" Margin="0,0,8,0"/>
                    <TextBlock Text="Day Total Reconciliation" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>

                <DatePicker Grid.Column="1" materialDesign:HintAssist.Hint="Select Date" Style="{StaticResource MaterialDesignFloatingHintDatePicker}"
                            SelectedDate="{Binding SelectedDate}" Width="150" Margin="0,0,16,0" IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MaterialDesign.Brush.Error}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Content="Load Day Data" Command="{Binding RefreshCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0" />
                    <Button Content="Print" Click="PrintButton_Click" Style="{StaticResource MaterialDesignOutlinedButton}" IsEnabled="{Binding HasData}" />
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <!-- MAIN CONTENT -->
        <ScrollViewer Grid.Row="1" Padding="16,0,16,16" VerticalScrollBarVisibility="Auto">
            <Grid Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*" />
                    <ColumnDefinition Width="4*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    
                    <!-- TABLE 1: NOZZLE SALE -->
                    <materialDesign:Card Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="1. Nozzle-wise Fuel Sale (Shift A Opening to Shift C Closing)" Style="{StaticResource SectionTitle}" />
                            <DataGrid ItemsSource="{Binding NozzleSaleRows}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="400">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Pump" Binding="{Binding PumpId, Converter={StaticResource PumpIdConverter}}" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="Fuel" Binding="{Binding FuelType}" />
                                    <DataGridTextColumn Header="Opening" Binding="{Binding OpeningReading, StringFormat='F2'}" Foreground="Gray"/>
                                    <DataGridTextColumn Header="Closing" Binding="{Binding ClosingReading, StringFormat='F2'}" Foreground="Black" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="Gross (L)" Binding="{Binding GrossLitres, Converter={StaticResource LitreConverter}}" />
                                    <DataGridTextColumn Header="Net Sale" Binding="{Binding NetSaleLitres, Converter={StaticResource LitreConverter}}" FontWeight="Bold" Foreground="Green" />
                                    <DataGridTextColumn Header="Rate" Binding="{Binding Rate, Converter={StaticResource CurrencyConverter}}" />
                                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            
                            <Border Background="{DynamicResource MaterialDesign.Brush.Primary.Light}" Padding="8" Margin="0,8,0,0" CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="TOTAL FUEL SALE" FontWeight="Bold" Foreground="White" />
                                    <TextBlock Grid.Column="1" Text="{Binding TotalDayLitres, Converter={StaticResource LitreConverter}, StringFormat='Total Litres: {0}'}" Foreground="White" Margin="0,0,16,0" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="{Binding TotalDayFuelSaleAmount, Converter={StaticResource CurrencyConverter}, StringFormat='Amount: {0}'}" FontWeight="Bold" Foreground="White" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- TABLE 2: COLLECTIONS -->
                    <materialDesign:Card Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="2. Total Digital &amp; Cash Collections" Style="{StaticResource SectionTitle}" Margin="0" />
                                <TextBlock Text="{Binding TotalDigitalAndCash, Converter={StaticResource CurrencyConverter}, StringFormat='Total: {0}'}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                            </Grid>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                
                                <!-- Left Side: Digital Collections -->
                                <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="#E0E0E0" Padding="0,0,16,0" Margin="0,0,16,0">
                                    <StackPanel>
                                        <TextBlock Text="Digital Collections" FontWeight="SemiBold" Margin="0,0,0,12" Foreground="{DynamicResource MaterialDesign.Brush.Primary.Light}" />
                                        <UniformGrid Columns="2">
                                            <StackPanel Margin="0,0,0,12">
                                                <TextBlock Text="PhonePe" Foreground="Gray" FontSize="12"/>
                                                <TextBlock Text="{Binding PhonePeTotal, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" FontSize="16"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,0,12">
                                                <TextBlock Text="PhonePe Card (Morning)" Foreground="Gray" FontSize="12"/>
                                                <TextBlock Text="{Binding PhonePeCardMorningTotal, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" FontSize="16"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,0,12">
                                                <TextBlock Text="PhonePe Card (Night)" Foreground="Gray" FontSize="12"/>
                                                <TextBlock Text="{Binding PhonePeCardNightTotal, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" FontSize="16"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,0,12">
                                                <TextBlock Text="PineLab Card (Morning)" Foreground="Gray" FontSize="12"/>
                                                <TextBlock Text="{Binding CreditCardMorningTotal, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" FontSize="16"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,0,12">
                                                <TextBlock Text="PineLab Card (Night)" Foreground="Gray" FontSize="12"/>
                                                <TextBlock Text="{Binding CreditCardNightTotal, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" FontSize="16"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,0,12">
                                                <TextBlock Text="Petro Card" Foreground="Gray" FontSize="12"/>
                                                <TextBlock Text="{Binding PetroCardTotal, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" FontSize="16"/>
                                            </StackPanel>
                                        </UniformGrid>
                                        <Border BorderThickness="0,1,0,0" BorderBrush="#E0E0E0" Margin="0,8,0,0" Padding="0,8,0,0">
                                            <Grid>
                                                <TextBlock Text="Total Digital:" FontWeight="SemiBold" Foreground="Gray"/>
                                                <TextBlock Text="{Binding TotalDigital, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                
                                <!-- Right Side: Cash Collections -->
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Cash Collections" FontWeight="SemiBold" Margin="0,0,0,12" Foreground="{DynamicResource MaterialDesign.Brush.Primary.Light}" />
                                    <UniformGrid Columns="2">
                                        <StackPanel Margin="0,0,0,12">
                                            <TextBlock Text="Bank Cash (Cash Deposit)" Foreground="Gray" FontSize="12"/>
                                            <TextBlock Text="{Binding BankCashTotal, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" FontSize="16"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,12">
                                            <TextBlock Text="Cash In Hand" Foreground="Gray" FontSize="12"/>
                                            <TextBlock Text="{Binding CashInHandTotal, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" FontSize="16"/>
                                        </StackPanel>
                                    </UniformGrid>
                                    <Border BorderThickness="0,1,0,0" BorderBrush="#E0E0E0" Margin="0,8,0,0" Padding="0,8,0,0">
                                        <Grid>
                                            <TextBlock Text="Total Cash:" FontWeight="SemiBold" Foreground="Gray"/>
                                            <TextBlock Text="{Binding TotalCash, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </materialDesign:Card>
                    
                    <!-- TABLE 4: EXPENSES -->
                    <materialDesign:Card Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="4. Day Expenses" Style="{StaticResource SectionTitle}" Margin="0" />
                                <TextBlock Text="{Binding ExpensesTotal, Converter={StaticResource CurrencyConverter}, StringFormat='Total: {0}'}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="16" Foreground="Red" />
                            </Grid>
                            <DataGrid ItemsSource="{Binding ExpenseRows}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="200" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="DSM / Shift" Binding="{Binding DsmName}" Width="*" />
                                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*" />
                                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, Converter={StaticResource CurrencyConverter}}" Width="Auto" FontWeight="Bold" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </materialDesign:Card>

                </StackPanel>

                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    
                    <!-- TABLE 3: CREDITORS -->
                    <materialDesign:Card Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="3. Creditors / Debit Register" Style="{StaticResource SectionTitle}" Margin="0" />
                                <TextBlock Text="{Binding CreditorsTotal, Converter={StaticResource CurrencyConverter}, StringFormat='Total: {0}'}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource MaterialDesign.Brush.Error}" />
                            </Grid>
                            <DataGrid ItemsSource="{Binding CreditorRows}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="300">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="DSM" Binding="{Binding DsmName}" Width="*" />
                                    <DataGridTextColumn Header="Debtor Name" Binding="{Binding DebtorName}" Width="2*" />
                                    <DataGridTextColumn Header="Cheque No" Binding="{Binding ChequeNo}" Width="*" />
                                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, Converter={StaticResource CurrencyConverter}}" Width="Auto" FontWeight="Bold"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- TABLE 5: RECONCILIATION -->
                    <materialDesign:Card Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="5. Final Day Reconciliation" Style="{StaticResource SectionTitle}" />
                            
                            <Border BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}" BorderThickness="0,0,0,1" Margin="0,0,0,8" Padding="0,0,0,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Digital &amp; Cash Collection" Margin="0,4" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TotalDigitalAndCash, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" Margin="0,4" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Debtors / Creditors" Margin="0,4" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CreditorsTotal, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" Margin="0,4" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Total Expenses" Margin="0,4" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ExpensesTotal, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" Margin="0,4" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Total Testing (MS + HSD)" Margin="0,4" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="Included in Totals" Opacity="0.5" Margin="0,4" />
                                    
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Total DSM Short" Margin="0,4" FontWeight="Bold" Foreground="Red" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding TotalDsmShort, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" Foreground="Red" Margin="0,4" />
                                </Grid>
                            </Border>
                            
                            <Border BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,8,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Total Collection (A)" FontWeight="Bold" FontSize="16" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ReconciliationTotalAmount, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Total Day Sale (B)" FontWeight="Bold" Margin="0,8,0,0" FontSize="16"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GrossDaySaleTotal, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" Margin="0,8,0,0" FontSize="16" Foreground="Green"/>
                                </Grid>
                            </Border>

                            <Border Margin="0,24,0,0" Padding="16" CornerRadius="8" Background="{Binding Difference, Converter={StaticResource DiffBadgeBrushConverter}}">
                                <Grid>
                                    <TextBlock Text="Difference:" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="16" />
                                    <TextBlock Text="{Binding Difference, Converter={StaticResource DiffBadgeConverter}}" HorizontalAlignment="Right" Foreground="White" FontWeight="Bold" FontSize="20" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                        </StackPanel>
                    </materialDesign:Card>

                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
