<Window x:Class="FuelPro.UI.Views.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Fuel Pro Lite — Activation"
        Width="500" Height="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesign.Brush.Primary.Light}"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <Grid>
        <materialDesign:Card Margin="30,40,30,40"
                             Padding="24"
                             materialDesign:ElevationAssist.Elevation="Dp8"
                             UniformCornerRadius="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel VerticalAlignment="Center">
                    <!-- Shield Icon -->
                    <materialDesign:PackIcon Kind="Key" Width="64" Height="64"
                                             Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                             HorizontalAlignment="Center" Margin="0,0,0,8"/>

                    <TextBlock Text="Product Activation" FontSize="26" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>

                    <TextBlock Text="Universal Licensing System" FontSize="12"
                               HorizontalAlignment="Center" Opacity="0.6" Margin="0,4,0,24"/>

                    <!-- Device ID (Read-only) with Copy Button -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="Device ID (Read Only)"
                                 materialDesign:HintAssist.IsFloating="True"
                                 Text="{Binding DeviceId}"
                                 IsReadOnly="True"
                                 IsReadOnlyCaretVisible="True"
                                 Focusable="True"
                                 FontSize="14"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                        <Button Grid.Column="1" Margin="8,0,0,0" Padding="12,0" Height="48"
                                Command="{Binding CopyDeviceIdCommand}"
                                ToolTip="Copy Device ID"
                                Style="{StaticResource MaterialDesignOutlinedButton}">
                            <materialDesign:PackIcon Kind="ContentCopy" Width="18" Height="18"/>
                        </Button>
                    </Grid>

                    <!-- Customer Name -->
                    <TextBox materialDesign:HintAssist.Hint="Customer Name"
                             materialDesign:HintAssist.IsFloating="True"
                             Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="14" Margin="0,0,0,16"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                    <!-- Business Name -->
                    <TextBox materialDesign:HintAssist.Hint="Business Name"
                             materialDesign:HintAssist.IsFloating="True"
                             Text="{Binding BusinessName, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="14" Margin="0,0,0,16"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                    <!-- Mobile Number -->
                    <TextBox materialDesign:HintAssist.Hint="Mobile Number"
                             materialDesign:HintAssist.IsFloating="True"
                             Text="{Binding MobileNumber, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="14" Margin="0,0,0,16"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                    <!-- License Key -->
                    <TextBox materialDesign:HintAssist.Hint="License Key"
                             materialDesign:HintAssist.IsFloating="True"
                             Text="{Binding LicenseKey, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="14" Margin="0,0,0,16"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                    <!-- Status/Error message -->
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#D32F2F"
                               FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center"
                               TextAlignment="Center" Margin="0,8,0,16"/>

                    <!-- Action Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="GENERATE REQUEST" Margin="0,0,6,0"
                                Command="{Binding GenerateRequestCommand}" Height="44"
                                Style="{StaticResource MaterialDesignOutlinedButton}"/>
                        <Button Grid.Column="1" Content="ACTIVATE LICENSE" Margin="6,0,0,0"
                                Command="{Binding ActivateCommand}" Height="44"
                                Style="{StaticResource MaterialDesignRaisedButton}"/>
                    </Grid>

                    <!-- Contact Details -->
                    <TextBlock Text="For license keys, contact Rashtra Technologies."
                               FontSize="10" Opacity="0.5" HorizontalAlignment="Center" Margin="0,24,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </materialDesign:Card>
    </Grid>
</Window>
