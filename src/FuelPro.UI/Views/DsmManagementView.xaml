<UserControl x:Class="FuelPro.UI.Views.DsmManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:FuelPro.UI.ViewModels"
             xmlns:converters="clr-namespace:FuelPro.UI.Converters"
             Background="{DynamicResource MaterialDesign.Brush.Background}">

    <UserControl.Resources>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </UserControl.Resources>

    <TabControl materialDesign:ColorZoneAssist.Mode="PrimaryLight" TabStripPlacement="Top" materialDesign:ElevationAssist.Elevation="Dp2" Padding="20">
        <TabControl.Resources>
            <Style TargetType="TabItem" BasedOn="{StaticResource MaterialDesignTabItem}">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Height" Value="40"/>
            </Style>
        </TabControl.Resources>

        <!-- Tab 1: DSM Accounts -->
        <TabItem Header="DSM Accounts">
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Panel: Create Account -->
                <materialDesign:Card Grid.Column="0" Padding="20" UniformCornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp3" VerticalAlignment="Top">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <materialDesign:PackIcon Kind="AccountPlus" Width="24" Height="24" Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                            <TextBlock Text="Provision DSM Account" FontSize="16" FontWeight="Bold" Margin="8,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBox Text="{Binding NewEmployeeCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"
                                 materialDesign:HintAssist.Hint="Employee Code / ID" materialDesign:HintAssist.IsFloating="True"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                        <TextBox Text="{Binding NewFullName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"
                                 materialDesign:HintAssist.Hint="DSM Full Name" materialDesign:HintAssist.IsFloating="True"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                        <TextBox Text="{Binding NewEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"
                                 materialDesign:HintAssist.Hint="Email (Login/PWA)" materialDesign:HintAssist.IsFloating="True"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                        <TextBox Text="{Binding NewMobileNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"
                                 materialDesign:HintAssist.Hint="Mobile Number (Login)" materialDesign:HintAssist.IsFloating="True"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                        <TextBox Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"
                                 materialDesign:HintAssist.Hint="Temporary Password" materialDesign:HintAssist.IsFloating="True"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                        <Button Content="Provision Account" Command="{Binding CreateAccountCommand}" Height="40"
                                IsEnabled="{Binding IsCreatingAccount, Converter={StaticResource InverseBoolConverter}}"
                                Style="{StaticResource MaterialDesignRaisedButton}"/>

                        <TextBlock Text="{Binding AccountStatusMessage}" Margin="0,12,0,0" TextWrapping="Wrap"
                                   FontSize="12" FontWeight="SemiBold" Foreground="#D32F2F" TextAlignment="Center"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Right Panel: Accounts Grid -->
                <materialDesign:Card Grid.Column="2" Padding="20" UniformCornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp3">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" Text="DSM Employee Directory" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
                        
                        <DataGrid Grid.Row="1" ItemsSource="{Binding DsmUsers}" AutoGenerateColumns="False" IsReadOnly="True"
                                  materialDesign:DataGridAssist.CellPadding="12 8" materialDesign:DataGridAssist.ColumnHeaderPadding="12 8"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Employee Code" Binding="{Binding EmployeeCode}" Width="110"/>
                                <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="*"/>
                                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                                <DataGridTextColumn Header="Mobile Number" Binding="{Binding MobileNumber}" Width="130"/>
                                <DataGridTextColumn Header="Created Date" Binding="{Binding CreatedAt, StringFormat='dd MMM yyyy'}" Width="120"/>
                                
                                <DataGridTemplateColumn Header="Status" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <ToggleButton IsChecked="{Binding IsActive, Mode=OneWay}"
                                                              Command="{Binding DataContext.ToggleUserActiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding}"
                                                              Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                                                <TextBlock Text="Active" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center" Opacity="0.7"
                                                           Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Action" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Delete" Style="{StaticResource MaterialDesignOutlinedButton}" Height="28" Padding="12,0" FontSize="11"
                                                    Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </materialDesign:Card>
            </Grid>
        </TabItem>

        <!-- Tab 2: Shift Assignments -->
        <TabItem Header="Pump &amp; Shift Assignments">
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Panel: Create Assignment -->
                <materialDesign:Card Grid.Column="0" Padding="20" UniformCornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp3" VerticalAlignment="Top">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <materialDesign:PackIcon Kind="KeyLink" Width="24" Height="24" Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                            <TextBlock Text="Assign Pump &amp; Shift" FontSize="16" FontWeight="Bold" Margin="8,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <ComboBox ItemsSource="{Binding ActiveDsmOptions}" SelectedItem="{Binding SelectedDsmUser}" DisplayMemberPath="FullName" Margin="0,0,0,12"
                                  materialDesign:HintAssist.Hint="Select DSM" materialDesign:HintAssist.IsFloating="True"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"/>

                        <ComboBox ItemsSource="{Binding PumpOptions}" SelectedItem="{Binding SelectedPumpId}" Margin="0,0,0,12"
                                  materialDesign:HintAssist.Hint="Select Pump" materialDesign:HintAssist.IsFloating="True"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"/>

                        <ComboBox ItemsSource="{Binding PumpOptions}" SelectedItem="{Binding SelectedConnectedPumpId}" Margin="0,0,0,12"
                                  materialDesign:HintAssist.Hint="Connected Pump (Optional)" materialDesign:HintAssist.IsFloating="True"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"/>

                        <ComboBox ItemsSource="{Binding ShiftOptions}" SelectedItem="{Binding SelectedShift}" Margin="0,0,0,16"
                                  materialDesign:HintAssist.Hint="Select Shift" materialDesign:HintAssist.IsFloating="True"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"/>

                        <Button Content="Assign Pump" Command="{Binding CreateAssignmentCommand}" Height="40"
                                Style="{StaticResource MaterialDesignRaisedButton}"/>

                        <TextBlock Text="{Binding AssignmentStatusMessage}" Margin="0,12,0,0" TextWrapping="Wrap"
                                   FontSize="12" FontWeight="SemiBold" Foreground="#D32F2F" TextAlignment="Center"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Right Panel: Assignments Grid -->
                <materialDesign:Card Grid.Column="2" Padding="20" UniformCornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp3">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="Active Pump &amp; Shift Configurations" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                            <CheckBox Content="Show Completed Assignments" IsChecked="{Binding ShowCompletedAssignments}" 
                                      HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding PumpAssignments}" AutoGenerateColumns="False" IsReadOnly="True"
                                  materialDesign:DataGridAssist.CellPadding="12 8" materialDesign:DataGridAssist.ColumnHeaderPadding="12 8"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="DSM Name" Binding="{Binding DsmUser.FullName}" Width="*"/>
                                <DataGridTemplateColumn Header="Pumps Assigned" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding PumpId, StringFormat='Pump {0}'}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding ConnectedPumpId, StringFormat=' + Pump {0}'}" 
                                                           FontWeight="SemiBold"
                                                           Visibility="{Binding ConnectedPumpId, Converter={StaticResource NullToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Shift Type" Binding="{Binding ShiftType}" Width="100"/>
                                <DataGridTextColumn Header="Assigned Date" Binding="{Binding AssignedDate, StringFormat='dd MMM yyyy'}" Width="130"/>
                                
                                <DataGridTemplateColumn Header="Status" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#E0E0E0"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Background" Value="#C8E6C9"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="11" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Completed"/>
                                                            <Setter Property="Foreground" Value="#757575"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Text" Value="Active"/>
                                                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Action" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Deactivate" Style="{StaticResource MaterialDesignOutlinedButton}" Height="28" Padding="12,0" FontSize="11"
                                                    Command="{Binding DataContext.DeactivateAssignmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </materialDesign:Card>
            </Grid>
        </TabItem>

        <!-- Tab 3: Device Registration -->
        <TabItem Header="Registered Devices">
            <materialDesign:Card Padding="20" UniformCornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp3" Margin="0,12,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <TextBlock Grid.Row="0" Text="DSM Mobile Device Registry" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding DsmDevices}" AutoGenerateColumns="False" IsReadOnly="True"
                              materialDesign:DataGridAssist.CellPadding="12 8" materialDesign:DataGridAssist.ColumnHeaderPadding="12 8"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DSM Name" Binding="{Binding DsmUser.FullName}" Width="150"/>
                            <DataGridTextColumn Header="Device Name" Binding="{Binding DeviceName}" Width="180"/>
                            <DataGridTextColumn Header="Device ID" Binding="{Binding DeviceId}" Width="*"/>
                            <DataGridTextColumn Header="Last Login" Binding="{Binding LastLogin, StringFormat='dd MMM yyyy hh:mm tt'}" Width="160"/>
                            <DataGridTextColumn Header="Last Seen" Binding="{Binding LastSeen, StringFormat='dd MMM yyyy hh:mm tt'}" Width="160"/>
                            
                            <DataGridTemplateColumn Header="Status" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FFCDD2"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Background" Value="#C8E6C9"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="11" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Revoked"/>
                                                        <Setter Property="Foreground" Value="#C62828"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Text" Value="Allowed"/>
                                                                <Setter Property="Foreground" Value="#2E7D32"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Action" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Revoke" Style="{StaticResource MaterialDesignOutlinedButton}" Height="28" Padding="12,0" FontSize="11"
                                                Command="{Binding DataContext.DeactivateDeviceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2" Text="{Binding DeviceStatusMessage}" Margin="0,12,0,0" FontSize="13" FontWeight="SemiBold" Foreground="#388E3C"/>
                </Grid>
            </materialDesign:Card>
        </TabItem>

        <!-- Tab 4: Nozzle Configuration (DSM PWA) — hidden until needed -->
        <TabItem Header="Nozzle Config (PWA)" Visibility="Collapsed">
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Configure nozzles for a pump -->
                <materialDesign:Card Grid.Column="0" Padding="20" UniformCornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp3" VerticalAlignment="Top">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <materialDesign:PackIcon Kind="GasStation" Width="24" Height="24" Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                            <TextBlock Text="Configure Pump Nozzles" FontSize="16" FontWeight="Bold" Margin="8,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="Select a pump, define nozzles and fuel types, then save to Supabase. The DSM app loads this automatically." 
                                   FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <ComboBox ItemsSource="{Binding PumpOptions}" SelectedItem="{Binding NozzleConfigPumpId}" Margin="0,0,0,12"
                                  materialDesign:HintAssist.Hint="Select Pump" materialDesign:HintAssist.IsFloating="True"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"/>

                        <Button Content="Load Current Config" Command="{Binding LoadNozzleConfigCommand}" Height="36"
                                Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,0,16"/>

                        <ItemsControl ItemsSource="{Binding EditableNozzles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6" Padding="10,8" CornerRadius="6" BorderThickness="1"
                                            BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}"
                                            Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="30"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding NozzleId, UpdateSourceTrigger=PropertyChanged}"
                                                     materialDesign:HintAssist.Hint="Nozzle#"
                                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="12"/>
                                            <ComboBox Grid.Column="1" SelectedItem="{Binding FuelType}" Margin="8,0"
                                                      ItemsSource="{Binding DataContext.FuelTypeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      Style="{StaticResource MaterialDesignOutlinedComboBox}" FontSize="12"/>
                                            <Button Grid.Column="2" Width="26" Height="26" Padding="0"
                                                    Style="{StaticResource MaterialDesignIconButton}"
                                                    Command="{Binding DataContext.RemoveNozzleRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="Close" Width="14" Height="14"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="+ Add Nozzle Row" Command="{Binding AddNozzleRowCommand}" Height="34"
                                Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,6,0,12"/>

                        <Button Content="Save to Supabase" Command="{Binding SaveNozzleConfigCommand}" Height="40"
                                Style="{StaticResource MaterialDesignRaisedButton}"/>

                        <TextBlock Text="{Binding NozzleConfigStatusMessage}" Margin="0,12,0,0" TextWrapping="Wrap"
                                   FontSize="12" FontWeight="SemiBold" TextAlignment="Center"
                                   Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Right: All configs from Supabase -->
                <materialDesign:Card Grid.Column="2" Padding="20" UniformCornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp3">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="All Pump Nozzle Configs (from Supabase)" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock Grid.Row="1" Text="DSM mobile app reads this when submitting a shift entry." FontSize="12" Opacity="0.6" Margin="0,0,0,12"/>
                        <DataGrid Grid.Row="2" ItemsSource="{Binding PumpNozzleConfigs}" AutoGenerateColumns="False" IsReadOnly="True"
                                  materialDesign:DataGridAssist.CellPadding="12 8" materialDesign:DataGridAssist.ColumnHeaderPadding="12 8"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Pump" Binding="{Binding PumpId, StringFormat='Pump {0}'}" Width="80"/>
                                <DataGridTextColumn Header="Nozzle ID" Binding="{Binding NozzleId}" Width="80"/>
                                <DataGridTextColumn Header="Fuel Type" Binding="{Binding FuelType}" Width="100"/>
                                <DataGridTextColumn Header="Sort Order" Binding="{Binding SortOrder}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </materialDesign:Card>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
