<UserControl x:Class="FuelPro.UI.Views.ProfitLossView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:FuelPro.UI.Converters">
    <UserControl.Resources>
        <converters:IndianCurrencyConverter x:Key="CurrencyConverter"/>
        <converters:EqualToBoolConverter x:Key="EqualToBoolConverter"/>
        
        <Style TargetType="DatePicker" BasedOn="{StaticResource MaterialDesignOutlinedDatePicker}">
            <Setter Property="Foreground" Value="#212121"/>
        </Style>

        <Style x:Key="KpiCardStyle" TargetType="materialDesign:Card">
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="UniformCornerRadius" Value="12"/>
            <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp2"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16">
            <!-- Header with date range pickers and presets -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ChartBox" Width="28" Height="28" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Profit &amp; Loss Statement" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Date Range Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Preset Selector -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <Button Content="Daily" Command="{Binding SetPresetCommand}" CommandParameter="Daily" Margin="0,0,4,0" Height="48" Padding="8,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPreset, Converter={StaticResource EqualToBoolConverter}, ConverterParameter=Daily}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Weekly" Command="{Binding SetPresetCommand}" CommandParameter="Weekly" Margin="0,0,4,0" Height="48" Padding="8,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPreset, Converter={StaticResource EqualToBoolConverter}, ConverterParameter=Weekly}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Monthly" Command="{Binding SetPresetCommand}" CommandParameter="Monthly" Margin="0,0,4,0" Height="48" Padding="8,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPreset, Converter={StaticResource EqualToBoolConverter}, ConverterParameter=Monthly}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Custom" Command="{Binding SetPresetCommand}" CommandParameter="Custom" Height="48" Padding="8,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPreset, Converter={StaticResource EqualToBoolConverter}, ConverterParameter=Custom}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    
                    <DatePicker SelectedDate="{Binding StartDate}" IsEnabled="{Binding IsCustomRange}" materialDesign:HintAssist.Hint="From" Style="{StaticResource MaterialDesignOutlinedDatePicker}" Width="130" Margin="0,0,8,0" Height="48"/>
                    <DatePicker SelectedDate="{Binding EndDate}" IsEnabled="{Binding IsCustomRange}" materialDesign:HintAssist.Hint="To" Style="{StaticResource MaterialDesignOutlinedDatePicker}" Width="130" Margin="0,0,8,0" Height="48"/>
                    <Button Command="{Binding PrintCommand}" Style="{StaticResource MaterialDesignFlatMidBgButton}" Height="48" Padding="12,0" Margin="0,0,8,0" ToolTip="Print P&amp;L Statement">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Printer" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Print" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ExportExcelCommand}" Style="{StaticResource MaterialDesignFlatMidBgButton}" Height="48" Padding="12,0" Background="#1B5E20" BorderBrush="#1B5E20" ToolTip="Export to Excel">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileExcel" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Export" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
            
            <ProgressBar IsIndeterminate="{Binding IsLoading}" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource MaterialDesignLinearProgressBar}" Margin="0,0,0,12"/>
            
            <!-- Summary KPI Grid (4 columns) -->
            <UniformGrid Columns="4" Margin="0,0,0,16">
                <!-- Gross Business Profit Card -->
                <materialDesign:Card Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Gross Business Profit" FontSize="11" Opacity="0.7" Margin="0,0,0,4" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding GrossProfit, Converter={StaticResource CurrencyConverter}}" FontSize="20" FontWeight="Bold" Foreground="#1565C0"/>
                        <TextBlock Text="Fuel + Oil + DEF Profit" FontSize="10" Opacity="0.5" Margin="0,4,0,0"/>
                    </StackPanel>
                </materialDesign:Card>
                
                <!-- Operational Expenses Card -->
                <materialDesign:Card Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Pump Expenses" FontSize="11" Opacity="0.7" Margin="0,0,0,4" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalExpenses, Converter={StaticResource CurrencyConverter}}" FontSize="20" FontWeight="Bold" Foreground="#EF6C00"/>
                        <TextBlock Text="Operational Expenses" FontSize="10" Opacity="0.5" Margin="0,4,0,0"/>
                    </StackPanel>
                </materialDesign:Card>
                
                <!-- DSM Salaries Cost Card -->
                <materialDesign:Card Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <TextBlock Text="DSM Salaries (Base)" FontSize="11" Opacity="0.7" Margin="0,0,0,4" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding DsmBaseSalaries, Converter={StaticResource CurrencyConverter}}" FontSize="20" FontWeight="Bold" Foreground="#6A1B9A"/>
                        <TextBlock Text="Earned Base Salaries" FontSize="10" Opacity="0.5" Margin="0,4,0,0"/>
                    </StackPanel>
                </materialDesign:Card>
                
                <!-- Net Profit Card -->
                <materialDesign:Card Style="{StaticResource KpiCardStyle}" Background="#E8F5E9">
                    <StackPanel>
                        <TextBlock Text="Net Profit" FontSize="11" Foreground="#1B5E20" Margin="0,0,0,4" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding NetProfit, Converter={StaticResource CurrencyConverter}}" FontSize="22" FontWeight="Bold" Foreground="#2E7D32"/>
                        <TextBlock Text="Gross - Deductions + Rec" FontSize="10" Foreground="#1B5E20" Opacity="0.7" Margin="0,4,0,0"/>
                    </StackPanel>
                </materialDesign:Card>
            </UniformGrid>

            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Detailed Profit Breakdowns -->
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <!-- Fuel Sales & Profit Details -->
                    <materialDesign:Card Padding="16" UniformCornerRadius="8" Margin="0,0,0,16" materialDesign:ElevationAssist.Elevation="Dp1">
                        <StackPanel>
                            <TextBlock Text="Fuel Sales Profit Breakdown" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                            
                            <TabControl SelectedIndex="{Binding SelectedProfitTabIndex}" materialDesign:ColorZoneAssist.Mode="Standard" BorderThickness="0">
                                <!-- Tab 1: Margin-Based -->
                                <TabItem Header="Margin-Based Profit">
                                    <StackPanel Margin="0,12,0,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Table Header -->
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Fuel Type" FontWeight="SemiBold" FontSize="12" Opacity="0.7"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Qty Sold" FontWeight="SemiBold" FontSize="12" Opacity="0.7" TextAlignment="Right"/>
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Avg Margin" FontWeight="SemiBold" FontSize="12" Opacity="0.7" TextAlignment="Right"/>
                                            <TextBlock Grid.Row="0" Grid.Column="3" Text="Total Profit" FontWeight="SemiBold" FontSize="12" Opacity="0.7" TextAlignment="Right"/>
                                            <Separator Grid.Row="0" Grid.ColumnSpan="4" Margin="0,4,0,4" VerticalAlignment="Bottom"/>

                                            <!-- HSD Row -->
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="HSD - 20KL (Diesel)" Margin="0,8"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding HsdLitres, StringFormat='{}{0:N2} L'}" Margin="0,8" TextAlignment="Right"/>
                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding HsdMargin, StringFormat='{}₹{0:N2}'}" Margin="0,8" TextAlignment="Right"/>
                                            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding HsdProfit, Converter={StaticResource CurrencyConverter}}" Margin="0,8" TextAlignment="Right" FontWeight="SemiBold"/>

                                            <!-- MS-I Row -->
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="MS - 20KL (Petrol)" Margin="0,8"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MsILitres, StringFormat='{}{0:N2} L'}" Margin="0,8" TextAlignment="Right"/>
                                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding MsIMargin, StringFormat='{}₹{0:N2}'}" Margin="0,8" TextAlignment="Right"/>
                                            <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding MsIProfit, Converter={StaticResource CurrencyConverter}}" Margin="0,8" TextAlignment="Right" FontWeight="SemiBold"/>

                                            <!-- MS-II Row -->
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="HSD - 20KL II (Diesel)" Margin="0,8"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding MsIILitres, StringFormat='{}{0:N2} L'}" Margin="0,8" TextAlignment="Right"/>
                                            <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding MsIIMargin, StringFormat='{}₹{0:N2}'}" Margin="0,8" TextAlignment="Right"/>
                                            <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding MsIIProfit, Converter={StaticResource CurrencyConverter}}" Margin="0,8" TextAlignment="Right" FontWeight="SemiBold"/>

                                            <!-- CNG Row -->
                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="CNG" Margin="0,8"/>
                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CngLitres, StringFormat='{}{0:N2} Kg'}" Margin="0,8" TextAlignment="Right"/>
                                            <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding CngMargin, StringFormat='{}₹{0:N2}'}" Margin="0,8" TextAlignment="Right"/>
                                            <TextBlock Grid.Row="4" Grid.Column="3" Text="{Binding CngProfit, Converter={StaticResource CurrencyConverter}}" Margin="0,8" TextAlignment="Right" FontWeight="SemiBold"/>
                                        </Grid>
                                        <Separator Margin="0,8" Background="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Total Fuel" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding TotalFuelLitres, StringFormat='{}{0:N2} L'}" FontWeight="Bold" TextAlignment="Right"/>
                                            <TextBlock Grid.Column="3" Text="{Binding TotalFuelProfit, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" TextAlignment="Right" Foreground="#1565C0"/>
                                        </Grid>
                                    </StackPanel>
                                </TabItem>
                                
                                <!-- Tab 2: Purchase-Based -->
                                <TabItem Header="Purchase-Based Profit">
                                    <StackPanel Margin="0,12,0,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Table Header -->
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Fuel Type" FontWeight="SemiBold" FontSize="12" Opacity="0.7"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Qty Sold" FontWeight="SemiBold" FontSize="12" Opacity="0.7" TextAlignment="Right"/>
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Avg Sale Rate" FontWeight="SemiBold" FontSize="12" Opacity="0.7" TextAlignment="Right"/>
                                            <TextBlock Grid.Row="0" Grid.Column="3" Text="Avg Purchase" FontWeight="SemiBold" FontSize="12" Opacity="0.7" TextAlignment="Right"/>
                                            <TextBlock Grid.Row="0" Grid.Column="4" Text="Total Profit" FontWeight="SemiBold" FontSize="12" Opacity="0.7" TextAlignment="Right"/>
                                            <Separator Grid.Row="0" Grid.ColumnSpan="5" Margin="0,4,0,4" VerticalAlignment="Bottom"/>

                                            <!-- HSD Row -->
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="HSD - 20KL (Diesel)" Margin="0,8"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding HsdLitres, StringFormat='{}{0:N2} L'}" Margin="0,8" TextAlignment="Right"/>
                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding HsdAvgSaleRate, StringFormat='{}₹{0:N2}'}" Margin="0,8" TextAlignment="Right"/>
                                            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding HsdAvgPurchaseRate, StringFormat='{}₹{0:N2}'}" Margin="0,8" TextAlignment="Right"/>
                                            <TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding HsdPurchaseProfit, Converter={StaticResource CurrencyConverter}}" Margin="0,8" TextAlignment="Right" FontWeight="SemiBold"/>

                                            <!-- Petrol Row -->
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="MS - 20KL (Petrol)" Margin="0,8"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MsILitres, StringFormat='{}{0:N2} L'}" Margin="0,8" TextAlignment="Right"/>
                                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding MsIAvgSaleRate, StringFormat='{}₹{0:N2}'}" Margin="0,8" TextAlignment="Right"/>
                                            <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding MsIAvgPurchaseRate, StringFormat='{}₹{0:N2}'}" Margin="0,8" TextAlignment="Right"/>
                                            <TextBlock Grid.Row="2" Grid.Column="4" Text="{Binding MsIPurchaseProfit, Converter={StaticResource CurrencyConverter}}" Margin="0,8" TextAlignment="Right" FontWeight="SemiBold"/>

                                            <!-- Speed Row -->
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="HSD - 20KL II (Diesel)" Margin="0,8"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding MsIILitres, StringFormat='{}{0:N2} L'}" Margin="0,8" TextAlignment="Right"/>
                                            <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding MsIIAvgSaleRate, StringFormat='{}₹{0:N2}'}" Margin="0,8" TextAlignment="Right"/>
                                            <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding MsIIAvgPurchaseRate, StringFormat='{}₹{0:N2}'}" Margin="0,8" TextAlignment="Right"/>
                                            <TextBlock Grid.Row="3" Grid.Column="4" Text="{Binding MsIIPurchaseProfit, Converter={StaticResource CurrencyConverter}}" Margin="0,8" TextAlignment="Right" FontWeight="SemiBold"/>

                                            <!-- CNG Row -->
                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="CNG" Margin="0,8"/>
                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CngLitres, StringFormat='{}{0:N2} Kg'}" Margin="0,8" TextAlignment="Right"/>
                                            <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding CngAvgSaleRate, StringFormat='{}₹{0:N2}'}" Margin="0,8" TextAlignment="Right"/>
                                            <TextBlock Grid.Row="4" Grid.Column="3" Text="{Binding CngAvgPurchaseRate, StringFormat='{}₹{0:N2}'}" Margin="0,8" TextAlignment="Right"/>
                                            <TextBlock Grid.Row="4" Grid.Column="4" Text="{Binding CngPurchaseProfit, Converter={StaticResource CurrencyConverter}}" Margin="0,8" TextAlignment="Right" FontWeight="SemiBold"/>
                                        </Grid>
                                        <Separator Margin="0,8" Background="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Total Fuel" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding TotalFuelLitres, StringFormat='{}{0:N2} L'}" FontWeight="Bold" TextAlignment="Right"/>
                                            <TextBlock Grid.Column="4" Text="{Binding TotalFuelProfit, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" TextAlignment="Right" Foreground="#1565C0"/>
                                        </Grid>
                                    </StackPanel>
                                </TabItem>
                            </TabControl>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Oil & DEF Profit Details -->
                    <materialDesign:Card Padding="16" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp1">
                        <StackPanel>
                            <TextBlock Text="Oil &amp; DEF Inventory Profit" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Table Header -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Product" FontWeight="SemiBold" FontSize="12" Opacity="0.7"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Qty Sold" FontWeight="SemiBold" FontSize="12" Opacity="0.7" TextAlignment="Right"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Revenue" FontWeight="SemiBold" FontSize="12" Opacity="0.7" TextAlignment="Right"/>
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="Cost (COGS)" FontWeight="SemiBold" FontSize="12" Opacity="0.7" TextAlignment="Right"/>
                                <TextBlock Grid.Row="0" Grid.Column="4" Text="Profit" FontWeight="SemiBold" FontSize="12" Opacity="0.7" TextAlignment="Right"/>
                                <Separator Grid.Row="0" Grid.ColumnSpan="5" Margin="0,4,0,4" VerticalAlignment="Bottom"/>

                                <!-- Oil Row -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Lube Oil" Margin="0,8"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OilSalesQty, StringFormat='{}{0:N2} Units'}" Margin="0,8" TextAlignment="Right"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding OilRevenue, Converter={StaticResource CurrencyConverter}}" Margin="0,8" TextAlignment="Right"/>
                                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding OilCost, Converter={StaticResource CurrencyConverter}}" Margin="0,8" TextAlignment="Right"/>
                                <TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding OilProfit, Converter={StaticResource CurrencyConverter}}" Margin="0,8" TextAlignment="Right" FontWeight="SemiBold" Foreground="#2E7D32"/>

                                <!-- DEF Row -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="DEF (AdBlue)" Margin="0,8"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DefSalesQty, StringFormat='{}{0:N2} Litres'}" Margin="0,8" TextAlignment="Right"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding DefRevenue, Converter={StaticResource CurrencyConverter}}" Margin="0,8" TextAlignment="Right"/>
                                <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding DefCost, Converter={StaticResource CurrencyConverter}}" Margin="0,8" TextAlignment="Right"/>
                                <TextBlock Grid.Row="2" Grid.Column="4" Text="{Binding DefProfit, Converter={StaticResource CurrencyConverter}}" Margin="0,8" TextAlignment="Right" FontWeight="SemiBold" Foreground="#2E7D32"/>
                            </Grid>
                        </StackPanel>
                    </materialDesign:Card>
                </StackPanel>

                <!-- Sidebar Context & Secondary Info -->
                <StackPanel Grid.Column="1">
                    <!-- Secondary metrics card -->
                    <!-- Profit & Loss Statement Summary Card -->
                    <materialDesign:Card Padding="16" UniformCornerRadius="8" Margin="0,0,0,16" materialDesign:ElevationAssist.Elevation="Dp1" Background="#F5F5F5">
                        <StackPanel>
                            <TextBlock Text="Profit &amp; Loss Statement" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" Foreground="#00695C"/>
                            
                            <TextBlock Text="REVENUE SOURCES" FontSize="11" FontWeight="Bold" Opacity="0.5" Margin="0,4,0,4"/>
                            <Grid Margin="0,4">
                                <TextBlock Text="Fuel Profit" FontSize="13"/>
                                <TextBlock Text="{Binding TotalFuelProfit, Converter={StaticResource CurrencyConverter}}" FontWeight="Medium" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,4">
                                <TextBlock Text="Oil Profit" FontSize="13"/>
                                <TextBlock Text="{Binding OilProfit, Converter={StaticResource CurrencyConverter}}" FontWeight="Medium" HorizontalAlignment="Right" Foreground="#2E7D32"/>
                            </Grid>
                            <Grid Margin="0,4">
                                <TextBlock Text="DEF Profit" FontSize="13"/>
                                <TextBlock Text="{Binding DefProfit, Converter={StaticResource CurrencyConverter}}" FontWeight="Medium" HorizontalAlignment="Right" Foreground="#2E7D32"/>
                            </Grid>
                            
                            <Separator Margin="0,6"/>
                            <Grid Margin="0,4">
                                <TextBlock Text="Gross Business Profit" FontSize="14" FontWeight="Bold" Foreground="#1565C0"/>
                                <TextBlock Text="{Binding GrossProfit, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Right" Foreground="#1565C0"/>
                            </Grid>
                            
                            <TextBlock Text="DEDUCTIONS" FontSize="11" FontWeight="Bold" Opacity="0.5" Margin="0,12,0,4"/>
                            <Grid Margin="0,4">
                                <TextBlock Text="DSM Salaries (Base)" FontSize="13"/>
                                <TextBlock Text="{Binding DsmBaseSalaries, Converter={StaticResource CurrencyConverter}, StringFormat='-{0}'}" FontWeight="Medium" HorizontalAlignment="Right" Foreground="#C62828"/>
                            </Grid>
                            <Grid Margin="0,4">
                                <TextBlock Text="Pump Expenses" FontSize="13"/>
                                <TextBlock Text="{Binding TotalExpenses, Converter={StaticResource CurrencyConverter}, StringFormat='-{0}'}" FontWeight="Medium" HorizontalAlignment="Right" Foreground="#C62828"/>
                            </Grid>
                            <Grid Margin="0,4">
                                <TextBlock Text="Salary Adjustments" FontSize="13"/>
                                <TextBlock Text="{Binding SalaryAdjustments, Converter={StaticResource CurrencyConverter}, StringFormat='-{0}'}" FontWeight="Medium" HorizontalAlignment="Right" Foreground="#C62828"/>
                            </Grid>
                            <Grid Margin="0,4">
                                <TextBlock Text="Other Recoveries" FontSize="13"/>
                                <TextBlock Text="{Binding ShortRecoveries, Converter={StaticResource CurrencyConverter}, StringFormat='+{0}'}" FontWeight="Medium" HorizontalAlignment="Right" Foreground="#2E7D32"/>
                            </Grid>
                            <Grid Margin="0,4">
                                <TextBlock Text="Owner Outer Expenses" FontSize="13"/>
                                <TextBlock Text="{Binding OwnerOuterExpenses, Converter={StaticResource CurrencyConverter}, StringFormat='-{0}'}" FontWeight="Medium" HorizontalAlignment="Right" Foreground="#C62828"/>
                            </Grid>
                            <Grid Margin="0,4">
                                <TextBlock Text="Net Mismatch (Excess/Shortage)" FontSize="13"/>
                                <TextBlock Text="{Binding TotalMismatch, Converter={StaticResource CurrencyConverter}}" FontWeight="Medium" HorizontalAlignment="Right"/>
                            </Grid>
                            
                            <Separator Margin="0,8" Background="#00695C"/>
                            <Grid Margin="0,4">
                                <TextBlock Text="Final Net Profit" FontSize="16" FontWeight="Bold" Foreground="#1B5E20"/>
                                <TextBlock Text="{Binding NetProfit, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Right" Foreground="#1B5E20"/>
                            </Grid>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Configure Fuel Profit Margins -->
                    <materialDesign:Card Padding="16" UniformCornerRadius="8" Margin="0,0,0,16" materialDesign:ElevationAssist.Elevation="Dp1">
                        <StackPanel>
                            <TextBlock Text="Configure Fuel Margins" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                            
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Diesel (HSD) (₹/L):" VerticalAlignment="Center" FontSize="13"/>
                                <TextBox Grid.Column="1" Text="{Binding EditHsdMargin, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignTextBox}" TextAlignment="Right" FontWeight="SemiBold"/>
                            </Grid>
                            
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Petrol (MS-I) (₹/L):" VerticalAlignment="Center" FontSize="13"/>
                                <TextBox Grid.Column="1" Text="{Binding EditMsIMargin, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignTextBox}" TextAlignment="Right" FontWeight="SemiBold"/>
                            </Grid>

                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Speed (MS-II) (₹/L):" VerticalAlignment="Center" FontSize="13"/>
                                <TextBox Grid.Column="1" Text="{Binding EditMsIIMargin, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignTextBox}" TextAlignment="Right" FontWeight="SemiBold"/>
                            </Grid>

                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="CNG (₹/Kg):" VerticalAlignment="Center" FontSize="13"/>
                                <TextBox Grid.Column="1" Text="{Binding EditCngMargin, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignTextBox}" TextAlignment="Right" FontWeight="SemiBold"/>
                            </Grid>

                            <Button Content="Save Margins" Command="{Binding SaveMarginsCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Height="36" Margin="0,12,0,0" Background="#1565C0" BorderBrush="#1565C0"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Operating Expense breakdown list -->
                    <materialDesign:Card Padding="16" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp1">
                        <StackPanel>
                            <TextBlock Text="Operating Expense Log" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                            <DataGrid ItemsSource="{Binding ExpenseBreakdown}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="220"
                                      materialDesign:DataGridAssist.CellPadding="4" CanUserSortColumns="True" Background="Transparent" BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Expense Item" Binding="{Binding Category}" Width="*"/>
                                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, Converter={StaticResource CurrencyConverter}}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Owner Pump Expenses Card -->
                    <materialDesign:Card Padding="16" UniformCornerRadius="8" Margin="0,16,0,0" materialDesign:ElevationAssist.Elevation="Dp1">
                        <StackPanel>
                            <TextBlock Text="Owner Pump Expenses" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Rent" Margin="0,4"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PumpRent, Converter={StaticResource CurrencyConverter}}" Margin="0,4"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Salary (Office/Extra)" Margin="0,4"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PumpSalary, Converter={StaticResource CurrencyConverter}}" Margin="0,4"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Trip Sheet Loss" Margin="0,4"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PumpTripSheetLoss, Converter={StaticResource CurrencyConverter}}" Margin="0,4"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="DSM Short" Margin="0,4"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PumpDsmShort, Converter={StaticResource CurrencyConverter}}" Margin="0,4"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Banking Expenses" Margin="0,4"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PumpBankingExpenses, Converter={StaticResource CurrencyConverter}}" Margin="0,4"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="BPCL Portal Expenses" Margin="0,4"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding PumpBpclPortalExpenses, Converter={StaticResource CurrencyConverter}}" Margin="0,4"/>

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Fuel &amp; Travel" Margin="0,4"/>
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding PumpFuelAndTravel, Converter={StaticResource CurrencyConverter}}" Margin="0,4"/>

                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Oil Purchase" Margin="0,4"/>
                                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding PumpOilPurchase, Converter={StaticResource CurrencyConverter}}" Margin="0,4"/>

                                <TextBlock Grid.Row="8" Grid.Column="0" Text="Repairs &amp; Maintenance" Margin="0,4"/>
                                <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding PumpRepairsAndMaintenance, Converter={StaticResource CurrencyConverter}}" Margin="0,4"/>

                                <TextBlock Grid.Row="9" Grid.Column="0" Text="Electricity Expenses" Margin="0,4"/>
                                <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding PumpElectricity, Converter={StaticResource CurrencyConverter}}" Margin="0,4"/>

                                <TextBlock Grid.Row="10" Grid.Column="0" Text="Office Expenses" Margin="0,4"/>
                                <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding PumpOfficeExpenses, Converter={StaticResource CurrencyConverter}}" Margin="0,4"/>

                                <TextBlock Grid.Row="11" Grid.Column="0" Text="Printing Expense" Margin="0,4"/>
                                <TextBlock Grid.Row="11" Grid.Column="1" Text="{Binding PumpPrintingExpense, Converter={StaticResource CurrencyConverter}}" Margin="0,4"/>

                                <TextBlock Grid.Row="12" Grid.Column="0" Text="Other Expense" Margin="0,4"/>
                                <TextBlock Grid.Row="12" Grid.Column="1" Text="{Binding PumpOtherAmount, Converter={StaticResource CurrencyConverter}}" Margin="0,4"/>

                                <Separator Grid.Row="13" Grid.ColumnSpan="2" Margin="0,8,0,4"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Total Owner Expenses" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="{Binding TotalPumpExpenses, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" Foreground="#C62828"/>
                            </Grid>
                        </StackPanel>
                    </materialDesign:Card>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
