<Window x:Class="FuelPro.UI.Printing.PrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Print Preview"
        Width="900" Height="600"
        WindowStyle="None"
        ShowInTaskbar="False"
        Visibility="Hidden"
        AllowsTransparency="False"
        Icon="pack://application:,,,/Resources/fuel-pump-icon.ico">
    <Grid>
        <WebBrowser x:Name="PrintBrowser"
                    LoadCompleted="PrintBrowser_LoadCompleted" />
    </Grid>
</Window>
