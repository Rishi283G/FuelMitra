<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Version>1.3.14</Version>
    <AssemblyVersion>1.3.14.0</AssemblyVersion>
    <FileVersion>1.3.14.0</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\fuel-pump-icon.ico</ApplicationIcon>
    <GenerateMSBuildEditorConfig>false</GenerateMSBuildEditorConfig>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MaterialDesignThemes" Version="5.1.0" />
    <PackageReference Include="MaterialDesignColors" Version="3.1.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FuelPro.Core\FuelPro.Core.csproj" />
    <ProjectReference Include="..\FuelPro.Data\FuelPro.Data.csproj" />
    <ProjectReference Include="..\Rashtra.Licensing\Rashtra.Licensing.csproj" />
    <ProjectReference Include="..\FuelPro.Sync\FuelPro.Sync.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="ags_nozzle_mapping.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Printing\FinalCalculationPrintTemplate.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Printing\DayTotalPrintTemplate.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <EmbeddedResource Include="Printing\FinalCalculationPrintTemplate.html">
      <LogicalName>FuelPro.UI.Printing.FinalCalculationPrintTemplate.html</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Printing\DayTotalPrintTemplate.html">
      <LogicalName>FuelPro.UI.Printing.DayTotalPrintTemplate.html</LogicalName>
    </EmbeddedResource>
    <Content Include="Printing\DsmSheetPrintTemplate.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <EmbeddedResource Include="Printing\DsmSheetPrintTemplate.html">
      <LogicalName>FuelPro.UI.Printing.DsmSheetPrintTemplate.html</LogicalName>
    </EmbeddedResource>
    <Content Include="Printing\ShiftSummaryPrintTemplate.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <EmbeddedResource Include="Printing\ShiftSummaryPrintTemplate.html">
      <LogicalName>FuelPro.UI.Printing.ShiftSummaryPrintTemplate.html</LogicalName>
    </EmbeddedResource>
    <Content Include="Printing\MonthlyPLPrintTemplate.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <EmbeddedResource Include="Printing\MonthlyPLPrintTemplate.html">
      <LogicalName>FuelPro.UI.Printing.MonthlyPLPrintTemplate.html</LogicalName>
    </EmbeddedResource>
    <Content Include="Printing\OilDefSummaryPrintTemplate.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <EmbeddedResource Include="Printing\OilDefSummaryPrintTemplate.html">
      <LogicalName>FuelPro.UI.Printing.OilDefSummaryPrintTemplate.html</LogicalName>
    </EmbeddedResource>
    <Content Include="Printing\CardSettlementPrintTemplate.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <EmbeddedResource Include="Printing\CardSettlementPrintTemplate.html">
      <LogicalName>FuelPro.UI.Printing.CardSettlementPrintTemplate.html</LogicalName>
    </EmbeddedResource>
    <Content Include="Printing\DebtorLedgerPrintTemplate.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <EmbeddedResource Include="Printing\DebtorLedgerPrintTemplate.html">
      <LogicalName>FuelPro.UI.Printing.DebtorLedgerPrintTemplate.html</LogicalName>
    </EmbeddedResource>
    <Content Include="Printing\GenericGridPrintTemplate.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <EmbeddedResource Include="Printing\GenericGridPrintTemplate.html">
      <LogicalName>FuelPro.UI.Printing.GenericGridPrintTemplate.html</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\fuel-pump-icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Update="..\..\Assets\**\*.*">
      <Link>Assets\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
