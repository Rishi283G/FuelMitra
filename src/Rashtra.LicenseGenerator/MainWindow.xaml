<Window x:Class="Rashtra.LicenseGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Rashtra Technologies — Universal License Generator"
        Height="730" Width="820"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{DynamicResource MaterialDesign.Brush.Primary.Light}"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <Grid>
        <materialDesign:Card Margin="20" Padding="20" materialDesign:ElevationAssist.Elevation="Dp8" UniformCornerRadius="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,30">
                    <materialDesign:PackIcon Kind="ShieldKeyOutline" Width="56" Height="56" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Universal License Generator" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="Rashtra Technologies Internal Admin Tool" FontSize="12" Opacity="0.6" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Main Content -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Input Fields -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Client Info &amp; Hardware Details" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesign.Brush.Primary.Light}" Margin="0,0,0,16"/>

                        <!-- Product Selection -->
                        <ComboBox materialDesign:HintAssist.Hint="Select Product"
                                  materialDesign:HintAssist.IsFloating="True"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  FontSize="14" Margin="0,0,0,16"
                                  ItemsSource="{Binding ProductOptions}"
                                  SelectedValuePath="Key"
                                  DisplayMemberPath="Value"
                                  SelectedValue="{Binding SelectedProduct}"/>

                        <!-- License Type -->
                        <ComboBox materialDesign:HintAssist.Hint="License Type"
                                  materialDesign:HintAssist.IsFloating="True"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  FontSize="14" Margin="0,0,0,16"
                                  ItemsSource="{Binding LicenseTypeOptions}"
                                  SelectedValuePath="Key"
                                  DisplayMemberPath="Value"
                                  SelectedValue="{Binding SelectedLicenseType}"/>

                        <!-- Expiry Date -->
                        <DatePicker materialDesign:HintAssist.Hint="Expiry Date"
                                    materialDesign:HintAssist.IsFloating="True"
                                    Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                    FontSize="14" Margin="0,0,0,16"
                                    SelectedDate="{Binding ExpiryDate}"
                                    IsEnabled="{Binding IsExpiryDateEnabled}"/>

                        <!-- Customer Name -->
                        <TextBox materialDesign:HintAssist.Hint="Customer Name"
                                 materialDesign:HintAssist.IsFloating="True"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 FontSize="14" Margin="0,0,0,16"
                                 Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}"/>

                        <!-- Business Name -->
                        <TextBox materialDesign:HintAssist.Hint="Business/Pump Name"
                                 materialDesign:HintAssist.IsFloating="True"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 FontSize="14" Margin="0,0,0,16"
                                 Text="{Binding BusinessName, UpdateSourceTrigger=PropertyChanged}"/>

                        <!-- Mobile Number -->
                        <TextBox materialDesign:HintAssist.Hint="Mobile Number"
                                 materialDesign:HintAssist.IsFloating="True"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 FontSize="14" Margin="0,0,0,16"
                                 Text="{Binding MobileNumber, UpdateSourceTrigger=PropertyChanged}"/>

                        <!-- Device ID -->
                        <TextBox materialDesign:HintAssist.Hint="Device ID (RT-XXXX-XXXX-XXXX)"
                                 materialDesign:HintAssist.IsFloating="True"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 FontSize="14" Margin="0,0,0,16"
                                 Text="{Binding DeviceId, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- Right: Output Details -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Generation Actions" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesign.Brush.Primary.Light}" Margin="0,0,0,16"/>

                        <Button Content="GENERATE LICENSE KEY" Height="50" FontSize="15" FontWeight="Bold"
                                Command="{Binding GenerateKeyCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,0,24"/>

                        <TextBlock Text="Generated License Key:" FontSize="13" Opacity="0.7" Margin="0,0,0,4"/>
                        <!-- License Key Display (Read-Only) -->
                        <TextBox FontSize="18" FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                 Text="{Binding GeneratedKey}" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,16"
                                 TextAlignment="Center" Focusable="True"/>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="COPY KEY" Command="{Binding CopyKeyCommand}" Height="40"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
                            <Button Grid.Column="2" Content="COPY DETAILS" Command="{Binding CopyDetailsCommand}" Height="40"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
                        </Grid>

                        <!-- Error or success status message -->
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{Binding StatusColor}"
                                   FontSize="13" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>
        </materialDesign:Card>
    </Grid>
</Window>
