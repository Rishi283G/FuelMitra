## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## See https://learn.microsoft.com/dotnet/core/tools/dotnet-install-script
.vs/
[Bb]in/
[Oo]bj/
*.user
*.userosscache
*.sln.docstates

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Nested folders
**/[Bb]in/
**/[Oo]bj/

# Visual Studio Code
.vscode/

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
build/
publish_output/
publish_output_latest/
build_output/
installer_output/
nuget_packages/
generator_output/

# Project-specific ignores
ags_coord_dump.txt
ags_raw_dump.txt
build_log.txt
pdf_dump.txt
scratch_log.txt
scratch/
scratch_*

# Images and PDFs that might be temporary
*.pdf
*.jpeg
*.png
*.jpg
